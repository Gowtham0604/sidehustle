---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  jsonLd?: string;
  ogImage?: string;
  keywords?: string;
  ogType?: string;
}

const {
  title = `Side Hustle Ideas to Make Extra Money in ${new Date().getFullYear()} | SideHustlesJob`,
  description = "Looking for a side hustle? Discover 150+ side hustle ideas to make extra money from home or anywhere. Find side hustle jobs matched to your skills, schedule, and income goals — free in 90 seconds.",
  canonical,
  jsonLd,
  ogImage = "https://sidehustlesjob.com/og-image.png",
  keywords = "side hustle, what is a side hustle, side hustle jobs, side hustle ideas, side hustle ideas to make extra money, side hustle stack, side hustle from home, side hustle ideas from home",
  ogType = "website",
} = Astro.props;

const siteUrl = "https://sidehustlesjob.com";
const siteName = "SideHustlesJob";
const resolvedCanonical = canonical ?? siteUrl;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#000000" />
    <meta name="author" content={siteName} />

    <!-- Canonical -->
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SideHustlesJob — Discover the best side hustle ideas to make extra money" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sidehustlesjob" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="SideHustlesJob — Discover the best side hustle ideas to make extra money" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SideHustle" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload navbar logo (above-the-fold, LCP-critical) -->
    <link rel="preload" as="image" href="/favicon-96x96.png" fetchpriority="high" />

    <!-- DNS prefetch for deferred 3rd-party scripts -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Fonts: Outfit + JetBrains Mono via Google Fonts — async (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load font CSS asynchronously; swap to stylesheet once loaded -->
    <link
      rel="preload"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=JetBrains+Mono:wght@400&display=swap"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=JetBrains+Mono:wght@400&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <ClientRouter />

    <!-- Hash scroll fix for Astro ClientRouter cross-page anchor navigation -->
    <script is:inline>
      function scrollToHash() {
        const hash = window.location.hash;
        if (hash) {
          // Use a double-rAF to avoid forced reflow during the transition paint
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              var el = document.getElementById(hash.slice(1));
              if (el) {
                var top = el.getBoundingClientRect().top + window.scrollY - 80;
                window.scrollTo({ top: top, behavior: "smooth" });
              }
            });
          });
        }
      }
      document.addEventListener("astro:page-load", scrollToHash);
    </script>

    <!-- Novus instrumentation bridge. If a Novus snippet is installed, events use it; otherwise GA/dev console receive the same event names. -->
    <script is:inline>
      window.shjTrack = function(eventName, payload) {
        var properties = payload || {};
        try {
          if (window.novus && typeof window.novus.track === "function") {
            window.novus.track(eventName, properties);
          }
          if (typeof window.gtag === "function") {
            window.gtag("event", eventName, properties);
          }
          if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
            console.info("[Novus]", eventName, properties);
          }
        } catch (err) {
          console.warn("Analytics event failed", eventName, err);
        }
      };

      window.addEventListener("shj:track", function(event) {
        var detail = event.detail || {};
        window.shjTrack(detail.event, detail.payload || {});
      });

      document.addEventListener("click", function(event) {
        var target = event.target && event.target.closest ? event.target.closest("[data-track]") : null;
        if (target) {
          window.shjTrack(target.getAttribute("data-track"), {
            path: location.pathname,
            href: target.getAttribute("href") || ""
          });
        }
      });

      document.addEventListener("astro:page-load", function() {
        window.shjTrack("page_viewed", { path: location.pathname });
      });
    </script>

    <title>{title}</title>
  </head>
  <body class="bg-[var(--color-canvas)] text-[var(--color-ink)] antialiased min-h-screen flex flex-col">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-ink)] focus:text-[var(--color-canvas)] focus:rounded-[var(--radius-sm)] focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>

    <Nav />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Google Analytics — deferred until after LCP to avoid blocking render -->
    <script is:inline>
      // Load GA after the page is interactive (requestIdleCallback or setTimeout fallback)
      function loadGA() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-EQTXMQ3157';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-EQTXMQ3157');
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGA, { timeout: 4000 });
      } else {
        setTimeout(loadGA, 3000);
      }
    </script>

  </body>
</html>
