---
import Layout from "../layouts/Layout.astro";

const steps = [
  {
    number: "01",
    title: "Answer 7 quick questions",
    description:
      "Tell us where you want to work, how many hours you have, your experience level, startup budget, and income goal. No account needed — it takes about 90 seconds.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>`,
  },
  {
    number: "02",
    title: "We match you to real opportunities",
    description:
      "Our algorithm scores every hustle in our database against your answers — filtering by remote/local preference, beginner-friendliness, startup cost, and realistic income potential.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  },
  {
    number: "03",
    title: "Explore your top picks",
    description:
      "Get a ranked list of side hustles tailored to your situation. Each result shows income range, startup cost, time commitment, and whether it's remote — everything you need to decide fast.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 17h7M17 14v7"/></svg>`,
  },
  {
    number: "04",
    title: "Dive into the details",
    description:
      "Click any hustle to see a full breakdown: how it works, realistic earnings, skills you'll need, how to get started, and who it's best for. No fluff, just signal.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>`,
  },
];

const faqs = [
  {
    q: "Is this free to use?",
    a: "Completely free. No account, no email, no payment — just answers.",
  },
  {
    q: "How accurate are the income estimates?",
    a: "Income ranges are based on real market data and user-reported earnings across freelance platforms, gig marketplaces, and creator economy reports. They represent realistic ranges, not guarantees.",
  },
  {
    q: "How many side hustles are in the database?",
    a: "We currently track 500+ side hustles across categories like freelancing, gig work, content creation, teaching, e-commerce, and more. We add new ones regularly.",
  },
  {
    q: "Can I retake the quiz?",
    a: "Yes, anytime. Hit the Start Over button on the results screen to reset your answers and go again with different preferences.",
  },
  {
    q: "Do you recommend side hustles based on location?",
    a: "Right now we filter by remote vs. local preference. Hyper-local recommendations (by city or country) are on the roadmap.",
  },
  {
    q: "What if none of the results feel right?",
    a: "Use the Browse section to filter by category, or search for a specific skill or hustle type. You can also tweak your quiz answers — sometimes a small change surfaces very different results.",
  },
];
---

<Layout
  title="How It Works — SideHustlesJob"
  description="Learn how SideHustlesJob matches you to the best side hustle opportunities based on your skills, schedule, budget, and income goals."
  canonical="https://sidehustlesjob.com/how-it-works"
>
  <!-- ─── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="min-h-[calc(100svh-56px)] sm:min-h-0 pt-20 sm:pt-28 pb-12 sm:pb-20 flex items-center border-b border-slate-200 bg-white" aria-labelledby="hiw-hero-heading">
    <div class="container-page w-full">
      <div class="max-w-2xl">
        <p class="inline-flex items-center h-7 px-3 rounded-full border border-emerald-200 bg-emerald-50 text-[11px] font-bold text-emerald-700 mb-5 tracking-wide uppercase">
          No account required · 90 seconds
        </p>
        <h1
          id="hiw-hero-heading"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-[-0.02em] text-slate-950 text-balance"
        >
          How it works.
        </h1>
        <p class="mt-5 text-base sm:text-lg leading-7 text-slate-600 max-w-xl">
          Four simple steps from zero to a shortlist of side hustles that actually fit your life.
        </p>
        <div class="mt-8">
          <a
            href="/quiz"
            data-track="hiw_hero_cta"
            class="inline-flex h-12 sm:h-13 items-center justify-center rounded-lg bg-slate-950 px-7 text-sm font-bold text-white hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-slate-950"
          >
            Take the quiz →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Steps ─────────────────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-slate-50 border-b border-slate-200" aria-labelledby="steps-heading">
    <div class="container-page">
      <div class="max-w-xl mb-10">
        <p class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-2">The process</p>
        <h2 id="steps-heading" class="text-2xl sm:text-3xl font-bold text-slate-950">Four steps to your perfect hustle.</h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {steps.map((step) => (
          <article class="rounded-lg border border-slate-200 bg-white p-5 sm:p-6">
            <div class="flex items-start justify-between mb-5">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-950 text-sm font-bold text-white shrink-0">
                {step.number.replace(/^0/, "")}
              </div>
              <span class="text-4xl font-black text-slate-100 leading-none select-none tabular-nums">{step.number}</span>
            </div>
            <div class="text-slate-400 mb-4" aria-hidden="true" set:html={step.icon} />
            <h3 class="text-base font-bold text-slate-950 mb-2">{step.title}</h3>
            <p class="text-sm leading-6 text-slate-600">{step.description}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/quiz"
          data-track="hiw_steps_cta"
          class="inline-flex h-11 items-center justify-center rounded-lg bg-slate-950 px-6 text-sm font-bold text-white hover:bg-slate-800 transition-colors"
        >
          Find my side hustle →
        </a>
        <a
          href="/browse"
          data-track="hiw_browse_cta"
          class="inline-flex h-11 items-center justify-center rounded-lg border border-slate-300 bg-white px-5 text-sm font-bold text-slate-950 hover:bg-slate-50 transition-colors"
        >
          Browse all hustles
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Data / Trust bar ──────────────────────────────────────────────────── -->
  <section class="border-b border-slate-200 bg-white" aria-label="Trust statistics">
    <div class="container-page">
      <dl class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-slate-200">
        {[
          { value: "500+", label: "Side hustles tracked" },
          { value: "7", label: "Quiz questions" },
          { value: "90s", label: "Average time to results" },
          { value: "$0", label: "Cost to use" },
        ].map(({ value, label }) => (
          <div class="flex flex-col items-center py-10 px-4 text-center">
            <dd class="text-3xl sm:text-4xl font-bold text-slate-950 tracking-tight tabular-nums mb-2">{value}</dd>
            <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── What we match on ──────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-slate-50 border-b border-slate-200" aria-labelledby="matching-heading">
    <div class="container-page">
      <div class="max-w-xl mb-10">
        <p class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-2">The matching engine</p>
        <h2 id="matching-heading" class="text-2xl sm:text-3xl font-bold text-slate-950">What we factor into your matches.</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            label: "Remote vs. local",
            desc: "We only show hustles that match where you want to work — from anywhere or in-person.",
            icon: "🌍",
          },
          {
            label: "Weekly time available",
            desc: "Under 5 hours or 20+? We surface hustles that fit your schedule, not the other way around.",
            icon: "⏱️",
          },
          {
            label: "Experience level",
            desc: "Beginners get beginner-friendly results. Advanced? You'll see higher-ceiling opportunities.",
            icon: "🎓",
          },
          {
            label: "Startup budget",
            desc: "From $0 free options to higher-investment plays — filtered to what you can actually start with.",
            icon: "💰",
          },
          {
            label: "Speed of income",
            desc: "Need cash this month? We surface fast-paying gigs first. Playing the long game? We show scalable options.",
            icon: "⚡",
          },
          {
            label: "Your skills",
            desc: "Writing, coding, design, teaching, video — we match hustles to what you already know how to do.",
            icon: "🛠️",
          },
          {
            label: "Income goal",
            desc: "Extra spending money vs. replacing a full-time income. The bar is set to your target.",
            icon: "📈",
          },
          {
            label: "Real data only",
            desc: "Every hustle has verified income ranges sourced from platforms, surveys, and market research.",
            icon: "✅",
          },
          {
            label: "No spam, no upsell",
            desc: "We don't sell courses or affiliate products. Results are ranked by fit, not commission.",
            icon: "🚫",
          },
        ].map(({ label, desc, icon }) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5">
            <div class="flex items-center gap-2 mb-2.5">
              <span class="text-lg leading-none" aria-hidden="true">{icon}</span>
              <h3 class="text-sm font-bold text-slate-950">{label}</h3>
            </div>
            <p class="text-sm leading-6 text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-white border-b border-slate-200" aria-labelledby="faq-heading">
    <div class="container-page">
      <div class="max-w-xl mb-10">
        <p class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-2">FAQ</p>
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-slate-950">Common questions.</h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {faqs.map(({ q, a }) => (
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-5 sm:p-6">
            <p class="text-sm font-bold text-slate-950 mb-2">{q}</p>
            <p class="text-sm leading-6 text-slate-600">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Final CTA ─────────────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-slate-950" aria-label="Final call to action">
    <div class="container-page text-center">
      <h2 class="text-2xl sm:text-4xl font-bold text-white leading-tight text-balance mb-4">
        Find your side hustle in 90 seconds.
      </h2>
      <p class="text-slate-400 mb-8 max-w-md mx-auto text-sm sm:text-base leading-7">
        No account. No email. Just answers.
      </p>
      <a
        href="/quiz"
        data-track="hiw_footer_cta"
        class="inline-flex h-12 items-center justify-center rounded-lg bg-white px-8 text-sm font-bold text-slate-950 hover:bg-slate-100 transition-colors"
      >
        Take the quiz — it's free →
      </a>
      <p class="mt-4 text-xs text-slate-600">No account required · Free</p>
    </div>
  </section>
</Layout>
