---
import Layout from "../layouts/Layout.astro";

const steps = [
  {
    number: "01",
    title: "Answer 7 quick questions",
    description:
      "Tell us where you want to work, how many hours you have, your experience level, startup budget, and income goal. No account needed — it takes about 90 seconds.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>`,
    color: "from-pink-500 to-fuchsia-600",
    glow: "rgba(217,70,168,0.15)",
  },
  {
    number: "02",
    title: "We match you to real opportunities",
    description:
      "Our algorithm scores every hustle in our database against your answers — filtering by remote/local preference, beginner-friendliness, startup cost, and realistic income potential.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
    color: "from-purple-500 to-purple-700",
    glow: "rgba(147,51,234,0.15)",
  },
  {
    number: "03",
    title: "Explore your top picks",
    description:
      "Get a ranked list of side hustles tailored to your situation. Each result shows income range, startup cost, time commitment, and whether it's remote — everything you need to decide fast.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 17h7M17 14v7"/></svg>`,
    color: "from-fuchsia-500 to-pink-600",
    glow: "rgba(240,0,240,0.12)",
  },
  {
    number: "04",
    title: "Dive into the details",
    description:
      "Click any hustle to see a full breakdown: how it works, realistic earnings, skills you'll need, how to get started, and who it's best for. No fluff, just signal.",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>`,
    color: "from-pink-500 to-purple-600",
    glow: "rgba(217,70,168,0.12)",
  },
];

const faqs = [
  {
    q: "Is this free to use?",
    a: "Completely free. No account, no email, no payment — just answers.",
  },
  {
    q: "How accurate are the income estimates?",
    a: "Income ranges are based on real market data and user-reported earnings across freelance platforms, gig marketplaces, and creator economy reports. They represent realistic ranges, not guarantees.",
  },
  {
    q: "How many side hustles are in the database?",
    a: "We currently track 150+ side hustles across categories like freelancing, gig work, content creation, teaching, e-commerce, and more. We add new ones regularly.",
  },
  {
    q: "Can I retake the quiz?",
    a: "Yes, anytime. Hit the Start Over button on the results screen to reset your answers and go again with different preferences.",
  },
  {
    q: "Do you recommend side hustles based on location?",
    a: "Right now we filter by remote vs. local preference. Hyper-local recommendations (by city or country) are on the roadmap.",
  },
  {
    q: "What if none of the results feel right?",
    a: "Use the Browse section to filter by category, or search for a specific skill or hustle type. You can also tweak your quiz answers — sometimes a small change surfaces very different results.",
  },
];
---

<Layout
  title="How It Works — SideHustleFinder"
  description="Learn how SideHustleFinder matches you to the best side hustle opportunities based on your skills, schedule, budget, and income goals."
  canonical="https://sidehustlefinder.com/how-it-works"
>
  <!-- ─── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-36 pb-24 md:pt-48 md:pb-32" aria-labelledby="hiw-hero-heading">
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-slate-50 via-white to-slate-100 opacity-70"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-gradient-to-tr from-pink-100/60 to-purple-100/60 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-page relative z-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-slate-200 bg-white shadow-sm text-xs font-semibold text-slate-600 mb-10">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
        </span>
        No account required · 90 seconds
      </div>
      <h1
        id="hiw-hero-heading"
        class="text-4xl md:text-7xl font-bold text-slate-900 tracking-[-0.04em] leading-[1.1] mb-6 text-balance"
      >
        How it works.
      </h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-medium mb-10 text-balance">
        Four simple steps from zero to a shortlist of side hustles
        that actually fit your life.
      </p>
      <a
        href="/#finder"
        class="inline-flex items-center justify-center h-14 px-10 text-base font-bold text-white bg-slate-900 rounded-full hover:bg-slate-800 transition-all duration-300 shadow-lg shadow-slate-900/10 transform hover:-translate-y-1"
      >
        Take the quiz →
      </a>
    </div>
  </section>

  <!-- ─── Steps ─────────────────────────────────────────────────────────────── -->
  <section class="pb-24 md:pb-32 pt-0 relative" aria-labelledby="steps-heading">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-pink-50/60 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-purple-50/60 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="container-page relative z-10 border-t border-slate-200 pt-24 md:pt-32">
      <div class="max-w-xl mb-16">
        <p class="text-sm font-bold text-pink-600 uppercase tracking-widest mb-3">The process</p>
        <h2
          id="steps-heading"
          class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight text-balance"
        >
          Four steps to your perfect hustle.
        </h2>
      </div>

      <!-- Step cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {steps.map((step) => (
          <div class="group relative bg-white rounded-3xl border border-slate-200 p-8 md:p-10 hover:border-slate-300 hover:shadow-xl transition-all duration-300 overflow-hidden">
            <!-- Background glow on hover -->
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-3xl"
              style={`background: radial-gradient(ellipse 80% 60% at 0% 0%, ${step.glow}, transparent 70%)`}
            ></div>

            <div class="relative z-10">
              <!-- Number + Icon row -->
              <div class="flex items-start justify-between mb-6">
                <span class="text-6xl font-black text-slate-100 leading-none select-none group-hover:text-slate-200 transition-colors duration-300">
                  {step.number}
                </span>
                <div
                  class={`flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br ${step.color} text-white shadow-lg flex-shrink-0`}
                  aria-hidden="true"
                  set:html={step.icon}
                />
              </div>

              <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3 leading-snug">
                {step.title}
              </h3>
              <p class="text-base text-slate-600 leading-relaxed font-medium">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA between steps and FAQ -->
      <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/#finder"
          class="w-full sm:w-auto flex items-center justify-center h-14 px-10 text-base font-bold text-white bg-slate-900 rounded-full hover:bg-slate-800 transition-all duration-300 shadow-lg shadow-slate-900/10 transform hover:-translate-y-1"
        >
          Find my side hustle →
        </a>
        <a
          href="/#browse"
          class="w-full sm:w-auto flex items-center justify-center h-14 px-10 text-base font-bold text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 hover:border-slate-300 transition-all duration-300 transform hover:-translate-y-1 shadow-sm"
        >
          Browse all hustles
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Data / Trust bar ──────────────────────────────────────────────────── -->
  <section class="border-y border-slate-200 bg-slate-50" aria-label="Trust statistics">
    <div class="container-page">
      <dl class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 divide-x-0 md:divide-x divide-slate-200">
        {[
          { value: "150+", label: "Side hustles tracked" },
          { value: "7", label: "Quiz questions" },
          { value: "90s", label: "Average time to results" },
          { value: "$0", label: "Cost to use" },
        ].map(({ value, label }) => (
          <div class="flex flex-col items-center py-10 px-4 text-center group">
            <dd class="text-4xl font-bold text-slate-800 tracking-tight tabular-nums mb-2 group-hover:scale-110 transition-transform duration-300">{value}</dd>
            <dt class="text-xs font-mono text-slate-500 uppercase tracking-wider group-hover:text-slate-900 transition-colors duration-300">{label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── What we match on ──────────────────────────────────────────────────── -->
  <section class="py-24 md:py-32 relative" aria-labelledby="matching-heading">
    <div class="container-page relative z-10">
      <div class="max-w-xl mb-14">
        <p class="text-sm font-bold text-purple-600 uppercase tracking-widest mb-3">The matching engine</p>
        <h2
          id="matching-heading"
          class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight text-balance"
        >
          What we factor into your matches.
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            label: "Remote vs. local",
            desc: "We only show hustles that match where you want to work — from anywhere or in-person.",
            icon: "🌍",
          },
          {
            label: "Weekly time available",
            desc: "Under 5 hours or 20+? We surface hustles that fit your schedule, not the other way around.",
            icon: "⏱️",
          },
          {
            label: "Experience level",
            desc: "Beginners get beginner-friendly results. Advanced? You'll see higher-ceiling opportunities.",
            icon: "🎓",
          },
          {
            label: "Startup budget",
            desc: "From $0 free options to higher-investment plays — filtered to what you can actually start with.",
            icon: "💰",
          },
          {
            label: "Speed of income",
            desc: "Need cash this month? We surface fast-paying gigs first. Playing the long game? We show scalable options.",
            icon: "⚡",
          },
          {
            label: "Your skills",
            desc: "Writing, coding, design, teaching, video — we match hustles to what you already know how to do.",
            icon: "🛠️",
          },
          {
            label: "Income goal",
            desc: "Extra spending money vs. replacing a full-time income. The bar is set to your target.",
            icon: "📈",
          },
          {
            label: "Real data only",
            desc: "Every hustle has verified income ranges sourced from platforms, surveys, and market research.",
            icon: "✅",
          },
          {
            label: "No spam, no upsell",
            desc: "We don't sell courses or affiliate products. Results are ranked by fit, not commission.",
            icon: "🚫",
          },
        ].map(({ label, desc, icon }) => (
          <div class="group flex gap-5 p-6 bg-white rounded-2xl border border-slate-200 hover:border-slate-300 hover:shadow-md transition-all duration-300">
            <span class="text-2xl leading-none mt-0.5 flex-shrink-0" aria-hidden="true">{icon}</span>
            <div>
              <p class="text-sm font-bold text-slate-900 mb-1.5">{label}</p>
              <p class="text-sm text-slate-600 leading-relaxed font-medium">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-24 md:py-32 bg-slate-50 border-t border-slate-200 relative" aria-labelledby="faq-heading">
    <div class="container-page relative z-10">
      <div class="mb-14">
        <p class="text-sm font-bold text-pink-600 uppercase tracking-widest mb-3">FAQ</p>
        <h2
          id="faq-heading"
          class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight text-balance"
        >
          Common questions.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {faqs.map(({ q, a }) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-7 hover:border-slate-300 hover:shadow-sm transition-all duration-300">
            <p class="text-base font-bold text-slate-900 mb-3">{q}</p>
            <p class="text-base text-slate-600 leading-relaxed font-medium">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Final CTA ─────────────────────────────────────────────────────────── -->
  <section class="py-24 md:py-32 relative overflow-hidden border-t border-slate-200" aria-labelledby="hiw-cta-heading">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 to-slate-800"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-pink-600/20 to-purple-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-page relative z-10 text-center max-w-2xl mx-auto">
      <p class="text-sm font-bold text-pink-400 uppercase tracking-widest mb-4">Ready?</p>
      <h2
        id="hiw-cta-heading"
        class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight mb-6 text-balance"
      >
        Find your side hustle in 90 seconds.
      </h2>
      <p class="text-lg text-slate-400 leading-relaxed font-medium mb-10">
        No account. No email. Just answers.
      </p>
      <a
        href="/#finder"
        class="inline-flex items-center justify-center h-14 px-10 text-base font-bold text-slate-900 bg-white rounded-full hover:bg-slate-100 transition-all duration-300 shadow-xl transform hover:-translate-y-1"
      >
        Take the quiz →
      </a>
    </div>
  </section>
</Layout>
