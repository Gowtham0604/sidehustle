---
import Layout from "../layouts/Layout.astro";
import HustleCard from "../components/HustleCard.astro";
import HustleFinder from "../components/HustleFinder.astro";
import FAQ from "../components/FAQ.astro";
import type { SideHustle } from "../types/side-hustle";
import { homeMeta } from "../utils/seo";
import hustleData from "../data/side-hustles.json";

const hustles = hustleData as SideHustle[];
const meta = homeMeta();

// Featured = top 3 by income potential + beginner-friendly mix
const featured = hustles
  .filter((h) => h.beginnerFriendly && h.remote)
  .slice(0, 3);

const stats = [
  { label: "Side hustles", value: `${hustles.length}+` },
  { label: "Remote options", value: `${hustles.filter((h) => h.remote).length}+` },
  { label: "Free to start", value: `${hustles.filter((h) => h.startupCost === "$0").length}+` },
  { label: "Beginner friendly", value: `${hustles.filter((h) => h.beginnerFriendly).length}+` },
];

// Home page JSON-LD: WebSite + WebApplication schema
const homeJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://sidehustlesjob.com/#website",
      "url": "https://sidehustlesjob.com",
      "name": "SideHustlesJob",
      "description": "Discover 150+ side hustle ideas to make extra money from home or anywhere. Find side hustle jobs matched to your skills, schedule, and income goals.",
      "publisher": {
        "@type": "Organization",
        "name": "SideHustlesJob",
        "url": "https://sidehustlesjob.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://sidehustlesjob.com/favicon-96x96.png"
        }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://sidehustlesjob.com/#browse?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://sidehustlesjob.com/#webpage",
      "url": "https://sidehustlesjob.com",
      "name": `Side Hustle Ideas to Make Extra Money in ${new Date().getFullYear()} | SideHustlesJob`,
      "description": "Looking for a side hustle? Discover 150+ side hustle ideas to make extra money from home or anywhere.",
      "isPartOf": { "@id": "https://sidehustlesjob.com/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sidehustlesjob.com"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A side hustle is any income-generating activity you do outside of your primary job or main source of income. It could be a freelance service, gig work, an online business, or a creative project — as long as it pays you. Popular examples include freelance writing, driving for Uber, delivering for DoorDash or Instacart, selling on Etsy, online tutoring, and web development."
          }
        },
        {
          "@type": "Question",
          "name": "How to start a side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starting a side hustle comes down to four steps: (1) Pick a hustle that matches your skills, schedule, and budget. (2) Set up the minimum viable presence — a profile on Upwork, a gig on Fiverr, a DoorDash driver account, or a simple website. (3) Get your first client or first delivery — don't wait until everything is perfect. (4) Reinvest early earnings to grow. Most side hustles can be started in a single weekend."
          }
        },
        {
          "@type": "Question",
          "name": "Is DoorDash a good side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DoorDash is a solid side hustle for people who want flexible, on-demand income with zero experience required. Dashers typically earn $15–$25 per hour including tips, depending on your market and the hours you choose. It's one of the easiest gigs to start — you just need a smartphone, a valid driver's license, insurance, and a background check."
          }
        },
        {
          "@type": "Question",
          "name": "What is a good side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A good side hustle is one that matches your skills, fits your schedule, and meets your income goal. For high earners, freelance web development, copywriting, SEO consulting, or UX design can generate $2,000–$5,000+/month. For beginners, transcription, virtual assistance, or food delivery can get you earning within days."
          }
        },
        {
          "@type": "Question",
          "name": "What's a good side hustle for making extra money fast?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you need money quickly, the fastest side hustles are food delivery (DoorDash, Uber Eats, Instacart), rideshare driving (Uber, Lyft), task-based gigs (TaskRabbit), and freelance services (writing, design, data entry on Upwork or Fiverr). All can generate income within your first week."
          }
        },
        {
          "@type": "Question",
          "name": "Is Uber a good side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uber is a reliable side hustle if you have a qualifying vehicle and want flexible hours. Drivers typically earn $18–$30 per hour before expenses in most US cities, with surge pricing boosting earnings during peak times. However, you bear the cost of gas, maintenance, and depreciation, which can significantly reduce net earnings."
          }
        },
        {
          "@type": "Question",
          "name": "Is Instacart a good side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Instacart is a good side hustle for people who like grocery shopping and want flexible hours. Shoppers earn $10–$20 per hour on average, plus tips, which can meaningfully boost income. Full-service shoppers who both shop and deliver tend to earn more than in-store-only shoppers."
          }
        },
        {
          "@type": "Question",
          "name": "Is Instacart worth it as a side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whether Instacart is worth it depends on your market and goals. In high-demand urban areas, experienced shoppers can earn $20–$30+/hour including tips. In smaller markets or during off-peak hours, earnings can dip to $10–$12/hour. Tips are the biggest variable — good service consistently leads to better tips."
          }
        },
        {
          "@type": "Question",
          "name": "Is Uber Eats a good side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uber Eats is a popular food delivery side hustle with earnings typically between $12–$22 per hour including tips. Like DoorDash, it offers complete schedule flexibility and is easy to start. Uber Eats has the added benefit of being on the same platform as Uber rideshare, so some drivers do both to maximize their active time."
          }
        },
        {
          "@type": "Question",
          "name": "How to start a side hustle with no money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many of the best side hustles cost nothing to start. Freelance writing, copywriting, virtual assistance, social media management, online tutoring, transcription, and data annotation all require only a laptop and internet connection. Create a free profile on Upwork, Fiverr, or LinkedIn and offer a discounted rate for your first 2–3 clients to build reviews."
          }
        },
        {
          "@type": "Question",
          "name": "What are current side hustle statistics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As of 2024–2025, over 44% of full-time employed Americans have a side hustle. The average side hustler earns approximately $810/month in supplemental income. Nearly 28% of Americans say their side hustle income is essential to covering monthly expenses. The gig economy employs over 59 million Americans annually."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There's no single best side hustle — it depends on your skills, time, and income goal. Freelance web development, copywriting, and SEO consulting rank highest for hourly earning potential ($50–$150/hr). For passive income, digital products and affiliate marketing rank highest for scalability. For fastest time-to-income, food delivery and rideshare gigs win."
          }
        },
        {
          "@type": "Question",
          "name": "How to make money with a side hustle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Making money with a side hustle follows a simple pattern: pick a hustle with demand, show up consistently, and improve over time. For service-based hustles, land your first client within 7 days using Upwork, Fiverr, or direct outreach. For gig work, complete your first shift within the week. Track your hours and earnings from day one, then look for ways to increase your rate or add a complementary income stream."
          }
        }
      ]
    }
  ]
});
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={homeJsonLd}
  keywords="side hustle, what is a side hustle, side hustle jobs, side hustle ideas, side hustle ideas to make extra money, side hustle stack, side hustle from home, side hustle ideas from home"
>
  <!-- ─── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-20 pb-8 sm:pt-28 sm:pb-20 md:pt-48 md:pb-40" aria-labelledby="hero-heading">
    <!-- Animated Glowing Background elements -->
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-slate-50 via-white to-slate-100 opacity-60"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[280px] h-[280px] sm:w-[500px] sm:h-[500px] md:w-[800px] md:h-[800px] bg-gradient-to-tr from-pink-100/50 to-purple-100/50 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-page relative z-10">
      <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-slate-200 bg-white shadow-sm text-xs font-semibold text-slate-600 mb-4 sm:mb-10">
          <span class="relative flex h-2 w-2 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
          </span>
          {hustles.length}+ real opportunities, no fluff
        </div>

        <!-- Headline — tighter on mobile -->
        <h1
          id="hero-heading"
          class="text-[2rem] leading-[1.15] sm:text-5xl md:text-7xl font-bold text-slate-900 tracking-[-0.02em] sm:tracking-[-0.04em] sm:leading-[1.1] mb-3 sm:mb-8 text-balance"
        >
          Find the best side hustle for you.
        </h1>

        <!-- Sub — shorter on mobile -->
        <p class="text-sm sm:text-lg md:text-xl text-slate-600 leading-relaxed mb-6 sm:mb-12 max-w-2xl mx-auto text-balance font-medium">
          Answer 7 questions and discover hustles matched to your skills and income goals.
        </p>

        <!-- CTAs — stacked mobile, inline desktop -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-4 w-full sm:w-auto">
          <a
            href="#finder"
            class="w-full sm:w-auto flex items-center justify-center h-12 sm:h-14 px-7 sm:px-8 text-sm sm:text-base font-bold text-white bg-slate-900 rounded-full hover:bg-slate-800 transition-all duration-300 shadow-lg shadow-slate-900/10"
          >
            Find my side hustle →
          </a>
          <a
            href="/browse"
            class="w-full sm:w-auto flex items-center justify-center h-11 sm:h-14 px-7 sm:px-8 text-sm sm:text-base font-semibold text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 hover:border-slate-300 transition-all duration-300 shadow-sm"
          >
            Browse all
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Quick Stats — compact 2x2 on mobile ──────────────────────────────── -->
  <section class="border-y border-slate-200 bg-slate-50 relative z-10" aria-label="Site statistics">
    <div class="container-page">
      <dl class="grid grid-cols-2 md:grid-cols-4 divide-slate-200" style="divide-color: #e2e8f0;">
        {stats.map(({ label, value }, i) => (
          <div class:list={[
            "flex flex-col items-center py-5 sm:py-10 px-3 sm:px-4 text-center group border-slate-200",
            i % 2 !== 0 ? "border-l" : "",
            i >= 2 ? "border-t md:border-t-0" : "",
            i > 0 ? "md:border-l" : "",
          ]}>
            <dd class="text-2xl sm:text-4xl font-bold text-slate-800 tracking-tight tabular-nums mb-0.5 sm:mb-2">{value}</dd>
            <dt class="text-[10px] sm:text-xs font-mono text-slate-500 uppercase tracking-wider">{label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─── Featured hustles — horizontal scroll on mobile ───────────────────── -->
  <section class="py-8 sm:py-16 md:py-32 relative" aria-labelledby="featured-heading">
    <div class="absolute top-1/2 left-0 w-96 h-96 bg-pink-100/50 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="relative z-10">
      <!-- Header — padded normally -->
      <div class="container-page">
        <div class="flex items-center justify-between gap-4 mb-5 sm:mb-16">
          <div>
            <p class="text-[11px] sm:text-sm font-bold text-pink-600 uppercase tracking-widest mb-1 sm:mb-3">Popular picks</p>
            <h2
              id="featured-heading"
              class="text-xl sm:text-3xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight text-balance"
            >
              Top hustles right now.
            </h2>
          </div>
          <a
            href="/browse"
            class="shrink-0 flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-700 hover:text-slate-900 transition-colors px-3 py-1.5 sm:px-4 sm:py-2 rounded-full border border-slate-200 bg-white hover:bg-slate-50 whitespace-nowrap"
          >
            View all
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8h9M9 4.5l3.5 3.5L9 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Mobile: horizontal scroll cards. Desktop: normal grid -->
      <div class="md:container-page">
        <!-- Mobile horizontal scroll -->
        <div class="md:hidden flex gap-3 overflow-x-auto scrollbar-hide pl-4 pr-4 pb-1">
          {featured.map((hustle) => (
            <div class="flex-shrink-0 w-[76vw] max-w-[280px]">
              <HustleCard hustle={hustle} featured />
            </div>
          ))}
          <!-- "See all" card -->
          <div class="flex-shrink-0 w-[76vw] max-w-[280px]">
            <a href="/browse" class="flex flex-col items-center justify-center h-full min-h-[200px] rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 text-slate-600 hover:border-pink-300 hover:bg-pink-50 hover:text-pink-600 transition-all duration-300 gap-2 p-6">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
              <span class="text-sm font-bold text-center">See all {hustles.length}+ hustles</span>
            </a>
          </div>
        </div>
        <!-- Desktop grid -->
        <div class="hidden md:grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {featured.map((hustle) => (
            <HustleCard hustle={hustle} featured />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Finder quiz ──────────────────────────────────────────────────────── -->
  <HustleFinder />

  <!-- ─── Audience & Constraint links — horizontal scroll chips on mobile ──── -->
  <section class="py-8 sm:py-16 md:py-32 relative border-t border-slate-200" aria-labelledby="audience-heading">
    <div class="relative z-10">
      <!-- Audience -->
      <div class="container-page mb-8 sm:mb-14">
        <p class="text-[11px] sm:text-sm font-bold text-slate-500 uppercase tracking-widest mb-1 sm:mb-3">By audience</p>
        <h2
          id="audience-heading"
          class="text-xl sm:text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight text-balance"
        >
          Find hustles for your situation.
        </h2>
      </div>

      <!-- Mobile: horizontal pill chips. Desktop: grid -->
      <div class="md:container-page">
        <div class="md:hidden flex gap-2.5 overflow-x-auto scrollbar-hide px-4 pb-1">
          {[
            { href: "/side-hustles-for-students", label: "🎓 Students" },
            { href: "/side-hustles-for-developers", label: "💻 Developers" },
            { href: "/side-hustles-for-teachers", label: "📚 Teachers" },
            { href: "/side-hustles-for-designers", label: "🎨 Designers" },
            { href: "/side-hustles-for-retirees", label: "🌿 Retirees" },
            { href: "/side-hustles-for-parents", label: "👨‍👩‍👧 Parents" },
            { href: "/side-hustles-for-writers", label: "✍️ Writers" },
            { href: "/side-hustles-for-marketers", label: "📣 Marketers" },
            { href: "/side-hustles-for-nurses", label: "🏥 Nurses" },
            { href: "/side-hustles-for-accountants", label: "📊 Accountants" },
          ].map(({ href, label }) => (
            <a
              href={href}
              class="flex-shrink-0 px-4 py-2.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-700 hover:bg-slate-900 hover:border-slate-900 hover:text-white transition-all duration-200 whitespace-nowrap shadow-sm active:scale-95"
            >
              {label}
            </a>
          ))}
        </div>
        <div class="hidden md:grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
          {[
            { href: "/side-hustles-for-students", label: "Students" },
            { href: "/side-hustles-for-developers", label: "Developers" },
            { href: "/side-hustles-for-teachers", label: "Teachers" },
            { href: "/side-hustles-for-designers", label: "Designers" },
            { href: "/side-hustles-for-retirees", label: "Retirees" },
            { href: "/side-hustles-for-parents", label: "Parents" },
            { href: "/side-hustles-for-writers", label: "Writers" },
            { href: "/side-hustles-for-marketers", label: "Marketers" },
            { href: "/side-hustles-for-nurses", label: "Nurses" },
            { href: "/side-hustles-for-accountants", label: "Accountants" },
          ].map(({ href, label }) => (
            <a
              href={href}
              class="flex items-center justify-between gap-2 p-3 sm:p-5 rounded-[var(--radius-lg)] border border-slate-200 bg-white hover:bg-slate-900 hover:border-slate-900 transition-all duration-300 group shadow-sm hover:shadow-[0_4px_30px_rgba(217,70,168,0.15)] hover:-translate-y-1"
            >
              <span class="text-xs sm:text-sm font-semibold text-slate-700 group-hover:text-white transition-colors">{label}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="shrink-0 text-slate-400 group-hover:text-pink-400 transition-colors" aria-hidden="true">
                <path d="M2.5 6h7M6 2.5l3.5 3.5L6 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Constraint links -->
      <div class="mt-8 sm:mt-20">
        <div class="container-page mb-5 sm:mb-14">
          <p class="text-[11px] sm:text-sm font-bold text-[var(--color-mute)] uppercase tracking-widest mb-1 sm:mb-3">By constraint</p>
          <h2 class="text-xl sm:text-3xl md:text-4xl font-bold text-[var(--color-ink)] tracking-tight leading-tight text-balance">
            Find what fits your limits.
          </h2>
        </div>

        <div class="md:container-page">
          <div class="md:hidden flex gap-2.5 overflow-x-auto scrollbar-hide px-4 pb-1">
            {[
              { href: "/side-hustles-with-no-money", label: "💸 No Money" },
              { href: "/side-hustles-with-no-experience", label: "🌱 No Experience" },
              { href: "/side-hustles-from-home", label: "🏠 From Home" },
              { href: "/side-hustles-that-pay-weekly", label: "📅 Weekly Pay" },
              { href: "/side-hustles-for-beginners", label: "⭐ Beginners" },
              { href: "/high-income-side-hustles", label: "💰 High Income" },
              { href: "/passive-income-side-hustles", label: "🔄 Passive Income" },
              { href: "/side-hustles-under-100", label: "🏷️ Under $100" },
            ].map(({ href, label }) => (
              <a
                href={href}
                class="flex-shrink-0 px-4 py-2.5 rounded-full border border-slate-200 bg-white text-sm font-semibold text-slate-700 hover:bg-slate-900 hover:border-slate-900 hover:text-white transition-all duration-200 whitespace-nowrap shadow-sm active:scale-95"
              >
                {label}
              </a>
            ))}
          </div>
          <div class="hidden md:grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
            {[
              { href: "/side-hustles-with-no-money", label: "No Money" },
              { href: "/side-hustles-with-no-experience", label: "No Experience" },
              { href: "/side-hustles-from-home", label: "From Home" },
              { href: "/side-hustles-that-pay-weekly", label: "Weekly Pay" },
              { href: "/side-hustles-for-beginners", label: "Beginners" },
              { href: "/high-income-side-hustles", label: "High Income" },
              { href: "/passive-income-side-hustles", label: "Passive Income" },
              { href: "/side-hustles-under-100", label: "Under $100" },
            ].map(({ href, label }) => (
              <a
                href={href}
                class="flex items-center justify-between gap-2 p-3 sm:p-5 rounded-[var(--radius-lg)] border border-slate-200 bg-white hover:bg-slate-900 hover:border-slate-900 transition-all duration-300 group shadow-sm hover:shadow-[0_4px_30px_rgba(147,51,234,0.15)] hover:-translate-y-1"
              >
                <span class="text-xs sm:text-sm font-semibold text-slate-700 group-hover:text-white transition-colors">{label}</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="shrink-0 text-slate-400 group-hover:text-purple-400 transition-colors" aria-hidden="true">
                  <path d="M2.5 6h7M6 2.5l3.5 3.5L6 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SEO Content — collapsible on mobile ──────────────────────────────── -->
  <section class="py-8 md:py-24 border-t border-slate-200 bg-white" aria-labelledby="seo-content-heading">
    <div class="container-page">
      <div class="max-w-4xl mx-auto">
        <h2 id="seo-content-heading" class="text-xl sm:text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-6">
          What Is a Side Hustle — And How Do You Find the Right One?
        </h2>

        <!-- Mobile: collapsed by default, "Read more" toggle -->
        <div id="seo-preview" class="md:hidden">
          <p class="text-sm text-slate-600 leading-relaxed mb-3">
            A <strong>side hustle</strong> is any income-generating activity you pursue outside of your primary job. Whether you want an extra $200 a month or you're chasing $5,000 to eventually go full-time, there is a hustle that fits your situation.
          </p>
          <button
            id="seo-expand-btn"
