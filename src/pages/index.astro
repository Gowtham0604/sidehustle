---
import Layout from "../layouts/Layout.astro";
import { jobs } from "../utils/jobs";
const title = "Find Part-time Jobs Near You in Bengaluru | SideHustlesJob";
const description = "Find local part-time, weekend, evening, and flexible jobs hiring near you in Bengaluru.";
---

<Layout title={title} description={description} canonical="https://sidehustlesjob.com/" keywords="part-time jobs Bengaluru, weekend jobs Bengaluru, evening jobs near me">
  <section class="border-b border-slate-200 bg-[#f6f7f3] pt-28 pb-14 sm:pt-36 sm:pb-20">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-emerald-700"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Bengaluru only</p>
        <h1 class="max-w-2xl text-4xl font-bold leading-[1.02] tracking-[-0.04em] text-slate-950 sm:text-6xl">Find part-time jobs near you in Bengaluru.</h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">Nearby part-time, weekend, evening, student-friendly and flexible jobs. Search an area, compare the details, and apply directly.</p>
      </div>
      <form id="home-search" class="mt-8 flex max-w-3xl flex-col gap-3 sm:flex-row" action="/jobs" method="get">
        <label class="sr-only" for="home-query">Search jobs, companies or areas</label>
        <input id="home-query" name="q" class="h-14 min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-4 text-base text-slate-950 shadow-sm placeholder:text-slate-400" placeholder="Search jobs, companies or areas" />
        <button data-track="home_search_submitted" class="h-14 rounded-lg bg-slate-950 px-7 text-sm font-bold text-white transition-colors hover:bg-emerald-700" type="submit">Find jobs</button>
      </form>
      <button id="home-location" data-track="home_use_location" class="mt-3 inline-flex h-10 items-center gap-2 rounded-lg px-1 text-sm font-bold text-slate-700 hover:text-emerald-700" type="button"><span aria-hidden="true">&#128205;</span> Use my location</button>
      <p id="home-location-status" class="mt-1 min-h-5 text-xs text-slate-500" aria-live="polite"></p>
      <div class="mt-8 flex flex-wrap gap-2" aria-label="Popular searches">
        {["Koramangala", "HSR Layout", "Indiranagar", "Whitefield", "Weekend jobs", "Evening jobs"].map((search) => <a href={`/jobs?q=${encodeURIComponent(search)}`} class="rounded-full border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-emerald-500 hover:text-emerald-700">{search}</a>)}
      </div>
    </div>
  </section>
  <section class="border-b border-slate-200 bg-white py-14 sm:py-20" aria-labelledby="latest-heading">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end"><div><p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Curated local listings</p><h2 id="latest-heading" class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Latest part-time jobs in Bengaluru</h2></div><a href="/jobs" data-track="home_view_all_jobs" class="text-sm font-bold text-emerald-700 hover:text-emerald-800">View all jobs <span aria-hidden="true">&#8594;</span></a></div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {jobs.slice(0, 6).map((job) => <article class="rounded-lg border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md"><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">{job.company}</p><h3 class="mt-1 text-base font-bold text-slate-950">{job.title}</h3></div><span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-bold text-emerald-700">{job.hiringStatus}</span></div><p class="mt-4 text-sm text-slate-600">&#128205; {job.area} <span class="px-1 text-slate-300">·</span> {job.salary} {job.salaryPeriod}</p><div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-slate-500"><span>{job.employmentType}</span><span>·</span>{job.schedule.slice(0, 2).map((item) => <span>{item}</span>)}</div><a href={`/jobs/${job.slug}`} class="mt-5 inline-flex text-sm font-bold text-slate-950 hover:text-emerald-700">View job <span class="ml-1" aria-hidden="true">&#8594;</span></a></article>)}
      </div>
    </div>
  </section>
  <section class="border-b border-slate-200 bg-slate-950 py-14 text-white sm:py-20" aria-labelledby="nearby-heading"><div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-300">Built for the commute</p><h2 id="nearby-heading" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Search by neighborhood. Start closer to home.</h2><p class="mt-4 max-w-md text-sm leading-7 text-slate-300">Every approved listing includes an area, application link, schedule, pay information, and a location you can compare.</p><a href="/jobs" class="mt-7 inline-flex h-11 items-center rounded-lg bg-white px-5 text-sm font-bold text-slate-950 hover:bg-emerald-100">Explore the Bengaluru map <span class="ml-2" aria-hidden="true">&#8594;</span></a></div><div class="relative min-h-[290px] overflow-hidden rounded-lg border border-white/10 bg-[#17211d] p-5" aria-label="Bengaluru job map preview"><div class="absolute inset-0 opacity-30" style="background-image: linear-gradient(#8aa99a 1px, transparent 1px), linear-gradient(90deg, #8aa99a 1px, transparent 1px); background-size: 42px 42px;"></div>{jobs.slice(0, 8).map((job, index) => <span class="absolute h-3 w-3 rounded-full border-2 border-white bg-emerald-400 shadow-[0_0_0_5px_rgba(52,211,153,0.16)]" style={`left:${18 + ((index * 17) % 66)}%;top:${22 + ((index * 29) % 56)}%`} title={`${job.title}, ${job.area}`}></span>)}<div class="absolute bottom-5 left-5 rounded-md bg-slate-950/80 px-3 py-2 text-xs font-semibold text-slate-200">{jobs.length} curated job leads across Bengaluru</div></div></div></section>
  <section class="bg-white py-14 sm:py-20"><div class="container-page"><div class="grid gap-4 sm:grid-cols-3"><div><p class="text-2xl font-bold text-slate-950">Bengaluru-first</p><p class="mt-1 text-sm text-slate-600">Neighborhoods people actually commute from.</p></div><div><p class="text-2xl font-bold text-slate-950">Direct applications</p><p class="mt-1 text-sm text-slate-600">Go straight to the company or hiring partner.</p></div><div><p class="text-2xl font-bold text-slate-950">No account needed</p><p class="mt-1 text-sm text-slate-600">Save jobs locally and come back when ready.</p></div></div></div></section>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>("#home-location");
  const status = document.querySelector<HTMLElement>("#home-location-status");
  button?.addEventListener("click", () => {
    if (!navigator.geolocation) { if (status) status.textContent = "Location is not available in this browser."; return; }
    if (status) status.textContent = "Finding jobs near you...";
    navigator.geolocation.getCurrentPosition((position) => { window.location.href = `/jobs?lat=${position.coords.latitude}&lng=${position.coords.longitude}`; }, () => { if (status) status.textContent = "We could not access your location. Search an area instead."; });
  });
</script>
