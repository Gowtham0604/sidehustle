<script>
  function setupFilters() {
    const catBtns = document.querySelectorAll<HTMLButtonElement>(".cat-filter");
    const grid = document.getElementById("hustles-grid");

    catBtns.forEach((btn) => {
      // cloning and replacing to prevent multiple listeners
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        const cat = newBtn.dataset.cat ?? "all";

        document.querySelectorAll<HTMLButtonElement>(".cat-filter").forEach((b) => {
          b.setAttribute("aria-pressed", "false");
          b.classList.remove("border-[var(--color-violet)]", "text-[var(--color-canvas)]", "bg-[var(--color-violet)]", "shadow-[0_0_15px_rgba(217,70,168,0.3)]");
          b.classList.add("border-[var(--color-hairline-strong)]", "text-[var(--color-body)]", "bg-transparent");
        });
        newBtn.setAttribute("aria-pressed", "true");
        newBtn.classList.add("border-[var(--color-violet)]", "text-[var(--color-canvas)]", "bg-[var(--color-violet)]", "shadow-[0_0_15px_rgba(217,70,168,0.3)]");
        newBtn.classList.remove("border-[var(--color-hairline-strong)]", "text-[var(--color-body)]", "bg-transparent");

        grid?.querySelectorAll<HTMLElement>("[data-slug]").forEach((card) => {
          const match = cat === "all" || card.dataset.cat === cat;
          if (match) {
            card.style.display = "";
            setTimeout(() => {
              card.style.opacity = "1";
              card.style.transform = "translateY(0)";
            }, 50);
          } else {
            card.style.opacity = "0";
            card.style.transform = "translateY(10px)";
            setTimeout(() => {
              card.style.display = "none";
            }, 300);
          }
        });
      });
    });
  }

  // ─── SEO content expand/collapse (mobile only) ─────────────────────────────
  function setupSEOExpand() {
    const btn = document.getElementById('seo-expand-btn');
    const full = document.getElementById('seo-full');
    const icon = document.getElementById('seo-expand-icon');
    const preview = document.getElementById('seo-preview');
    if (!btn || !full) return;

    // Clone to prevent duplicate listeners on navigation
    const newBtn = btn.cloneNode(true) as HTMLButtonElement;
    btn.parentNode?.replaceChild(newBtn, btn);
    const newIcon = document.getElementById('seo-expand-icon');

    newBtn.addEventListener('click', () => {
      const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        full.classList.add('hidden');
        newBtn.setAttribute('aria-expanded', 'false');
        newBtn.childNodes[0].textContent = 'Read more';
        if (newIcon) newIcon.style.transform = 'rotate(0deg)';
      } else {
        full.classList.remove('hidden');
        newBtn.setAttribute('aria-expanded', 'true');
        newBtn.childNodes[0].textContent = 'Show less';
        if (newIcon) newIcon.style.transform = 'rotate(180deg)';
      }
    });
  }

  setupFilters();
  setupSEOExpand();
  document.addEventListener("astro:page-load", () => {
    setupFilters();
    setupSEOExpand();
  });
</script>
