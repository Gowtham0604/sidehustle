---
import Layout from "../layouts/Layout.astro";
import type { SideHustle } from "../types/side-hustle";
import hustleData from "../data/side-hustles.json";

const hustles = hustleData as SideHustle[];

const title = "Find the Side Hustle You Can Start This Week | SideHustlesJob";
const description = "Take a fast, practical quiz and get one best side hustle match, two backups, and a day-by-day 7-day launch plan based on your skills, time, budget, risk tolerance, and income target.";
const canonical = "https://sidehustlesjob.com";

const sampleOutcomes = [
  {
    profile: "No technical skills · $0 budget · 5 hours/week",
    match: "Virtual Assistant",
    result: "First client pitch template and 20-prospect list ready in 45 minutes.",
  },
  {
    profile: "Writes well · needs income fast · remote only",
    match: "Freelance Writing",
    result: "Pitch template, a 20-client target list, and a starter rate you can charge today.",
  },
  {
    profile: "Local work fine · low risk · flexible evenings",
    match: "Food Delivery",
    result: "App setup guide, best shift windows, and a first-week earning target.",
  },
];

const trustSignals = [
  { label: `${hustles.length} options scored` },
  { label: "7 quick questions" },
  { label: "7-day action plan" },
  { label: "No account needed" },
];
---

<Layout title={title} description={description} canonical={canonical} keywords="side hustle quiz, best side hustle for me, start a side hustle this week">

  <!-- ─── Hero ──────────────────────────────────────────────────────────── -->
  <section class="min-h-[calc(100svh-56px)] sm:min-h-[calc(100svh-80px)] pt-20 sm:pt-28 pb-12 sm:pb-20 flex items-center border-b border-slate-200 bg-white" aria-labelledby="hero-heading">
    <div class="container-page w-full">
      <div class="grid lg:grid-cols-[1fr_400px] gap-10 lg:gap-16 items-center">

        <!-- Left: copy -->
        <div class="max-w-2xl">
          <p class="inline-flex items-center h-7 px-3 rounded-full border border-emerald-200 bg-emerald-50 text-[11px] font-bold text-emerald-700 mb-5 tracking-wide uppercase">
            Startable this week, not someday
          </p>
          <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-[-0.02em] text-slate-950 text-balance">
            Find the side hustle you can actually start this week.
          </h1>
          <p class="mt-5 text-base sm:text-lg leading-7 text-slate-600 max-w-xl">
            Answer 7 questions. Get one best match, two backups, and a day-by-day launch plan you can act on today.
          </p>

          <!-- Primary CTA -->
          <div class="mt-8">
            <a
              href="/quiz"
              data-track="hero_start_quiz"
              class="inline-flex h-12 sm:h-13 items-center justify-center rounded-lg bg-slate-950 px-7 text-sm font-bold text-white hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-slate-950"
            >
              Find my best match →
            </a>
          </div>

          <!-- Trust signals -->
          <div class="mt-8 flex flex-wrap gap-2" aria-label="Trust signals">
            {trustSignals.map((s) => (
              <div class="inline-flex items-center h-7 px-3 rounded-full border border-slate-200 bg-slate-50">
                <p class="text-xs font-semibold text-slate-700">{s.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: example result preview -->
        <aside class="rounded-xl border border-slate-200 bg-slate-950 text-white overflow-hidden shadow-2xl shadow-slate-900/20" aria-label="Example output">
          <div class="px-5 py-3.5 border-b border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
              <p class="text-xs font-bold text-emerald-300 uppercase tracking-wider">Example output</p>
            </div>
            <p class="text-xs text-slate-500">2 min quiz</p>
          </div>
          <div class="p-5">
            <div class="rounded-lg bg-white text-slate-950 p-4 mb-4">
              <div class="flex items-center justify-between gap-3 mb-4">
                <div>
                  <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Best match</p>
                  <h2 class="text-xl font-bold leading-tight">Virtual Assistant</h2>
                </div>
                <span class="shrink-0 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-700">92%</span>
              </div>
              <dl class="grid grid-cols-2 gap-2 text-sm">
                <div class="rounded-md bg-slate-50 p-2.5">
                  <dt class="text-[10px] text-slate-400 mb-0.5">Startup cost</dt>
                  <dd class="font-bold text-slate-950">$0</dd>
                </div>
                <div class="rounded-md bg-slate-50 p-2.5">
                  <dt class="text-[10px] text-slate-400 mb-0.5">First dollar</dt>
                  <dd class="font-bold text-slate-950">1–2 weeks</dd>
                </div>
                <div class="rounded-md bg-slate-50 p-2.5">
                  <dt class="text-[10px] text-slate-400 mb-0.5">Skill level</dt>
                  <dd class="font-bold text-slate-950">Beginner</dd>
                </div>
                <div class="rounded-md bg-slate-50 p-2.5">
                  <dt class="text-[10px] text-slate-400 mb-0.5">Risk</dt>
                  <dd class="font-bold text-slate-950">Low</dd>
                </div>
              </dl>
            </div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">7-day plan preview</p>
            <ol class="space-y-2 text-sm text-slate-200">
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 tabular-nums">D1</span>
                <span>Write a 2-sentence offer for one specific buyer type.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 tabular-nums">D2</span>
                <span>Set up your profile with a starter rate and one proof sample.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 tabular-nums">D3</span>
                <span>Find 20 prospects. Send 10 direct pitches.</span>
              </li>
            </ol>
            <div class="mt-4 pt-4 border-t border-white/10">
              <a href="/quiz" data-track="hero_preview_cta" class="flex items-center justify-center h-10 rounded-lg bg-white text-slate-950 text-sm font-bold hover:bg-slate-100 transition-colors">
                Get my own plan →
              </a>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ─── How it works ──────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-slate-50 border-b border-slate-200" aria-labelledby="how-heading">
    <div class="container-page">
      <div class="max-w-xl mb-10">
        <p class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-2">How it works</p>
        <h2 id="how-heading" class="text-2xl sm:text-3xl font-bold text-slate-950">A recommendation, not a directory.</h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-7">Most side hustle sites give you 500 options and leave you to figure it out. We give you one.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        {[
          ["1", "Tell us your constraints", "Skills, available hours, budget, risk tolerance, and income target."],
          ["2", "We score realistic options", "The engine favors startability, speed to first dollar, and fit — not hype."],
          ["3", "Leave with a plan", "One best match, two backups, exact first step, and a 7-day action plan."],
        ].map(([number, heading, copy]) => (
          <article class="rounded-lg border border-slate-200 bg-white p-5 sm:p-6">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-950 text-sm font-bold text-white mb-5">{number}</div>
            <h3 class="text-base font-bold text-slate-950 mb-2">{heading}</h3>
            <p class="text-sm leading-6 text-slate-600">{copy}</p>
          </article>
        ))}
      </div>
      <div class="mt-8">
        <a href="/quiz" data-track="howitworks_cta" class="inline-flex h-11 items-center justify-center rounded-lg bg-slate-950 px-6 text-sm font-bold text-white hover:bg-slate-800 transition-colors">
          Take the quiz — it's free →
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Sample outcomes ───────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-white border-b border-slate-200" aria-labelledby="outcomes-heading">
    <div class="container-page">
      <div class="max-w-xl mb-10">
        <p class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-2">Sample outcomes</p>
        <h2 id="outcomes-heading" class="text-2xl sm:text-3xl font-bold text-slate-950">Specific enough to act on today.</h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600">Every result includes an exact first step — not "research options" or "explore opportunities."</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        {sampleOutcomes.map((item) => (
          <article class="rounded-lg border border-slate-200 bg-slate-50 p-5 flex flex-col">
            <div class="mb-4">
              <p class="text-[10px] font-bold uppercase text-slate-400 tracking-wider mb-1.5">Profile</p>
              <p class="text-sm leading-6 text-slate-700">{item.profile}</p>
            </div>
            <div class="pt-4 border-t border-slate-200 flex-1">
              <p class="text-[10px] font-bold uppercase text-slate-400 tracking-wider mb-1.5">Likely match</p>
              <h3 class="text-xl font-bold text-slate-950 mb-2">{item.match}</h3>
              <p class="text-sm leading-6 text-slate-600">{item.result}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-8">
        <a href="/quiz" data-track="outcomes_cta" class="inline-flex h-11 items-center justify-center rounded-lg border border-slate-300 bg-white px-5 text-sm font-bold text-slate-950 hover:bg-slate-50 transition-colors">
          Get my match →
        </a>
      </div>
    </div>
  </section>

  <!-- ─── What you get ──────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-slate-50 border-b border-slate-200" aria-labelledby="what-heading">
    <div class="container-page">
      <div class="max-w-xl mb-10">
        <p class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-2">What you get</p>
        <h2 id="what-heading" class="text-2xl sm:text-3xl font-bold text-slate-950">Everything to make a decision and start.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { title: "One best match", desc: "Not a ranked list of 50. One clear recommendation based on your answers." },
          { title: "Two backups", desc: "Alternatives in case the first path doesn't click — but try the first one seriously first." },
          { title: "Why it fits", desc: "Plain-English reasons why this hustle matches your skills, schedule, and budget." },
          { title: "Startup cost", desc: "Exact upfront investment needed. Most recommendations are $0 to start." },
          { title: "Time to first dollar", desc: "Honest estimate of how long before you see your first payment." },
          { title: "7-day action plan", desc: "Day-by-day tasks so you don't waste the week figuring out where to begin." },
        ].map(({ title, desc }) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5">
            <div class="flex items-center gap-2 mb-2.5">
              <span class="text-emerald-600 font-bold text-lg leading-none" aria-hidden="true">✓</span>
              <h3 class="text-sm font-bold text-slate-950">{title}</h3>
            </div>
            <p class="text-sm leading-6 text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Final CTA ─────────────────────────────────────────────────────── -->
  <section class="py-14 sm:py-20 bg-slate-950" aria-label="Final call to action">
    <div class="container-page text-center">
      <h2 class="text-2xl sm:text-4xl font-bold text-white leading-tight text-balance mb-4">
        Find the side hustle you can start this week.
      </h2>
      <p class="text-slate-400 mb-8 max-w-md mx-auto text-sm sm:text-base leading-7">
        2 minutes. 7 questions. One clear answer with a day-by-day plan.
      </p>
      <a href="/quiz" data-track="footer_cta" class="inline-flex h-12 items-center justify-center rounded-lg bg-white px-8 text-sm font-bold text-slate-950 hover:bg-slate-100 transition-colors">
        Find my best match →
      </a>
      <p class="mt-4 text-xs text-slate-600">No account required · Free</p>
    </div>
  </section>

</Layout>
