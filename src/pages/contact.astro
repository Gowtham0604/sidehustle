---
import Layout from "../layouts/Layout.astro";

const title = "Contact Us | SideHustlesJob";
const description = "Get in touch with the SideHustlesJob team. We're here for questions, feedback, partnership inquiries, and content contributions.";
const canonical = "https://sidehustlesjob.com/contact";
---

<Layout title={title} description={description} canonical={canonical}>

  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 pb-16 md:pt-48 md:pb-24">
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-slate-50 via-white to-slate-100 opacity-60"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gradient-to-tr from-pink-100/40 to-purple-100/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-page relative z-10">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold text-pink-600 uppercase tracking-widest mb-4">Contact</p>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight leading-tight mb-4 text-balance">
          We'd love to hear from you.
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed font-medium text-balance">
          Questions, feedback, partnership requests — reach out and we'll get back to you.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact section -->
  <section class="pb-20 md:pb-32">
    <div class="container-page">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

        <!-- Contact topics -->
        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">How can we help?</h2>

          {[
            {
              icon: "💬",
              title: "General Questions",
              body: "Have a question about how the site works, how we rank results, or how to get the most from the quiz?",
              email: "hello@sidehustlesjob.com",
            },
            {
              icon: "✏️",
              title: "Content & Data Corrections",
              body: "Spot outdated income data, an inaccurate description, or a side hustle we should add to our database?",
              email: "content@sidehustlesjob.com",
            },
            {
              icon: "🤝",
              title: "Partnerships & Advertising",
              body: "Interested in sponsorships, affiliate partnerships, or co-marketing opportunities?",
              email: "partnerships@sidehustlesjob.com",
            },
            {
              icon: "🔒",
              title: "Privacy & Legal",
              body: "For privacy requests, data deletion, or legal inquiries, please use our dedicated address.",
              email: "privacy@sidehustlesjob.com",
            },
          ].map(({ icon, title, body, email }) => (
            <div class="flex gap-4 p-5 rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow duration-300 group">
              <div class="text-2xl mt-0.5 shrink-0">{icon}</div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">{title}</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-2">{body}</p>
                <a
                  href={`mailto:${email}`}
                  class="text-sm font-semibold text-pink-600 hover:text-pink-700 transition-colors duration-200"
                >
                  {email}
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Contact form -->
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Send us a message</h2>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
          <form
            id="contact-form"
            class="space-y-5"
            action="https://formspree.io/f/placeholder"
            method="POST"
            novalidate
          >
            <div>
              <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Your name <span class="text-pink-500" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Jane Smith"
                class="w-full h-11 px-4 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent transition-all duration-200"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Email address <span class="text-pink-500" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="jane@example.com"
                class="w-full h-11 px-4 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent transition-all duration-200"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Subject
              </label>
              <select
                id="subject"
                name="subject"
                class="w-full h-11 px-4 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent transition-all duration-200 appearance-none"
              >
                <option value="">Select a topic...</option>
                <option value="general">General question</option>
                <option value="content">Content correction / suggestion</option>
                <option value="partnership">Partnership / advertising</option>
                <option value="privacy">Privacy / legal</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Message <span class="text-pink-500" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell us what's on your mind..."
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent transition-all duration-200 resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full h-12 font-bold text-white bg-slate-900 rounded-xl hover:bg-slate-800 transition-colors duration-200 shadow-sm hover:shadow-md"
            >
              Send message →
            </button>

            <!-- Success / error messages -->
            <p id="form-success" class="hidden text-sm font-semibold text-green-600 text-center py-2">
              ✓ Message sent! We'll get back to you within 2 business days.
            </p>
            <p id="form-error" class="hidden text-sm font-semibold text-red-500 text-center py-2">
              Something went wrong. Please email us directly at hello@sidehustlesjob.com
            </p>
          </form>
        </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successMsg = document.getElementById("form-success");
  const errorMsg = document.getElementById("form-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector("button[type='submit']") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Sending...";

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        form.reset();
        successMsg?.classList.remove("hidden");
        errorMsg?.classList.add("hidden");
      } else {
        throw new Error("Failed");
      }
    } catch {
      errorMsg?.classList.remove("hidden");
      successMsg?.classList.add("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Send message →";
    }
  });
</script>
