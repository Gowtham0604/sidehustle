---
import Layout from "../layouts/Layout.astro";

const title = "Contact Us | SideHustlesJob";
const description = "Get in touch with the SideHustlesJob team. We're here for questions, feedback, partnership inquiries, and content contributions.";
const canonical = "https://sidehustlesjob.com/contact";
---

<Layout title={title} description={description} canonical={canonical}>

  <!-- Hero -->
  <section class="pt-20 sm:pt-28 pb-12 sm:pb-16 border-b border-slate-200 bg-white">
    <div class="container-page">
      <div class="max-w-2xl mx-auto text-center">
        <p class="inline-flex items-center h-7 px-3 rounded-full border border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-600 mb-5 tracking-wide uppercase">
          Contact
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold leading-[1.05] tracking-[-0.02em] text-slate-950 text-balance mb-4">
          We'd love to hear from you.
        </h1>
        <p class="text-base sm:text-lg leading-7 text-slate-600 text-balance">
          Questions, feedback, partnership requests — reach out and we'll get back to you.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact section -->
  <section class="pb-20 md:pb-32">
    <div class="container-page">
      <div class="max-w-3xl mx-auto">

        <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">How can we help?</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {[
            {
              icon: "💬",
              title: "General Questions",
              body: "Have a question about how the site works, how we rank results, or how to get the most from the quiz?",
              email: "hello@sidehustlesjob.com",
            },
            {
              icon: "✏️",
              title: "Content & Data Corrections",
              body: "Spot outdated income data, an inaccurate description, or a side hustle we should add to our database?",
              email: "hello@sidehustlesjob.com",
            },
            {
              icon: "🤝",
              title: "Partnerships & Advertising",
              body: "Interested in sponsorships, affiliate partnerships, or co-marketing opportunities?",
              email: "hello@sidehustlesjob.com",
            },
            {
              icon: "🔒",
              title: "Privacy & Legal",
              body: "For privacy requests, data deletion, or legal inquiries, please use our dedicated address.",
              email: "hello@sidehustlesjob.com",
            },
          ].map(({ icon, title, body, email }) => (
            <div class="flex gap-4 p-6 rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow duration-300">
              <div class="text-2xl mt-0.5 shrink-0">{icon}</div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">{title}</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-3">{body}</p>
                <a
                  href={`mailto:${email}`}
                  class="text-sm font-semibold text-slate-950 hover:text-slate-700 transition-colors duration-200"
                >
                  {email}
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

</Layout>
