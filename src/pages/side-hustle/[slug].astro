---
import Layout from "../../layouts/Layout.astro";
import HustleCard from "../../components/HustleCard.astro";
import type { SideHustle } from "../../types/side-hustle";
import { getRelated, getBestFor, getNotIdealFor, generateComparisonPairs } from "../../utils/hustle";
import { sideHustleMeta, jsonLd, faqJsonLd } from "../../utils/seo";
import { AUDIENCE_PAGES } from "../../utils/audience";
import hustleData from "../../data/side-hustles.json";

export async function getStaticPaths() {
  const all = hustleData as SideHustle[];
  return all.map((h) => ({
    params: { slug: h.slug },
    props: { slug: h.slug },
  }));
}

const { slug } = Astro.props;
const all = hustleData as SideHustle[];
const hustle = all.find((h) => h.slug === slug);

if (!hustle) {
  return Astro.redirect("/404");
}

const related = getRelated(hustle, all, 4);
const bestFor = getBestFor(hustle);
const notIdealFor = getNotIdealFor(hustle);
const meta = sideHustleMeta(hustle);

// Comparison pairs for this hustle (up to 5)
const sameCatHustles = all.filter((h) => h.category === hustle.category && h.slug !== hustle.slug).slice(0, 4);

// Audience pages relevant to this hustle
const relevantAudience = AUDIENCE_PAGES.filter((p) => {
  if (hustle.category === "Development" || hustle.tags.includes("coding")) {
    if (p.slug.includes("developer") || p.slug.includes("software")) return true;
  }
  if (hustle.beginnerFriendly && p.slug.includes("beginner")) return true;
  if (hustle.remote && p.slug.includes("home")) return true;
  if (hustle.category === "Education" || hustle.tags.includes("teaching")) {
    if (p.slug.includes("teacher")) return true;
  }
  if (hustle.category === "Design" || hustle.tags.includes("design")) {
    if (p.slug.includes("designer")) return true;
  }
  if (hustle.category === "Writing" || hustle.tags.includes("writing")) {
    if (p.slug.includes("writer")) return true;
  }
  return false;
}).slice(0, 3);

const faqs = [
  {
    question: `How much can I make with ${hustle.name}?`,
    answer: `The income potential for ${hustle.name} is ${hustle.incomePotential} per month. ${hustle.description}`,
  },
  {
    question: `How much does it cost to start ${hustle.name}?`,
    answer: `The startup cost for ${hustle.name} is ${hustle.startupCost}. ${hustle.startupCost === "$0" ? "You can start for free with no upfront investment." : "This is a relatively low-cost way to get started."}`,
  },
  {
    question: `How long until I make my first money with ${hustle.name}?`,
    answer: `Most people make their first income from ${hustle.name} within ${hustle.timeToFirstIncome}.`,
  },
  {
    question: `Is ${hustle.name} beginner-friendly?`,
    answer: hustle.beginnerFriendly
      ? `Yes — ${hustle.name} is beginner-friendly. No prior experience is required to get started. The difficulty level is ${hustle.difficulty}.`
      : `${hustle.name} is rated ${hustle.difficulty} difficulty. Some relevant experience is recommended before starting.`,
  },
];

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    JSON.parse(jsonLd(hustle)),
    JSON.parse(faqJsonLd(faqs)),
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sidehustlesjob.com" },
        { "@type": "ListItem", "position": 2, "name": "Browse", "item": "https://sidehustlesjob.com/browse" },
        { "@type": "ListItem", "position": 3, "name": hustle.name, "item": `https://sidehustlesjob.com/side-hustle/${hustle.slug}` },
      ],
    },
  ],
});

const difficultyColor: Record<string, string> = {
  Beginner: "text-emerald-700 bg-emerald-50 border-emerald-200",
  Intermediate: "text-amber-700 bg-amber-50 border-amber-200",
  Advanced: "text-rose-700 bg-rose-50 border-rose-200",
};

// Category slug
const categorySlug = hustle.category.toLowerCase().replace(/\s+/g, "-");
---

<Layout title={meta.title} description={meta.description} canonical={meta.canonical} jsonLd={structuredData}>
  <!-- Breadcrumb -->
  <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]" role="list">
        <li><a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/browse" class="hover:text-[var(--color-body)] transition-colors">Browse</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/category/${categorySlug}`} class="hover:text-[var(--color-body)] transition-colors">{hustle.category}</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-[var(--color-body)]">{hustle.name}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-8 sm:pt-12 pb-12 sm:pb-16 bg-[var(--color-canvas)]" aria-labelledby="hustle-heading">
    <div class="container-page">
      <div class="max-w-3xl">
        <!-- Category + difficulty -->
        <div class="flex items-center gap-2 mb-4 sm:mb-5">
          <a
            href={`/category/${categorySlug}`}
            class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider hover:text-[var(--color-body)] transition-colors"
          >
            {hustle.category}
          </a>
          <span aria-hidden="true" class="text-[var(--color-hairline)]">·</span>
          <span
            class:list={[
              "text-xs font-medium px-2 py-0.5 rounded-full border",
              difficultyColor[hustle.difficulty] ?? "text-[var(--color-body)] bg-[var(--color-canvas-soft)] border-[var(--color-hairline)]",
            ]}
          >
            {hustle.difficulty}
          </span>
          {hustle.beginnerFriendly && (
            <span class="text-xs font-medium px-2 py-0.5 rounded-full border text-emerald-700 bg-emerald-50 border-emerald-200">
              Beginner Friendly
            </span>
          )}
        </div>

        <h1
          id="hustle-heading"
          class="text-2xl sm:text-3xl md:text-5xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-2px] leading-[1.1] mb-4 sm:mb-5 text-balance"
        >
          {hustle.name}
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-body)] leading-7 mb-6 sm:mb-8 max-w-2xl">
          {hustle.description}
        </p>

        <!-- Quick stats -->
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-0 rounded-[var(--radius-md)] border border-[var(--color-hairline)] overflow-hidden bg-[var(--color-canvas)] card-shadow mb-6 sm:mb-8 w-full">
          {[
            { label: "Income", value: hustle.incomePotential },
            { label: "Startup", value: hustle.startupCost },
            { label: "First income", value: hustle.timeToFirstIncome },
            { label: "Work type", value: hustle.remote ? "Remote" : "Local" },
          ].map(({ label, value }, i) => (
            <div class:list={[
              "px-3 sm:px-4 py-3 sm:py-4",
              i === 1 ? "border-l border-[var(--color-hairline)]" : "",
              i === 2 ? "border-t sm:border-t-0 sm:border-l border-[var(--color-hairline)]" : "",
              i === 3 ? "border-t sm:border-t-0 border-l border-[var(--color-hairline)]" : "",
            ]}>
              <dt class="text-[9px] sm:text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-0.5 sm:mb-1">{label}</dt>
              <dd class="text-xs sm:text-sm font-semibold text-[var(--color-ink)] tabular-nums">{value}</dd>
            </div>
          ))}
        </dl>

        <!-- Action buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`/roadmap/${hustle.slug}`}
            class="inline-flex items-center h-11 sm:h-12 px-5 sm:px-6 text-sm font-medium text-[var(--color-on-primary)] bg-[var(--color-ink)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-[var(--color-link)]"
          >
            View roadmap →
          </a>
          <button
            id="favorite-btn"
            data-slug={hustle.slug}
            data-name={hustle.name}
            class="inline-flex items-center gap-2 h-11 sm:h-12 px-4 sm:px-5 text-sm font-medium text-[var(--color-body)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition-colors card-shadow"
            aria-label={`Save ${hustle.name} to favorites`}
          >
            <svg id="fav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span id="fav-label">Save</span>
          </button>
          <a
            href="/quiz"
            class="inline-flex items-center h-11 sm:h-12 px-4 sm:px-5 text-sm font-medium text-[var(--color-body)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-canvas-soft)] transition-colors card-shadow"
          >
            Find similar →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-12 sm:py-16 bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)]">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-12">

        <!-- Main content -->
        <div class="lg:col-span-2 space-y-10 sm:space-y-12">

          <!-- Best for / Not ideal for -->
          <div>
            <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight mb-5">Who is this for?</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-emerald-50 rounded-[var(--radius-md)] border border-emerald-100 p-5">
                <h3 class="text-xs font-mono text-emerald-600 uppercase tracking-wider mb-4">Best for</h3>
                <ul class="space-y-2" role="list">
                  {bestFor.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-emerald-800">
                      <span class="mt-0.5 shrink-0" aria-hidden="true">✓</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="bg-amber-50 rounded-[var(--radius-md)] border border-amber-100 p-5">
                <h3 class="text-xs font-mono text-amber-600 uppercase tracking-wider mb-4">Not ideal for</h3>
                <ul class="space-y-2" role="list">
                  {notIdealFor.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-amber-800">
                      <span class="mt-0.5 shrink-0" aria-hidden="true">!</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Pros & Cons -->
          <div>
            <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight mb-5">Pros & cons.</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
                <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">Pros</h3>
                <ul class="space-y-3" role="list">
                  {hustle.pros.map((pro) => (
                    <li class="flex items-start gap-2.5 text-sm text-[var(--color-body)]">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 mt-0.5 text-emerald-500" aria-hidden="true">
                        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M4.5 7l2 2 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      {pro}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
                <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">Cons</h3>
                <ul class="space-y-3" role="list">
                  {hustle.cons.map((con) => (
                    <li class="flex items-start gap-2.5 text-sm text-[var(--color-body)]">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 mt-0.5 text-amber-500" aria-hidden="true">
                        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M7 4.5v3M7 9.5v.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                      {con}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Skills needed -->
          <div>
            <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">Skills you'll need.</h2>
            <div class="flex flex-wrap gap-2">
              {hustle.skills.map((skill) => (
                <span class="px-3 py-1.5 text-sm text-[var(--color-body)] bg-[var(--color-canvas)] rounded-full border border-[var(--color-hairline)] card-shadow">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Compare with similar hustles -->
          {sameCatHustles.length > 0 && (
            <div>
              <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">Compare with similar hustles.</h2>
              <div class="flex flex-wrap gap-2">
                {sameCatHustles.map((other) => (
                  <a
                    href={`/compare/${hustle.slug}-vs-${other.slug}`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[var(--color-body)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-full hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition-colors card-shadow"
                  >
                    {hustle.name} vs {other.name} →
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- FAQ -->
          <div>
            <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight mb-6">Frequently asked questions.</h2>
            <dl class="space-y-4">
              {faqs.map(({ question, answer }) => (
                <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
                  <dt class="text-base font-semibold text-[var(--color-ink)] mb-2">{question}</dt>
                  <dd class="text-sm text-[var(--color-body)] leading-6">{answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="space-y-5" aria-label="Side hustle details">
          <!-- Tags -->
          <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
            <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">Tags</h3>
            <div class="flex flex-wrap gap-1.5">
              {hustle.tags.map((tag) => (
                <span class="text-xs px-2 py-1 rounded-full bg-[var(--color-canvas-soft)] text-[var(--color-body)] border border-[var(--color-hairline)]">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Details -->
          <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
            <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">Details</h3>
            <dl class="space-y-3">
              <div class="flex justify-between gap-2">
                <dt class="text-xs text-[var(--color-mute)]">Hours/week</dt>
                <dd class="text-xs font-medium text-[var(--color-ink)]">{hustle.hoursPerWeek ?? "Flexible"}</dd>
              </div>
              <div class="flex justify-between gap-2 pt-3 border-t border-[var(--color-hairline)]">
                <dt class="text-xs text-[var(--color-mute)]">Beginner friendly</dt>
                <dd class="text-xs font-medium text-[var(--color-ink)]">{hustle.beginnerFriendly ? "Yes" : "No"}</dd>
              </div>
              <div class="flex justify-between gap-2 pt-3 border-t border-[var(--color-hairline)]">
                <dt class="text-xs text-[var(--color-mute)]">Weekly pay</dt>
                <dd class="text-xs font-medium text-[var(--color-ink)]">{hustle.weeklyPay ? "Yes" : "No"}</dd>
              </div>
              <div class="flex justify-between gap-2 pt-3 border-t border-[var(--color-hairline)]">
                <dt class="text-xs text-[var(--color-mute)]">Local option</dt>
                <dd class="text-xs font-medium text-[var(--color-ink)]">{hustle.localAvailable ? "Yes" : "No"}</dd>
              </div>
              <div class="flex justify-between gap-2 pt-3 border-t border-[var(--color-hairline)]">
                <dt class="text-xs text-[var(--color-mute)]">Category</dt>
                <dd>
                  <a href={`/category/${categorySlug}`} class="text-xs font-medium text-[var(--color-violet)] hover:text-[var(--color-link-deep)] transition-colors">
                    {hustle.category} →
                  </a>
                </dd>
              </div>
            </dl>
          </div>

          <!-- Roadmap CTA -->
          <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
            <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Step-by-step plan</h3>
            <p class="text-sm text-[var(--color-body)] mb-4">Get a week-by-week action plan for starting {hustle.name}.</p>
            <a
              href={`/roadmap/${hustle.slug}`}
              class="flex items-center justify-center h-9 text-sm font-medium text-[var(--color-on-primary)] bg-[var(--color-ink)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity"
            >
              View roadmap →
            </a>
          </div>

          <!-- Audience links -->
          {relevantAudience.length > 0 && (
            <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-6">
              <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">Related audience guides</h3>
              <ul class="space-y-2">
                {relevantAudience.map((p) => (
                  <li>
                    <a
                      href={`/${p.slug}`}
                      class="text-xs text-[var(--color-violet)] hover:text-[var(--color-link-deep)] transition-colors"
                    >
                      {p.title} →
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Quiz CTA -->
          <div class="bg-[var(--color-ink)] rounded-[var(--radius-md)] p-6 text-center">
            <p class="text-sm text-[var(--color-on-primary)]/70 mb-2">Not sure this is the one?</p>
            <p class="text-base font-semibold text-[var(--color-on-primary)] mb-4">Take the 7-question quiz.</p>
            <a
              href="/quiz"
              class="inline-flex items-center h-9 px-4 text-sm font-medium text-[var(--color-ink)] bg-[var(--color-on-primary)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity duration-150"
            >
              Find my hustle
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Related -->
  {related.length > 0 && (
    <section class="py-12 sm:py-16 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)]" aria-labelledby="related-heading">
      <div class="container-page">
        <div class="flex items-center justify-between gap-4 mb-6 sm:mb-8">
          <h2 id="related-heading" class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight">
            Related side hustles.
          </h2>
          <a href={`/category/${categorySlug}`} class="text-sm text-[var(--color-violet)] hover:text-[var(--color-link-deep)] transition-colors whitespace-nowrap">
            All {hustle.category} →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {related.map((h) => <HustleCard hustle={h} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Recently viewed (client-rendered) -->
  <div id="recents-section" class="hidden py-12 bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)]">
    <div class="container-page">
      <h2 class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-5">Recently viewed.</h2>
      <div id="recents-list" class="flex flex-wrap gap-2"></div>
    </div>
  </div>
</Layout>

<script define:vars={{ hustleSlug: hustle.slug, hustleName: hustle.name, hustleCategory: hustle.category }}>
  import { toggleFavorite, isFavorited, addRecentlyViewed, getRecents } from "../../utils/storage";

  function init() {
    // Track recently viewed
    addRecentlyViewed(hustleSlug, hustleName, hustleCategory);

    // Favorite button
    const favBtn = document.getElementById("favorite-btn");
    const favIcon = document.getElementById("fav-icon");
    const favLabel = document.getElementById("fav-label");

    if (favBtn && favIcon && favLabel) {
      const updateFavUI = (isFav: boolean) => {
        if (isFav) {
          favIcon.setAttribute("fill", "currentColor");
          favLabel.textContent = "Saved";
          favBtn.classList.add("text-[var(--color-violet)]", "border-[var(--color-violet)]");
        } else {
          favIcon.setAttribute("fill", "none");
          favLabel.textContent = "Save";
          favBtn.classList.remove("text-[var(--color-violet)]", "border-[var(--color-violet)]");
        }
      };

      updateFavUI(isFavorited(hustleSlug));

      favBtn.addEventListener("click", () => {
        const added = toggleFavorite(hustleSlug);
        updateFavUI(added);
      });
    }

    // Render recents
    const recents = getRecents().filter((r) => r.slug !== hustleSlug).slice(0, 6);
    const recentsSection = document.getElementById("recents-section");
    const recentsList = document.getElementById("recents-list");

    if (recents.length > 0 && recentsSection && recentsList) {
      recentsSection.classList.remove("hidden");
      recentsList.innerHTML = recents
        .map(
          (r) => `
          <a
            href="/side-hustle/${r.slug}"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[var(--color-body)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-full hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition-colors"
          >
            ${r.name}
          </a>`
        )
        .join("");
    }
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
