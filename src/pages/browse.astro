---
import Layout from "../layouts/Layout.astro";
import HustleCard from "../components/HustleCard.astro";
import Search from "../components/Search.astro";
import type { SideHustle } from "../types/side-hustle";
import hustleData from "../data/side-hustles.json";

const hustles = hustleData as SideHustle[];
const categories = [...new Set(hustles.map((h) => h.category))].sort();

const title = `Browse ${hustles.length}+ Side Hustles | SideHustlesJob`;
const description = `Browse and filter ${hustles.length}+ side hustle ideas. Search by skill, category, income goal, or startup cost to find the right opportunity for you.`;
const canonical = "https://sidehustlesjob.com/browse";

const browseJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": canonical,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": { "@id": "https://sidehustlesjob.com/#website" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sidehustlesjob.com" },
      { "@type": "ListItem", "position": 2, "name": "Browse Hustles", "item": canonical }
    ]
  }
});
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={browseJsonLd}
  keywords="side hustle ideas, browse side hustles, side hustle list, side hustle finder, best side hustles"
>
  <!-- ─── Page Hero ──────────────────────────────────────────────────────── -->
  <section class="pt-20 sm:pt-28 pb-10 sm:pb-14 border-b border-slate-200 bg-white" aria-labelledby="browse-hero-heading">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="inline-flex items-center h-7 px-3 rounded-full border border-emerald-200 bg-emerald-50 text-[11px] font-bold text-emerald-700 mb-5 tracking-wide uppercase">
          Browse all
        </p>
        <h1
          id="browse-hero-heading"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-[-0.02em] text-slate-950 text-balance mb-4 sm:mb-6"
        >
          {hustles.length}+ side hustles. Find yours.
        </h1>
        <p class="text-base sm:text-lg leading-7 text-slate-600 max-w-xl">
          Search by skill, category, or keyword. Filter by what matters to you.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── Browse Section ───────────────────────────────────────────────────── -->
  <section class="pb-16 sm:pb-24 md:pb-32 bg-white border-t border-slate-100" aria-labelledby="browse-hero-heading">
    <div class="container-page pt-8 sm:pt-12 relative z-10">

      <!-- Search + filters -->
      <div class="mb-7 sm:mb-10">
        <Search />
      </div>

      <!-- Category tabs — scrollable on mobile -->
      <div class="relative mb-7 sm:mb-10">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Category</p>
        <div class="flex flex-nowrap sm:flex-wrap gap-2 sm:gap-2.5 overflow-x-auto pb-2 sm:pb-0 scrollbar-hide" role="group" aria-label="Filter by category" style="scroll-snap-type: x mandatory;">
          <button
            class="cat-filter active shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-full border border-slate-900 text-white font-semibold bg-slate-900 transition-all duration-300 whitespace-nowrap"
            data-cat="all"
            aria-pressed="true"
            style="scroll-snap-align: start;"
          >
            All
          </button>
          {categories.map((cat) => (
            <button
              class="cat-filter shrink-0 px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-full border border-slate-200 text-slate-600 hover:border-slate-300 hover:text-slate-900 hover:bg-slate-100 transition-all duration-300 font-medium bg-white whitespace-nowrap"
              data-cat={cat}
              aria-pressed="false"
              style="scroll-snap-align: start;"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Card grid -->
      <div
        id="hustles-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6"
        role="list"
        aria-label="Side hustle cards"
      >
        {hustles.map((hustle) => (
          <div data-slug={hustle.slug} data-cat={hustle.category} role="listitem" class="transition-all duration-500">
            <HustleCard hustle={hustle} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  function initCategoryFilter() {
    const catBtns = document.querySelectorAll<HTMLButtonElement>(".cat-filter");
    const grid = document.getElementById("hustles-grid");
    if (!grid) return;

    catBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.cat ?? "all";

        catBtns.forEach((b) => {
          b.setAttribute("aria-pressed", "false");
          b.classList.remove("border-slate-900", "text-white", "bg-slate-900");
          b.classList.add("border-slate-200", "text-slate-600", "bg-white");
        });
        btn.setAttribute("aria-pressed", "true");
        btn.classList.add("border-slate-900", "text-white", "bg-slate-900");
        btn.classList.remove("border-slate-200", "text-slate-600", "bg-white");

        const allCards = grid.querySelectorAll<HTMLElement>("[data-slug]");
        allCards.forEach((card) => {
          const matches = cat === "all" || card.dataset.cat === cat;
          if (matches) {
            card.style.display = "";
            setTimeout(() => {
              card.style.opacity = "1";
              card.style.transform = "translateY(0)";
            }, 50);
          } else {
            card.style.opacity = "0";
            card.style.transform = "translateY(10px)";
            setTimeout(() => { card.style.display = "none"; }, 300);
          }
        });
      });
    });
  }

  initCategoryFilter();
  document.addEventListener("astro:page-load", initCategoryFilter);
</script>
