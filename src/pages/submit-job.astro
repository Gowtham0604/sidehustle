---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Post a Part-time Job in Bengaluru | SideHustlesJob" description="Submit a part-time job in Bengaluru for review by SideHustlesJob." canonical="https://sidehustlesjob.com/submit-job">
  <section class="border-b border-slate-200 bg-[#f6f7f3] pt-28 pb-12 sm:pt-36"><div class="container-page max-w-3xl"><p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">For employers</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-5xl">Post a part-time job.</h1><p class="mt-4 text-base leading-7 text-slate-600">Hiring for a part-time role in Bengaluru? Submit the details below. Every listing is reviewed before it goes live.</p></div></section>
  <section class="bg-white py-10 sm:py-14"><div class="container-page max-w-3xl"><form id="submit-job-form" class="space-y-5 rounded-lg border border-slate-200 p-5 sm:p-8"><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold text-slate-700">Company name<input required name="company" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label><label class="text-sm font-bold text-slate-700">Job title<input required name="title" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label></div><label class="block text-sm font-bold text-slate-700">Job description<textarea required name="description" rows="4" class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-3 font-normal"></textarea></label><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold text-slate-700">Category<select required name="category" class="mt-2 h-11 w-full rounded-lg border border-slate-300 bg-white px-3 font-normal"><option>Restaurant & Cafe</option><option>Retail</option><option>Delivery</option><option>Warehouse</option><option>Events</option><option>Office/Admin</option><option>Other</option></select></label><label class="text-sm font-bold text-slate-700">Bengaluru area<input required name="area" placeholder="e.g. Koramangala" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label></div><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold text-slate-700">Application URL<input required type="url" name="applicationUrl" placeholder="https://" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label><label class="text-sm font-bold text-slate-700">Company website<input type="url" name="companyWebsite" placeholder="https://" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label></div><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold text-slate-700">Your name<input required name="submitterName" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label><label class="text-sm font-bold text-slate-700">Your email<input required type="email" name="submitterEmail" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label></div><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold text-slate-700">Salary <span class="font-normal text-slate-400">(optional)</span><input name="salary" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label><label class="text-sm font-bold text-slate-700">Schedule <span class="font-normal text-slate-400">(optional)</span><input name="schedule" placeholder="Evening, weekends" class="mt-2 h-11 w-full rounded-lg border border-slate-300 px-3 font-normal" /></label></div><button class="h-11 rounded-lg bg-slate-950 px-5 text-sm font-bold text-white hover:bg-emerald-700" type="submit">Submit for review</button><p id="submit-status" class="text-sm text-slate-600" aria-live="polite"></p></form></div></section>
</Layout>

<script>
  document.querySelector<HTMLFormElement>("#submit-job-form")?.addEventListener("submit",(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const data=Object.fromEntries(new FormData(form));const submissions=JSON.parse(localStorage.getItem("shj_pending_submissions") || "[]");submissions.push({...data,status:"pending",submittedAt:new Date().toISOString()});localStorage.setItem("shj_pending_submissions",JSON.stringify(submissions));form.reset();const status=document.querySelector<HTMLElement>("#submit-status");if(status)status.textContent="Your job has been submitted for review. We will check the details before it goes live.";window.dispatchEvent(new CustomEvent("shj:track",{detail:{event:"job_submission_created",payload:{status:"pending"}}}));});
</script>
