---
import Layout from "../../layouts/Layout.astro";
import { jobs, getJobBySlug } from "../../utils/jobs";
import type { PartTimeJob } from "../../types/job";

export function getStaticPaths() {
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

const { job } = Astro.props as { job: PartTimeJob };
const nearby = jobs.filter((item) => item.slug !== job.slug && (item.area === job.area || item.category === job.category)).slice(0, 3);
---

<Layout title={`${job.title} in ${job.area} | SideHustlesJob`} description={`${job.title} at ${job.company} in ${job.area}, Bengaluru. See pay, schedule, requirements, and application link.`} canonical={`https://sidehustlesjob.com/jobs/${job.slug}`}>
  <section class="border-b border-slate-200 bg-[#f6f7f3] pt-28 pb-12 sm:pt-36"><div class="container-page"><a href="/jobs" class="text-sm font-bold text-emerald-700 hover:text-emerald-800">&#8592; Back to jobs</a><div class="mt-8 max-w-3xl"><p class="text-sm font-semibold text-slate-500">{job.company} <span class="px-1 text-slate-300">·</span> {job.area}, Bengaluru</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-5xl">{job.title}</h1><div class="mt-5 flex flex-wrap gap-2"><span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800">{job.hiringStatus}</span><span class="rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-semibold text-slate-600">Posted {new Date(job.postedAt).toLocaleDateString("en-IN", { day: "numeric", month: "short" })}</span></div></div></div></section>
  <section class="bg-white py-10 sm:py-14"><div class="container-page grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]"><main><div class="grid gap-3 sm:grid-cols-3"><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Pay</p><p class="mt-1 text-base font-bold text-slate-950">{job.salary}</p><p class="text-xs text-slate-500">{job.salaryPeriod}</p></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Schedule</p><p class="mt-1 text-base font-bold text-slate-950">{job.schedule.slice(0, 2).join(", ")}</p><p class="text-xs text-slate-500">{job.employmentType}</p></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Experience</p><p class="mt-1 text-base font-bold text-slate-950">{job.experience}</p><p class="text-xs text-slate-500">Required</p></div></div><div class="mt-10"><h2 class="text-xl font-bold text-slate-950">About the role</h2><p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">{job.description}</p></div><div class="mt-9"><h2 class="text-xl font-bold text-slate-950">What you will need</h2><ul class="mt-4 space-y-3 text-sm text-slate-600">{job.requirements.map((item) => <li class="flex gap-3"><span class="text-emerald-600">&#10003;</span>{item}</li>)}</ul></div><div class="mt-9"><h2 class="text-xl font-bold text-slate-950">Where it is</h2><p class="mt-3 text-sm text-slate-600">&#128205; {job.address}</p><div class="mt-4 h-40 overflow-hidden rounded-lg bg-slate-100"><iframe title={`Map location for ${job.title}`} class="h-full w-full border-0 grayscale" loading="lazy" src={`https://www.openstreetmap.org/export/embed.html?bbox=${job.lng-0.015}%2C${job.lat-0.012}%2C${job.lng+0.015}%2C${job.lat+0.012}&layer=mapnik&marker=${job.lat}%2C${job.lng}`}></iframe></div></div></main><aside class="h-fit rounded-lg border border-slate-200 bg-white p-5 shadow-sm lg:sticky lg:top-24"><p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Ready to apply?</p><h2 class="mt-2 text-lg font-bold text-slate-950">Go to the employer</h2><p class="mt-2 text-sm leading-6 text-slate-600">Confirm the current opening, pay, and shift details before applying.</p><a data-track="job_application_clicked" href={job.applicationUrl} target="_blank" rel="noreferrer" class="mt-5 flex h-11 items-center justify-center rounded-lg bg-slate-950 text-sm font-bold text-white hover:bg-emerald-700">Apply / view opening <span class="ml-2" aria-hidden="true">&#8599;</span></a><a href={job.companyWebsite} target="_blank" rel="noreferrer" class="mt-3 flex h-10 items-center justify-center rounded-lg border border-slate-300 text-sm font-bold text-slate-700 hover:border-emerald-500 hover:text-emerald-700">Visit company website</a><button id="detail-save" data-slug={job.slug} class="mt-4 w-full text-sm font-bold text-emerald-700" type="button">Save this job</button><p id="detail-save-status" class="mt-2 text-center text-xs text-slate-500" aria-live="polite"></p></aside></div></section>
  <section class="border-t border-slate-200 bg-[#f6f7f3] py-10"><div class="container-page"><h2 class="text-xl font-bold text-slate-950">More jobs to explore</h2><div class="mt-5 grid gap-3 md:grid-cols-3">{nearby.map((item) => <a href={`/jobs/${item.slug}`} class="rounded-lg border border-slate-200 bg-white p-4 hover:border-emerald-400"><p class="text-xs font-semibold text-slate-500">{item.company}</p><p class="mt-1 font-bold text-slate-950">{item.title}</p><p class="mt-3 text-xs text-slate-600">{item.area} · {item.salary}</p></a>)}</div></div></section>
</Layout>

<script>
  const saveButton = document.querySelector<HTMLButtonElement>("#detail-save");
  const saveStatus = document.querySelector<HTMLElement>("#detail-save-status");
  saveButton?.addEventListener("click", () => { const slug=saveButton.dataset.slug!; const saved=JSON.parse(localStorage.getItem("shj_saved_jobs") || "[]") as string[]; const next=saved.includes(slug) ? saved.filter((item)=>item!==slug) : [...saved,slug]; localStorage.setItem("shj_saved_jobs",JSON.stringify(next)); saveButton.textContent=next.includes(slug) ? "Saved to your jobs" : "Save this job"; if(saveStatus)saveStatus.textContent=next.includes(slug) ? "Saved in this browser." : "Removed from saved jobs."; window.dispatchEvent(new CustomEvent("shj:track",{detail:{event:"job_detail_saved",payload:{slug}}})); });
</script>
