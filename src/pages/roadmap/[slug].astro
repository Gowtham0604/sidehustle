---
import Layout from "../../layouts/Layout.astro";
import HustleCard from "../../components/HustleCard.astro";
import type { SideHustle } from "../../types/side-hustle";
import { getRoadmap, getRelated, getBestFor, getNotIdealFor } from "../../utils/hustle";
import hustleData from "../../data/side-hustles.json";

export async function getStaticPaths() {
  const all = hustleData as SideHustle[];
  return all.map((h) => ({
    params: { slug: h.slug },
    props: { slug: h.slug },
  }));
}

const { slug } = Astro.props;
const all = hustleData as SideHustle[];
const hustle = all.find((h) => h.slug === slug);
if (!hustle) return Astro.redirect("/404");

const roadmap = getRoadmap(hustle);
const related = getRelated(hustle, all, 3);
const bestFor = getBestFor(hustle);
const notIdealFor = getNotIdealFor(hustle);
const canonical = `https://sidehustlesjob.com/roadmap/${hustle.slug}`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Start ${hustle.name} as a Side Hustle: Step-by-Step Roadmap`,
  "description": `A step-by-step roadmap for starting ${hustle.name}. From setup to first income to scaling.`,
  "url": canonical,
  "totalTime": "P90D",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "USD",
    "value": hustle.startupCost === "$0" ? "0" : hustle.startupCost.replace(/[^0-9]/g, "") || "50",
  },
  "step": roadmap.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": `${step.week}: ${step.title}`,
    "text": step.tasks.join(" "),
    "url": `${canonical}#step-${i + 1}`,
  })),
});
---

<Layout
  title={`${hustle.name} Roadmap: How to Start Step-by-Step | SideHustlesJob`}
  description={`Step-by-step roadmap to start ${hustle.name} as a side hustle. Week 1 to first income to scaling — everything you need to get started today.`}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]" role="list">
        <li><a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/side-hustle/${hustle.slug}`} class="hover:text-[var(--color-body)] transition-colors">{hustle.name}</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-[var(--color-body)]">Roadmap</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-10 pb-12 sm:pt-14 sm:pb-16 bg-white border-b border-slate-200" aria-labelledby="roadmap-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider">{hustle.category}</span>
          <span aria-hidden="true" class="text-[var(--color-hairline)]">·</span>
          <span class="text-xs font-medium text-[var(--color-body)]">Step-by-step roadmap</span>
        </div>
        <h1 id="roadmap-heading" class="text-2xl sm:text-4xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-2px] leading-[1.1] mb-4 text-balance">
          {hustle.name} roadmap.
        </h1>
        <p class="text-sm sm:text-base text-[var(--color-body)] leading-7 mb-6">
          From day one to your first income and beyond — a practical week-by-week plan for starting {hustle.name} as a side hustle.
        </p>
        <!-- Quick stats -->
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 p-3 sm:p-4 rounded-[var(--radius-md)] bg-[var(--color-canvas)] card-shadow">
          {[
            { label: "Income potential", value: hustle.incomePotential },
            { label: "Startup cost", value: hustle.startupCost },
            { label: "First income", value: hustle.timeToFirstIncome },
            { label: "Difficulty", value: hustle.difficulty },
          ].map(({ label, value }) => (
            <div class="text-center px-1 py-1">
              <dt class="text-[9px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-0.5 leading-tight">{label}</dt>
              <dd class="text-xs font-semibold text-[var(--color-ink)] leading-tight">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Roadmap steps -->
  <section class="py-12 sm:py-16 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-labelledby="steps-heading">
    <div class="container-page">
      <div class="max-w-3xl">
        <h2 id="steps-heading" class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-8">Your action plan.</h2>
        <ol class="relative space-y-0" role="list">
          {roadmap.map((step, i) => (
            <li id={`step-${i + 1}`} class="relative flex gap-4 sm:gap-8 pb-8 sm:pb-10 last:pb-0" role="listitem">
              <!-- Timeline connector -->
              <div class="flex flex-col items-center shrink-0">
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[var(--color-ink)] text-[var(--color-on-primary)] flex items-center justify-center text-xs font-bold shrink-0 z-10 relative">
                  {i + 1}
                </div>
                {i < roadmap.length - 1 && (
                  <div class="w-px flex-1 bg-[var(--color-hairline-strong)] mt-2"></div>
                )}
              </div>
              <!-- Content -->
              <div class="flex-1 pb-2">
                <p class="text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-1">{step.week}</p>
                <h3 class="text-base font-semibold text-[var(--color-ink)] mb-3">{step.title}</h3>
                <ul class="space-y-2">
                  {step.tasks.map((task) => (
                    <li class="flex items-start gap-2.5 text-sm text-[var(--color-body)]">
                      <span class="text-[var(--color-violet)] mt-0.5 shrink-0 text-base leading-none" aria-hidden="true">→</span>
                      {task}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Best for / Not ideal for -->
  <section class="py-12 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-labelledby="fit-heading">
    <div class="container-page">
      <h2 id="fit-heading" class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-6">Is {hustle.name} right for you?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="bg-emerald-50 rounded-[var(--radius-md)] p-6 border border-emerald-100">
          <p class="text-xs font-mono text-emerald-600 uppercase tracking-wider mb-4">Best for</p>
          <ul class="space-y-2">
            {bestFor.map((item) => (
              <li class="flex items-start gap-2 text-sm text-emerald-800">
                <span class="mt-0.5 shrink-0" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-amber-50 rounded-[var(--radius-md)] p-6 border border-amber-100">
          <p class="text-xs font-mono text-amber-600 uppercase tracking-wider mb-4">Not ideal for</p>
          <ul class="space-y-2">
            {notIdealFor.map((item) => (
              <li class="flex items-start gap-2 text-sm text-amber-800">
                <span class="mt-0.5 shrink-0" aria-hidden="true">!</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills needed -->
  <section class="py-12 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-labelledby="skills-heading">
    <div class="container-page">
      <h2 id="skills-heading" class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-4">Skills you'll need.</h2>
      <div class="flex flex-wrap gap-2">
        {hustle.skills.map((skill) => (
          <span class="px-3 py-1.5 text-sm text-[var(--color-body)] bg-[var(--color-canvas)] rounded-full border border-[var(--color-hairline)] card-shadow">
            {skill}
          </span>
        ))}
      </div>
      <p class="text-xs text-[var(--color-mute)] mt-3">
        Missing some of these? Start with the beginner-friendly hustles below while building these skills.
      </p>
    </div>
  </section>

  <!-- Similar hustles internal linking -->
  {related.length > 0 && (
    <section class="py-12 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-labelledby="similar-heading">
      <div class="container-page">
        <h2 id="similar-heading" class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-6">
          Similar side hustles to consider.
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {related.map((h) => <HustleCard hustle={h} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-12 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]">
    <div class="container-page">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-ink)] mb-1">Ready to start {hustle.name}?</h2>
          <p class="text-sm text-[var(--color-body)]">Read the full guide for income data, pros & cons, and FAQs.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={`/side-hustle/${hustle.slug}`}
            class="inline-flex items-center h-10 px-5 text-sm font-semibold text-[var(--color-on-primary)] bg-[var(--color-ink)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity"
          >
            Full guide →
          </a>
          <a
            href="/quiz"
            class="inline-flex items-center h-10 px-5 text-sm font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-canvas-soft)] transition-colors card-shadow"
          >
            Find better matches →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
