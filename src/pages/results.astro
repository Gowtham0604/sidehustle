---
import Layout from "../layouts/Layout.astro";

const title = "Your Side Hustle Plan | SideHustlesJob";
const description = "Your personalized side hustle recommendation — one best match, two backups, and a 7-day action plan you can start today.";
const canonical = "https://sidehustlesjob.com/results";
---

<Layout title={title} description={description} canonical={canonical}>

  <!-- Loading state — shown while JS initializes -->
  <div id="results-loading" class="min-h-[calc(100svh-56px)] sm:min-h-[calc(100svh-80px)] flex items-center justify-center bg-white">
    <div class="text-center">
      <div class="h-10 w-10 rounded-full border-4 border-slate-100 border-t-[var(--color-violet)] animate-spin mx-auto" aria-hidden="true"></div>
      <p class="mt-4 text-sm text-slate-500">Loading your plan...</p>
    </div>
  </div>

  <!-- Results content — hidden until JS renders -->
  <div id="results-page" class="hidden">

    <!-- Hero band -->
    <section class="border-b border-slate-200 bg-white pt-24 sm:pt-32 pb-8 sm:pb-12" aria-labelledby="results-heading">
      <div class="container-page">
        <div id="results-hero-content">
          <!-- Injected by JS -->
        </div>
      </div>
    </section>

    <!-- Main results -->
    <section class="py-8 sm:py-12 bg-slate-50">
      <div class="container-page">
        <div id="results-shell" aria-live="polite">
          <!-- Injected by JS -->
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-12 sm:py-16 bg-white border-t border-slate-200">
      <div class="container-page text-center">
        <p class="text-xs font-bold uppercase text-slate-500 mb-2">Not quite right?</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 mb-3">Get a plan built for your answers.</h2>
        <p class="text-sm sm:text-base text-slate-600 mb-6 max-w-md mx-auto">This link was shared with you. Take the quiz yourself for a personalized recommendation.</p>
        <a href="/quiz" data-track="results_page_cta" class="inline-flex h-12 items-center justify-center rounded-lg bg-slate-950 px-7 text-sm font-bold text-white hover:bg-slate-800 transition-colors">
          Take the quiz →
        </a>
      </div>
    </section>
  </div>

  <!-- Empty / error state -->
  <div id="results-empty" class="hidden min-h-[calc(100svh-56px)] sm:min-h-[calc(100svh-80px)] flex items-center justify-center bg-slate-50">
    <div class="text-center max-w-md px-4">
      <div class="mx-auto mb-6 h-16 w-16 rounded-2xl bg-slate-100 flex items-center justify-center text-3xl" aria-hidden="true">🔍</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-950 mb-3">No plan found.</h1>
      <p class="text-slate-600 mb-8">This link doesn't include a recommendation. Take the quiz to get your personalized plan.</p>
      <a href="/quiz" class="inline-flex h-12 items-center justify-center rounded-lg bg-slate-950 px-7 text-sm font-bold text-white hover:bg-slate-800 transition-colors">
        Take the quiz →
      </a>
    </div>
  </div>

</Layout>

<script>
  import type { SideHustle } from "../types/side-hustle";
  import { getRiskLevel } from "../utils/hustle";
  import hustleData from "../data/side-hustles.json";

  const all = hustleData as SideHustle[];

  function track(event: string, payload: Record<string, unknown> = {}) {
    window.dispatchEvent(new CustomEvent("shj:track", { detail: { event, payload } }));
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const el = document.createElement("textarea");
      el.value = text;
      el.style.cssText = "position:fixed;opacity:0;pointer-events:none";
      document.body.appendChild(el);
      el.select();
      const ok = document.execCommand("copy");
      el.remove();
      return ok;
    }
  }

  function firstStep(hustle: SideHustle): string {
    if (hustle.remote) {
      return `Write a one-sentence ${hustle.name} offer for a specific buyer type. Then send it to 10 people before building anything else.`;
    }
    return `List or apply locally today, then schedule your first available earning block within the next 72 hours.`;
  }

  function sevenDayPlan(hustle: SideHustle): Array<[string, string]> {
    const name = hustle.name;
    return [
      ["Day 1", `Write a 2-sentence ${name} offer targeted at one specific buyer.`],
      ["Day 2", "Set up your minimum profile: clear photo, short bio, starter rate, one proof sample."],
      ["Day 3", "Find 20 prospects or platforms where buyers already look for this."],
      ["Day 4", "Send 10 direct pitches or applications. Track every response."],
      ["Day 5", "Improve the offer based on objections. Send 10 more."],
      ["Day 6", "Book one starter job, trial shift, or discounted first project."],
      ["Day 7", "Review replies, hours, and expected pay. Keep the best channel."],
    ];
  }

  function metricEl(label: string, value: string): string {
    return `
      <div class="rounded-lg bg-slate-50 p-3 sm:p-4">
        <dt class="text-xs text-slate-500 mb-1">${label}</dt>
        <dd class="text-sm font-bold text-slate-950">${value}</dd>
      </div>`;
  }

  function bestMatchCard(hustle: SideHustle): string {
    const risk = getRiskLevel(hustle);
    return `
      <article class="rounded-xl border-2 border-slate-950 bg-white overflow-hidden">
        <!-- Card header band -->
        <div class="bg-slate-950 px-5 sm:px-6 py-3 flex items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
            <p class="text-xs font-bold uppercase text-emerald-300 tracking-wider">Best match</p>
          </div>
          <p class="text-xs text-slate-400">Start here first</p>
        </div>
        <!-- Card body -->
        <div class="p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4 mb-5">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 leading-tight">${hustle.name}</h2>
              <p class="mt-2 text-sm leading-6 text-slate-600 max-w-xl">${hustle.description}</p>
            </div>
          </div>
          <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
            ${metricEl("Startup cost", hustle.startupCost)}
            ${metricEl("First dollar", hustle.timeToFirstIncome)}
            ${metricEl("Skill level", hustle.difficulty)}
            ${metricEl("Risk", risk)}
          </dl>
          <div class="grid md:grid-cols-2 gap-5 pt-5 border-t border-slate-100">
            <div>
              <p class="text-xs font-bold uppercase text-slate-500 mb-3">Why it fits</p>
              <ul class="space-y-2 text-sm text-slate-700">
                ${hustle.pros.slice(0, 3).map((p) =>
                  `<li class="flex items-start gap-2"><span style="color:var(--color-violet)" class="font-bold mt-0.5 shrink-0">✓</span><span>${p}</span></li>`
                ).join("")}
              </ul>
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-slate-500 mb-3">Exact first step</p>
              <p class="text-sm leading-6 text-slate-700">${firstStep(hustle)}</p>
              <a href="/side-hustle/${hustle.slug}" class="inline-flex items-center gap-1 mt-4 text-xs font-bold text-slate-950 hover:text-slate-700 transition-colors">
                Full guide <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        </div>
      </article>`;
  }

  function backupCard(hustle: SideHustle, index: number): string {
    const risk = getRiskLevel(hustle);
    return `
      <article class="rounded-xl border border-slate-200 bg-white overflow-hidden">
        <div class="bg-slate-50 px-5 py-3 border-b border-slate-200">
          <p class="text-xs font-bold uppercase text-slate-500 tracking-wider">Backup ${index + 1}</p>
        </div>
        <div class="p-5">
          <h3 class="text-xl font-bold text-slate-950 mb-2">${hustle.name}</h3>
          <p class="text-sm leading-6 text-slate-600 mb-4">${hustle.description}</p>
          <dl class="grid grid-cols-2 gap-2 mb-4">
            ${metricEl("Startup cost", hustle.startupCost)}
            ${metricEl("First dollar", hustle.timeToFirstIncome)}
            ${metricEl("Skill level", hustle.difficulty)}
            ${metricEl("Risk", risk)}
          </dl>
          <a href="/side-hustle/${hustle.slug}" class="inline-flex items-center gap-1 text-xs font-bold text-slate-700 hover:text-slate-950 transition-colors">
            Full guide <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>`;
  }

  function sevenDayPlanHTML(hustle: SideHustle): string {
    const plan = sevenDayPlan(hustle);
    return `
      <section class="rounded-xl border border-slate-200 bg-slate-950 overflow-hidden" aria-labelledby="shared-plan-heading">
        <div class="px-5 sm:px-6 py-4 border-b border-white/10 flex items-center justify-between">
          <h2 id="shared-plan-heading" class="text-lg font-bold text-white">7-day action plan</h2>
          <span class="text-xs text-slate-400">Start ${hustle.name} this week</span>
        </div>
        <div class="p-5 sm:p-6 grid sm:grid-cols-2 gap-3">
          ${plan.map(([day, task]) => `
            <div class="rounded-lg bg-white/[0.06] border border-white/10 p-4">
              <p class="text-xs font-bold text-emerald-400 mb-2">${day}</p>
              <p class="text-sm leading-6 text-slate-200">${task}</p>
            </div>`).join("")}
        </div>
      </section>`;
  }

  function init() {
    const loadingEl = document.getElementById("results-loading")!;
    const pageEl = document.getElementById("results-page")!;
    const emptyEl = document.getElementById("results-empty")!;
    const heroContent = document.getElementById("results-hero-content")!;
    const shell = document.getElementById("results-shell")!;

    const params = new URLSearchParams(window.location.search);
    const slugs = params.getAll("match");

    const hustles = slugs
      .map((s) => all.find((h) => h.slug === s))
      .filter(Boolean) as SideHustle[];

    const best = hustles[0];

    loadingEl.classList.add("hidden");

    if (!best) {
      emptyEl.classList.remove("hidden");
      track("results_page_empty");
      return;
    }

    pageEl.classList.remove("hidden");

    // Hero
    heroContent.innerHTML = `
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
        <div>
          <p class="text-xs font-bold uppercase text-emerald-700 mb-2">Shared plan</p>
          <h1 id="results-heading" class="text-3xl sm:text-5xl font-bold text-slate-950 leading-tight tracking-normal text-balance">
            ${best.name} is your move this week.
          </h1>
          <p class="mt-3 max-w-xl text-base sm:text-lg text-slate-600 leading-7">
            Start here. The backups are solid, but don't split your focus — give this one a full week first.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <button id="save-results-btn" class="h-10 rounded-lg border border-slate-300 bg-white px-4 text-sm font-bold text-slate-950 hover:bg-slate-50 transition-colors">
            Save
          </button>
          <button id="copy-results-btn" class="h-10 rounded-lg border border-slate-300 bg-white px-4 text-sm font-bold text-slate-950 hover:bg-slate-50 transition-colors">
            Copy link
          </button>
          <a href="/quiz" data-track="results_retake" class="inline-flex h-10 items-center justify-center rounded-lg bg-slate-950 px-5 text-sm font-bold text-white hover:bg-slate-800 transition-colors">
            Get my own plan →
          </a>
        </div>
      </div>`;

    // Results
    const backups = hustles.slice(1, 3);
    shell.innerHTML = `
      <div class="space-y-5">
        ${bestMatchCard(best)}
        ${sevenDayPlanHTML(best)}
        ${backups.length > 0 ? `
          <section aria-labelledby="backups-heading">
            <h2 id="backups-heading" class="text-xl font-bold text-slate-950 mb-4">Two backups if the first path stalls</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              ${backups.map((h, i) => backupCard(h, i)).join("")}
            </div>
          </section>` : ""}
      </div>`;

    // Wire up buttons
    document.getElementById("copy-results-btn")?.addEventListener("click", async () => {
      const btn = document.getElementById("copy-results-btn") as HTMLButtonElement;
      const ok = await copyText(window.location.href);
      if (btn) {
        btn.textContent = ok ? "Copied!" : "Copy failed";
        setTimeout(() => { btn.textContent = "Copy link"; }, 2000);
      }
      track("shared_results_copied", { best: best.slug });
    });

    document.getElementById("save-results-btn")?.addEventListener("click", () => {
      const btn = document.getElementById("save-results-btn") as HTMLButtonElement;
      import("../utils/storage").then(({ saveResult }) => {
        hustles.slice(0, 3).forEach((h, i) =>
          saveResult(h.slug, h.name, i === 0 ? 100 : 80 - i * 5)
        );
        if (btn) {
          btn.textContent = "Saved ✓";
          btn.disabled = true;
        }
      });
      track("shared_results_saved", { best: best.slug });
    });

    track("shared_results_viewed", { best: best.slug, count: hustles.length });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
