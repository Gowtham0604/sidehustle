---
import Layout from "../../layouts/Layout.astro";
import type { SideHustle } from "../../types/side-hustle";
import { generateComparisonPairs } from "../../utils/hustle";
import hustleData from "../../data/side-hustles.json";

const all = hustleData as SideHustle[];
const pairs = generateComparisonPairs(all, 60);
const canonical = "https://sidehustlesjob.com/compare";

// Group by category
const grouped: Record<string, Array<[SideHustle, SideHustle]>> = {};
pairs.forEach(([a, b]) => {
  const key = a.category;
  if (!grouped[key]) grouped[key] = [];
  grouped[key].push([a, b]);
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": canonical,
  "url": canonical,
  "name": "Compare Side Hustles | SideHustlesJob",
  "description": "Compare side hustles side-by-side. Income potential, startup cost, difficulty, and which one fits your situation.",
});
---

<Layout
  title="Compare Side Hustles Side-by-Side | SideHustlesJob"
  description="Compare side hustles side-by-side. Income potential, startup cost, difficulty — find which one fits your situation best."
  canonical={canonical}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]" role="list">
        <li><a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-[var(--color-body)]">Compare</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-10 pb-12 sm:pt-14 sm:pb-16 bg-white border-b border-slate-200" aria-labelledby="compare-index-heading">
    <div class="container-page">
      <p class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Side-by-side</p>
      <h1 id="compare-index-heading" class="text-2xl sm:text-4xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-2px] leading-[1.1] mb-4 text-balance">
        Compare side hustles.
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-body)] leading-7 mb-6 max-w-xl">
        Compare any two side hustles on income potential, startup cost, difficulty, and more. Find the one that fits your situation best.
      </p>
      <a href="/quiz" class="inline-flex items-center h-11 px-5 text-sm font-medium text-[var(--color-on-primary)] bg-[var(--color-ink)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity">
        Or take the quiz for personalized matches →
      </a>
    </div>
  </section>

  <!-- Grouped comparisons -->
  <section class="py-12 sm:py-16 bg-[var(--color-canvas-soft)]" aria-label="Comparison pairs">
    <div class="container-page space-y-10">
      {Object.entries(grouped).map(([cat, catPairs]) => (
        <div>
          <h2 class="text-base font-semibold text-[var(--color-ink)] tracking-tight mb-4">
            {cat}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {catPairs.slice(0, 6).map(([a, b]) => (
              <a
                href={`/compare/${a.slug}-vs-${b.slug}`}
                class="flex items-center justify-between gap-3 p-4 bg-[var(--color-canvas)] rounded-[var(--radius-md)] border border-[var(--color-hairline)] hover:border-[var(--color-violet)] hover:shadow-sm transition-all duration-200 card-shadow group"
              >
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold text-[var(--color-ink)] truncate">{a.name}</p>
                  <p class="text-[10px] text-[var(--color-mute)]">vs</p>
                  <p class="text-xs font-semibold text-[var(--color-ink)] truncate">{b.name}</p>
                </div>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" class="shrink-0 text-[var(--color-mute)] group-hover:text-[var(--color-violet)] transition-colors" aria-hidden="true">
                  <path d="M3.5 8h9M9 4.5l3.5 3.5L9 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
