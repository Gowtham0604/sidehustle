---
import Layout from "../../layouts/Layout.astro";
import HustleCard from "../../components/HustleCard.astro";
import type { SideHustle } from "../../types/side-hustle";
import { comparisonMeta } from "../../utils/seo";
import { generateComparisonPairs, getRelated, incomeRank, costRank } from "../../utils/hustle";
import hustleData from "../../data/side-hustles.json";

export async function getStaticPaths() {
  const all = hustleData as SideHustle[];
  const pairs = generateComparisonPairs(all, 200);
  return pairs.map(([a, b]) => ({
    params: { slug: `${a.slug}-vs-${b.slug}` },
    props: { slugA: a.slug, slugB: b.slug },
  }));
}

const { slugA, slugB } = Astro.props;
const all = hustleData as SideHustle[];
const a = all.find((h) => h.slug === slugA)!;
const b = all.find((h) => h.slug === slugB)!;

if (!a || !b) return Astro.redirect("/404");

const meta = comparisonMeta(a, b);
const relatedA = getRelated(a, all, 3);
const relatedB = getRelated(b, all, 3);

// Winner logic
const incomeWinner = incomeRank(a.incomePotential) >= incomeRank(b.incomePotential) ? a : b;
const costWinner = costRank(a.startupCost) <= costRank(b.startupCost) ? a : b; // lower cost = better
const beginnerWinner = a.beginnerFriendly && !b.beginnerFriendly ? a : (!a.beginnerFriendly && b.beginnerFriendly ? b : null);

// Comparison rows
const rows = [
  { label: "Income Potential", a: a.incomePotential, b: b.incomePotential, winner: incomeWinner.slug },
  { label: "Startup Cost", a: a.startupCost, b: b.startupCost, winner: costWinner.slug },
  { label: "Difficulty", a: a.difficulty, b: b.difficulty, winner: null },
  { label: "Time to First Income", a: a.timeToFirstIncome, b: b.timeToFirstIncome, winner: null },
  { label: "Work Type", a: a.remote ? "Remote" : "Local", b: b.remote ? "Remote" : "Local", winner: null },
  { label: "Beginner Friendly", a: a.beginnerFriendly ? "Yes" : "No", b: b.beginnerFriendly ? "Yes" : "No", winner: beginnerWinner?.slug ?? null },
  { label: "Weekly Pay", a: a.weeklyPay ? "Yes" : "No", b: b.weeklyPay ? "Yes" : "No", winner: null },
  { label: "Hours/Week", a: a.hoursPerWeek ?? "Flexible", b: b.hoursPerWeek ?? "Flexible", winner: null },
];

const difficultyOrder = { Beginner: 0, Intermediate: 1, Advanced: 2 };

// Who wins overall?
let aScore = 0, bScore = 0;
if (incomeRank(a.incomePotential) > incomeRank(b.incomePotential)) aScore += 2; else bScore += 2;
if (costRank(a.startupCost) < costRank(b.startupCost)) aScore += 1; else bScore += 1;
if (a.beginnerFriendly) aScore += 1; if (b.beginnerFriendly) bScore += 1;
if (a.remote) aScore += 1; if (b.remote) bScore += 1;
if (a.weeklyPay) aScore += 1; if (b.weeklyPay) bScore += 1;
const overallWinner = aScore > bScore ? a : (bScore > aScore ? b : null);

const canonical = `https://sidehustlesjob.com/compare/${slugA}-vs-${slugB}`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonical,
      "url": canonical,
      "name": meta.title,
      "description": meta.description,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sidehustlesjob.com" },
          { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://sidehustlesjob.com/compare" },
          { "@type": "ListItem", "position": 3, "name": `${a.name} vs ${b.name}`, "item": canonical },
        ],
      },
    },
  ],
});

const difficultyBadge: Record<string, string> = {
  Beginner: "text-emerald-700 bg-emerald-50 border-emerald-200",
  Intermediate: "text-amber-700 bg-amber-50 border-amber-200",
  Advanced: "text-rose-700 bg-rose-50 border-rose-200",
};
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]" role="list">
        <li><a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/browse" class="hover:text-[var(--color-body)] transition-colors">Compare</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-[var(--color-body)]">{a.name} vs {b.name}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-10 pb-12 sm:pt-14 sm:pb-16 bg-white border-b border-slate-200" aria-labelledby="compare-heading">
    <div class="container-page">
      <p class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Side-by-side comparison</p>
      <h1 id="compare-heading" class="text-2xl sm:text-4xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-2px] leading-[1.1] mb-4 text-balance">
        {a.name} vs {b.name}
      </h1>
      <p class="text-sm text-[var(--color-body)] leading-6 max-w-xl mb-6">
        {meta.description}
      </p>
      {overallWinner && (
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-success)]/10 border border-[var(--color-success)]/20 text-sm font-semibold text-[var(--color-success)] max-w-full">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="truncate">Overall edge: {overallWinner.name}</span>
        </div>
      )}
    </div>
  </section>

  <!-- Comparison table -->
  <section class="py-12 sm:py-16 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-labelledby="comparison-table-heading">
    <div class="container-page">
      <h2 id="comparison-table-heading" class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-6 sr-only">Comparison table</h2>

      <!-- Mobile card layout (< sm) -->
      <div class="sm:hidden space-y-3" role="table" aria-label={`Comparison: ${a.name} vs ${b.name}`}>
        <!-- Column headers -->
        <div role="row" class="grid grid-cols-2 gap-2 mb-1">
          <div role="columnheader" class="text-center">
            <a href={`/side-hustle/${a.slug}`} class="text-xs font-bold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors leading-tight block">{a.name}</a>
          </div>
          <div role="columnheader" class="text-center">
            <a href={`/side-hustle/${b.slug}`} class="text-xs font-bold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors leading-tight block">{b.name}</a>
          </div>
        </div>
        {rows.map(({ label, a: valA, b: valB, winner }) => (
          <div role="row" class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] overflow-hidden card-shadow">
            <div class="px-3 py-1.5 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]">
              <span class="text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider">{label}</span>
            </div>
            <div class="grid grid-cols-2 divide-x divide-[var(--color-hairline)]">
              <div role="cell" class:list={["px-3 py-2.5 text-center", winner === a.slug ? "bg-[var(--color-success)]/5" : ""]}>
                <span class:list={["text-xs font-semibold", winner === a.slug ? "text-[var(--color-success)]" : "text-[var(--color-ink)]"]}>
                  {winner === a.slug && <span class="mr-0.5" aria-label="winner">✓</span>}
                  {valA}
                </span>
              </div>
              <div role="cell" class:list={["px-3 py-2.5 text-center", winner === b.slug ? "bg-[var(--color-success)]/5" : ""]}>
                <span class:list={["text-xs font-semibold", winner === b.slug ? "text-[var(--color-success)]" : "text-[var(--color-ink)]"]}>
                  {winner === b.slug && <span class="mr-0.5" aria-label="winner">✓</span>}
                  {valB}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop table layout (≥ sm) -->
      <div class="hidden sm:block overflow-x-auto rounded-[var(--radius-md)] card-shadow">
        <table class="w-full bg-[var(--color-canvas)]" aria-label={`Comparison: ${a.name} vs ${b.name}`}>
          <thead>
            <tr class="border-b border-[var(--color-hairline)]">
              <th class="text-left p-4 text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider w-1/3" scope="col">Factor</th>
              <th class="text-center p-4 w-1/3" scope="col">
                <a href={`/side-hustle/${a.slug}`} class="text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors">{a.name}</a>
              </th>
              <th class="text-center p-4 w-1/3 border-l border-[var(--color-hairline)]" scope="col">
                <a href={`/side-hustle/${b.slug}`} class="text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors">{b.name}</a>
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ label, a: valA, b: valB, winner }, i) => (
              <tr class:list={["border-b border-[var(--color-hairline)] last:border-0", i % 2 === 1 ? "bg-[var(--color-canvas-soft)]" : ""]}>
                <td class="p-4 text-xs font-medium text-[var(--color-body)]">{label}</td>
                <td class:list={["p-4 text-center", winner === a.slug ? "bg-[var(--color-success)]/5" : ""]}>
                  <span class:list={["text-xs font-semibold", winner === a.slug ? "text-[var(--color-success)]" : "text-[var(--color-ink)]"]}>
                    {winner === a.slug && <span class="mr-1" aria-label="winner">✓</span>}
                    {valA}
                  </span>
                </td>
                <td class:list={["p-4 text-center border-l border-[var(--color-hairline)]", winner === b.slug ? "bg-[var(--color-success)]/5" : ""]}>
                  <span class:list={["text-xs font-semibold", winner === b.slug ? "text-[var(--color-success)]" : "text-[var(--color-ink)]"]}>
                    {winner === b.slug && <span class="mr-1" aria-label="winner">✓</span>}
                    {valB}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Pros & Cons side by side -->
  <section class="py-12 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-labelledby="pros-cons-heading">
    <div class="container-page">
      <h2 id="pros-cons-heading" class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-6">Pros & cons.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- A -->
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">{a.name}</h3>
          <div class="bg-[var(--color-canvas-soft)] rounded-[var(--radius-md)] p-5">
            <p class="text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Pros</p>
            <ul class="space-y-2">
              {a.pros.map((pro) => (
                <li class="flex items-start gap-2 text-xs text-[var(--color-body)]">
                  <span class="text-[var(--color-success)] mt-0.5 shrink-0" aria-hidden="true">✓</span>
                  {pro}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-[var(--color-canvas-soft)] rounded-[var(--radius-md)] p-5">
            <p class="text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Cons</p>
            <ul class="space-y-2">
              {a.cons.map((con) => (
                <li class="flex items-start gap-2 text-xs text-[var(--color-body)]">
                  <span class="text-[var(--color-warning)] mt-0.5 shrink-0" aria-hidden="true">!</span>
                  {con}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <!-- B -->
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-[var(--color-ink)]">{b.name}</h3>
          <div class="bg-[var(--color-canvas-soft)] rounded-[var(--radius-md)] p-5">
            <p class="text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Pros</p>
            <ul class="space-y-2">
              {b.pros.map((pro) => (
                <li class="flex items-start gap-2 text-xs text-[var(--color-body)]">
                  <span class="text-[var(--color-success)] mt-0.5 shrink-0" aria-hidden="true">✓</span>
                  {pro}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-[var(--color-canvas-soft)] rounded-[var(--radius-md)] p-5">
            <p class="text-[10px] font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Cons</p>
            <ul class="space-y-2">
              {b.cons.map((con) => (
                <li class="flex items-start gap-2 text-xs text-[var(--color-body)]">
                  <span class="text-[var(--color-warning)] mt-0.5 shrink-0" aria-hidden="true">!</span>
                  {con}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verdict + Save comparison CTA -->
  <section class="py-12 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-labelledby="verdict-heading">
    <div class="container-page">
      <h2 id="verdict-heading" class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">The verdict.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-4 sm:p-6">
          <p class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-2">Choose {a.name} if…</p>
          <ul class="space-y-2 text-sm text-[var(--color-body)]">
            {incomeWinner.slug === a.slug && <li>✓ Maximizing income potential is your #1 priority ({a.incomePotential})</li>}
            {costWinner.slug === a.slug && <li>✓ You want the lowest possible startup cost ({a.startupCost})</li>}
            {a.beginnerFriendly && !b.beginnerFriendly && <li>✓ You're a beginner and need an accessible entry point</li>}
            {a.remote && !b.remote && <li>✓ You need a fully remote, location-independent option</li>}
            {a.weeklyPay && !b.weeklyPay && <li>✓ You need income fast — this pays weekly</li>}
            {!a.beginnerFriendly && <li>✓ You have intermediate-to-advanced skills to leverage</li>}
          </ul>
        </div>
        <div class="bg-[var(--color-canvas)] rounded-[var(--radius-md)] card-shadow p-4 sm:p-6">
          <p class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-2">Choose {b.name} if…</p>
          <ul class="space-y-2 text-sm text-[var(--color-body)]">
            {incomeWinner.slug === b.slug && <li>✓ Maximizing income potential is your #1 priority ({b.incomePotential})</li>}
            {costWinner.slug === b.slug && <li>✓ You want the lowest possible startup cost ({b.startupCost})</li>}
            {b.beginnerFriendly && !a.beginnerFriendly && <li>✓ You're a beginner and need an accessible entry point</li>}
            {b.remote && !a.remote && <li>✓ You need a fully remote, location-independent option</li>}
            {b.weeklyPay && !a.weeklyPay && <li>✓ You need income fast — this pays weekly</li>}
            {!b.beginnerFriendly && <li>✓ You have intermediate-to-advanced skills to leverage</li>}
          </ul>
        </div>
      </div>

      <!-- Save comparison (localStorage) -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button
          id="save-comparison-btn"
          data-slug-a={a.slug}
          data-name-a={a.name}
          data-slug-b={b.slug}
          data-name-b={b.name}
          class="inline-flex items-center gap-2 h-9 px-4 text-xs font-semibold text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-canvas-soft)] transition-colors card-shadow"
        >
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Save comparison
        </button>
        <button
          onclick={`navigator.clipboard.writeText(window.location.href).then(() => { this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Share link', 2000); })`}
          class="inline-flex items-center gap-2 h-9 px-4 text-xs font-semibold text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-canvas-soft)] transition-colors card-shadow"
        >
          Share link
        </button>
      </div>
    </div>
  </section>

  <!-- Related hustles for each -->
  <section class="py-12 bg-[var(--color-canvas)] border-b border-[var(--color-hairline)]" aria-labelledby="similar-heading">
    <div class="container-page">
      <h2 id="similar-heading" class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-6">Similar side hustles.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[...new Map([...relatedA, ...relatedB].map(h => [h.slug, h])).values()].slice(0, 3).map((h) => (
          <HustleCard hustle={h} />
        ))}
      </div>
    </div>
  </section>

  <!-- Full detail links -->
  <section class="py-12 bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]" aria-label="Full guides">
    <div class="container-page">
      <h2 class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-4">Read the full guides.</h2>
      <div class="flex flex-wrap gap-3">
        <a
          href={`/side-hustle/${a.slug}`}
          class="inline-flex items-center gap-2 h-10 px-5 text-sm font-semibold text-[var(--color-on-primary)] bg-[var(--color-ink)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity"
        >
          {a.name} full guide →
        </a>
        <a
          href={`/side-hustle/${b.slug}`}
          class="inline-flex items-center gap-2 h-10 px-5 text-sm font-semibold text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-canvas-soft)] transition-colors card-shadow"
        >
          {b.name} full guide →
        </a>
        <a
          href="/quiz"
          class="inline-flex items-center gap-2 h-10 px-5 text-sm font-medium text-[var(--color-violet)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:border-[var(--color-violet)] transition-colors card-shadow"
        >
          Take the quiz instead →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { saveComparison } from "../../utils/storage";

  function initSaveComparison() {
    const btn = document.getElementById("save-comparison-btn") as HTMLButtonElement | null;
    if (!btn) return;
    btn.addEventListener("click", () => {
      const { slugA, nameA, slugB, nameB } = btn.dataset;
      if (slugA && nameA && slugB && nameB) {
        saveComparison(slugA, nameA, slugB, nameB);
        btn.textContent = "✓ Saved!";
        btn.disabled = true;
      }
    });
  }

  initSaveComparison();
  document.addEventListener("astro:page-load", initSaveComparison);
</script>
