---
import Layout from "../layouts/Layout.astro";
import HustleFinder from "../components/HustleFinder.astro";

const title = "Side Hustle Finder — Get Your Match in 2 Minutes | SideHustlesJob";
const description = "Answer 7 quick questions and get one best side hustle match, two backups, and a practical day-by-day 7-day action plan. Free, no account needed.";
const canonical = "https://sidehustlesjob.com/quiz";
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
>
  <!-- Minimal quiz header — no distraction -->
  <section class="pt-20 sm:pt-24 pb-0 bg-white border-b border-slate-200" aria-labelledby="quiz-page-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="inline-flex items-center h-7 px-3 rounded-full border border-emerald-200 bg-emerald-50 text-[11px] font-bold text-emerald-700 mb-5 tracking-wide uppercase">
          Side hustle finder
        </p>
        <h1
          id="quiz-page-heading"
          class="text-3xl sm:text-5xl font-bold text-slate-950 tracking-tight leading-tight mb-3 text-balance"
        >
          Find the hustle you can start this week.
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-7 max-w-lg">
          7 questions about your skills, time, and budget. You get one clear answer plus a day-by-day plan.
        </p>
      </div>
    </div>
  </section>

  <!-- The quiz itself -->
  <HustleFinder hideHeading />
</Layout>
