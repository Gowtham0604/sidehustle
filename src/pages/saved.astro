---
import Layout from "../layouts/Layout.astro";
import { jobs } from "../utils/jobs";
---

<Layout title="Saved Part-time Jobs | SideHustlesJob" description="Your saved Bengaluru part-time jobs, stored locally in this browser." canonical="https://sidehustlesjob.com/saved">
  <section class="border-b border-slate-200 bg-[#f6f7f3] pt-28 pb-12 sm:pt-36"><div class="container-page"><p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">Your shortlist</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Saved jobs.</h1><p class="mt-3 text-sm text-slate-600">Saved locally in this browser. No account needed.</p></div></section>
  <section class="bg-white py-10 sm:py-14"><div class="container-page"><div id="saved-list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3"></div><div id="saved-empty" class="rounded-lg border border-dashed border-slate-300 bg-[#f6f7f3] px-6 py-14 text-center"><p class="font-bold text-slate-950">No saved jobs yet.</p><p class="mt-2 text-sm text-slate-500">Save a listing from the jobs page and it will appear here.</p><a href="/jobs" class="mt-5 inline-flex h-10 items-center rounded-lg bg-slate-950 px-4 text-sm font-bold text-white hover:bg-emerald-700">Find jobs</a></div></div></section>
</Layout>

<script>
  import jobsData from "../data/part-time-jobs.json";
  const list = document.querySelector<HTMLElement>("#saved-list");
  const empty = document.querySelector<HTMLElement>("#saved-empty");
  const render = () => { const saved=JSON.parse(localStorage.getItem("shj_saved_jobs") || "[]") as string[]; const matches=jobsData.filter((job)=>saved.includes(job.slug)); if(list)list.innerHTML=matches.map((job)=>`<article class="rounded-lg border border-slate-200 bg-white p-5"><p class="text-xs font-semibold text-slate-500">${job.company}</p><h2 class="mt-1 font-bold text-slate-950">${job.title}</h2><p class="mt-3 text-sm text-slate-600">&#128205; ${job.area} · ${job.salary}</p><div class="mt-4 flex items-center justify-between"><a href="/jobs/${job.slug}" class="text-sm font-bold text-emerald-700">View job &#8594;</a><button class="remove-saved text-xs font-bold text-slate-500" data-slug="${job.slug}" type="button">Remove</button></div></article>`).join(""); empty?.classList.toggle("hidden",matches.length>0); };
  list?.addEventListener("click",(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>(".remove-saved");if(!button)return;const saved=JSON.parse(localStorage.getItem("shj_saved_jobs") || "[]") as string[];localStorage.setItem("shj_saved_jobs",JSON.stringify(saved.filter((slug)=>slug!==button.dataset.slug)));render();}); render();
</script>
