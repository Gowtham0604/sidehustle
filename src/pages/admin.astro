---
import Layout from "../layouts/Layout.astro";
import { jobs } from "../utils/jobs";
---

<Layout title="Admin Review | SideHustlesJob" description="Review submitted part-time job leads." canonical="https://sidehustlesjob.com/admin">
  <section class="border-b border-slate-200 bg-[#f6f7f3] pt-28 pb-10 sm:pt-36"><div class="container-page"><p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">Owner tools</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Listing review.</h1><p class="mt-3 text-sm text-slate-600">Static MVP review queue. Public listings are curated in the repository; new submissions remain pending here.</p></div></section>
  <section class="bg-white py-8 sm:py-12"><div class="container-page"><div class="grid gap-3 sm:grid-cols-4"><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Total jobs</p><p class="mt-1 text-2xl font-bold text-slate-950">{jobs.length}</p></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Pending review</p><p id="pending-count" class="mt-1 text-2xl font-bold text-amber-600">0</p></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Approved</p><p class="mt-1 text-2xl font-bold text-emerald-600">{jobs.length}</p></div><div class="rounded-lg border border-slate-200 p-4"><p class="text-xs text-slate-500">Rejected</p><p id="rejected-count" class="mt-1 text-2xl font-bold text-slate-600">0</p></div></div><div class="mt-8"><div class="flex items-end justify-between"><div><h2 class="text-xl font-bold text-slate-950">Pending submissions</h2><p class="mt-1 text-sm text-slate-500">Approve only after checking the employer and application link.</p></div></div><div id="pending-list" class="mt-5 space-y-3"></div><p id="admin-empty" class="rounded-lg border border-dashed border-slate-300 bg-[#f6f7f3] px-5 py-10 text-center text-sm text-slate-500">No pending submissions in this browser.</p></div></div></section>
</Layout>

<script>
  const list=document.querySelector<HTMLElement>("#pending-list"); const empty=document.querySelector<HTMLElement>("#admin-empty"); const pendingCount=document.querySelector<HTMLElement>("#pending-count"); const rejectedCount=document.querySelector<HTMLElement>("#rejected-count");
  const render=()=>{const submissions=JSON.parse(localStorage.getItem("shj_pending_submissions") || "[]") as Record<string,string>[];const pending=submissions.filter((item)=>item.status==="pending");const rejected=submissions.filter((item)=>item.status==="rejected");if(pendingCount)pendingCount.textContent=String(pending.length);if(rejectedCount)rejectedCount.textContent=String(rejected.length);if(empty)empty.classList.toggle("hidden",pending.length>0);if(list)list.innerHTML=pending.map((item,index)=>`<article class="rounded-lg border border-slate-200 p-5"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start"><div><p class="text-xs font-semibold text-slate-500">${item.company} · ${item.area}</p><h3 class="mt-1 font-bold text-slate-950">${item.title}</h3><p class="mt-2 max-w-2xl text-sm text-slate-600">${item.description}</p><p class="mt-3 text-xs text-slate-500">Submitted by ${item.submitterName} · ${item.submitterEmail}</p></div><div class="flex shrink-0 gap-2"><button data-action="approve" data-index="${index}" class="rounded-md bg-emerald-600 px-3 py-2 text-xs font-bold text-white" type="button">Approve</button><button data-action="reject" data-index="${index}" class="rounded-md border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700" type="button">Reject</button></div></div></article>`).join("");}; list?.addEventListener("click",(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>("button[data-action]");if(!button)return;const submissions=JSON.parse(localStorage.getItem("shj_pending_submissions") || "[]") as Record<string,string>[];const pendingIndexes=submissions.map((item,index)=>({item,index})).filter(({item})=>item.status==="pending");const target=pendingIndexes[Number(button.dataset.index)];if(target){submissions[target.index].status=button.dataset.action === "approve" ? "approved" : "rejected";localStorage.setItem("shj_pending_submissions",JSON.stringify(submissions));render();}}); render();
</script>
