---
import Layout from "../layouts/Layout.astro";
import { jobs, getAreas, getCategories } from "../utils/jobs";
const areas = getAreas();
const categories = getCategories();
---

<Layout title="Part-time Jobs Near You in Bengaluru | SideHustlesJob" description="Search and filter curated part-time jobs across Bengaluru by area, category, schedule, and distance." canonical="https://sidehustlesjob.com/jobs">
  <section class="border-b border-slate-200 bg-white pt-24 pb-5 sm:pt-28"><div class="container-page"><div class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end"><div><p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">Bengaluru job map</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Find work closer to home.</h1><p class="mt-2 text-sm text-slate-600">Search by neighborhood, schedule, or job type. Apply directly from each listing.</p></div><a href="/submit-job" class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-bold text-slate-950 hover:border-emerald-500 hover:text-emerald-700">Post a part-time job</a></div>
    <form id="job-filters" class="mt-7 grid gap-3 md:grid-cols-[minmax(0,1fr)_180px_180px_auto]" role="search"><label class="sr-only" for="jobs-query">Search jobs, companies or areas</label><input id="jobs-query" name="q" class="h-11 rounded-lg border border-slate-300 px-3 text-sm placeholder:text-slate-400" placeholder="Search jobs, companies or areas" /><select id="jobs-area" name="area" class="h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700"><option value="">All Bengaluru areas</option>{areas.map((area) => <option value={area}>{area}</option>)}</select><select id="jobs-category" name="category" class="h-11 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700"><option value="">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select><button class="h-11 rounded-lg bg-slate-950 px-5 text-sm font-bold text-white hover:bg-emerald-700" type="submit">Search</button></form>
    <div class="mt-3 flex flex-wrap items-center gap-3"><select id="jobs-schedule" class="h-9 rounded-md border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600"><option value="">Any schedule</option>{["Morning", "Afternoon", "Evening", "Night", "Weekend", "Flexible"].map((item) => <option value={item}>{item}</option>)}</select><select id="jobs-distance" class="h-9 rounded-md border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600"><option value="">Any distance</option><option value="1">Within 1 km</option><option value="2">Within 2 km</option><option value="5">Within 5 km</option><option value="10">Within 10 km</option></select><button id="jobs-location" class="inline-flex h-9 items-center gap-2 rounded-md border border-slate-200 px-3 text-xs font-bold text-slate-700 hover:border-emerald-500 hover:text-emerald-700" type="button">&#128205; Use my location</button><span id="jobs-status" class="text-xs text-slate-500" aria-live="polite"></span></div>
  </div></section>
  <section class="bg-[#f6f7f3] py-5 sm:py-8"><div class="container-page"><div class="mb-4 flex items-center justify-between"><p id="jobs-count" class="text-sm font-bold text-slate-950">Loading jobs...</p><div class="flex rounded-md border border-slate-200 bg-white p-1 lg:hidden"><button id="list-toggle" class="rounded px-3 py-1 text-xs font-bold text-slate-950" type="button">List</button><button id="map-toggle" class="rounded px-3 py-1 text-xs font-bold text-slate-500" type="button">Map</button></div></div><div class="grid gap-5 lg:grid-cols-[210px_minmax(0,1fr)_minmax(320px,0.85fr)]"><aside class="hidden rounded-lg border border-slate-200 bg-white p-4 lg:block"><p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Quick filters</p><div class="mt-5 space-y-4 text-sm"><label class="flex items-center gap-2"><input type="checkbox" value="Weekend" data-schedule-check /> Weekend</label><label class="flex items-center gap-2"><input type="checkbox" value="Evening" data-schedule-check /> Evening</label><label class="flex items-center gap-2"><input type="checkbox" value="No experience" data-experience-check /> No experience</label></div><div class="mt-8 border-t border-slate-100 pt-4"><p class="text-xs leading-5 text-slate-500">Listings show the hiring signal available when they were curated. Always confirm details with the employer before travelling.</p></div></aside><div id="jobs-list" class="space-y-3"></div><div id="jobs-map" class="min-h-[420px] overflow-hidden rounded-lg border border-slate-200 bg-slate-200 lg:sticky lg:top-24"></div></div><div id="jobs-empty" class="hidden rounded-lg border border-dashed border-slate-300 bg-white px-6 py-14 text-center"><p class="text-base font-bold text-slate-950">No jobs match those filters.</p><p class="mt-2 text-sm text-slate-500">Try a nearby area or clear one filter.</p><button id="jobs-clear" class="mt-5 text-sm font-bold text-emerald-700" type="button">Clear filters</button></div></div></section>
</Layout>

<script>
  import "leaflet/dist/leaflet.css";
  import L from "leaflet";
  import jobsData from "../data/part-time-jobs.json";
  const jobs = jobsData;
  const queryParams = new URLSearchParams(window.location.search);
  const query = document.querySelector<HTMLInputElement>("#jobs-query");
  const area = document.querySelector<HTMLSelectElement>("#jobs-area");
  const category = document.querySelector<HTMLSelectElement>("#jobs-category");
  const schedule = document.querySelector<HTMLSelectElement>("#jobs-schedule");
  const distance = document.querySelector<HTMLSelectElement>("#jobs-distance");
  const list = document.querySelector<HTMLElement>("#jobs-list");
  const empty = document.querySelector<HTMLElement>("#jobs-empty");
  const count = document.querySelector<HTMLElement>("#jobs-count");
  const status = document.querySelector<HTMLElement>("#jobs-status");
  let userLocation: { lat: number; lng: number } | null = queryParams.has("lat") ? { lat: Number(queryParams.get("lat")), lng: Number(queryParams.get("lng")) } : null;
  let map: L.Map | null = null;
  let markers: L.Marker[] = [];
  const saved = () => JSON.parse(localStorage.getItem("shj_saved_jobs") || "[]") as string[];
  const distanceKm = (a:number,b:number,c:number,d:number) => { const r=6371, p=Math.PI/180, x=(c-a)*p, y=(d-b)*p; const h=Math.sin(x/2)**2+Math.cos(a*p)*Math.cos(c*p)*Math.sin(y/2)**2; return r*2*Math.atan2(Math.sqrt(h),Math.sqrt(1-h)); };
  const render = () => {
    const needle = (query?.value || "").toLowerCase().trim();
    const selectedSchedules = [...document.querySelectorAll<HTMLInputElement>("[data-schedule-check]:checked")].map((el) => el.value);
    const noExperience = document.querySelector<HTMLInputElement>("[data-experience-check]")?.checked;
    const maxDistance = distance?.value ? Number(distance.value) : null;
    const filtered = jobs.map((job) => ({ job, km: userLocation ? distanceKm(userLocation.lat,userLocation.lng,job.lat,job.lng) : null })).filter(({job,km}) => (!needle || [job.title,job.company,job.area,job.category].some((value) => value.toLowerCase().includes(needle))) && (!area?.value || job.area === area.value) && (!category?.value || job.category === category.value) && (!schedule?.value || job.schedule.includes(schedule.value)) && (!selectedSchedules.length || selectedSchedules.some((value) => job.schedule.includes(value))) && (!noExperience || job.experience === "No experience") && (!maxDistance || (km !== null && km <= maxDistance))).sort((a,b) => a.km !== null && b.km !== null ? a.km-b.km : 0);
    if (count) count.textContent = `${filtered.length} ${filtered.length === 1 ? "job" : "jobs"} near Bengaluru`;
    if (list) list.innerHTML = filtered.map(({job,km}) => `<article class="job-card rounded-lg border border-slate-200 bg-white p-4 sm:p-5" data-slug="${job.slug}"><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">${job.company}</p><h2 class="mt-1 text-base font-bold text-slate-950">${job.title}</h2></div><button class="save-job rounded-md px-2 py-1 text-xs font-bold ${saved().includes(job.slug) ? "text-emerald-700" : "text-slate-400"}" data-slug="${job.slug}" type="button">${saved().includes(job.slug) ? "Saved" : "Save"}</button></div><p class="mt-3 text-sm text-slate-600">&#128205; ${job.area} ${km !== null ? `<span class="font-semibold text-emerald-700">· ${km.toFixed(1)} km</span>` : ""}</p><div class="mt-3 grid grid-cols-2 gap-2 text-xs"><div class="rounded-md bg-slate-50 p-2"><span class="block text-slate-400">Pay</span><b class="text-slate-800">${job.salary}</b><span class="block text-slate-500">${job.salaryPeriod}</span></div><div class="rounded-md bg-slate-50 p-2"><span class="block text-slate-400">Schedule</span><b class="text-slate-800">${job.schedule.slice(0,2).join(", ")}</b></div></div><div class="mt-4 flex items-center justify-between gap-3"><span class="text-[11px] font-semibold text-emerald-700">${job.hiringStatus}</span><a data-track="job_card_opened" href="/jobs/${job.slug}" class="text-sm font-bold text-slate-950 hover:text-emerald-700">View job &#8594;</a></div></article>`).join("");
    empty?.classList.toggle("hidden", filtered.length > 0);
    renderMap(filtered);
  };
  const renderMap = (filtered: {job: typeof jobs[number], km: number | null}[]) => { if (!map) { map = L.map("jobs-map", { scrollWheelZoom: false }).setView([12.9716,77.5946], 11); L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "&copy; OpenStreetMap contributors" }).addTo(map); } markers.forEach((marker) => marker.remove()); markers = filtered.map(({job}) => L.marker([job.lat,job.lng]).addTo(map!).bindPopup(`<strong>${job.title}</strong><br>${job.area}<br><a href="/jobs/${job.slug}">View job</a>`)); if (userLocation) L.circleMarker([userLocation.lat,userLocation.lng], {radius:8,color:"#059669",fillColor:"#34d399",fillOpacity:0.8}).addTo(map).bindTooltip("Your location"); };
  [query,area,category,schedule,distance].forEach((input) => input?.addEventListener("input", render));
  document.querySelectorAll<HTMLInputElement>("[data-schedule-check],[data-experience-check]").forEach((input) => input.addEventListener("change", render));
  document.querySelector("#job-filters")?.addEventListener("submit", (event) => { event.preventDefault(); render(); const params = new URLSearchParams(); if (query?.value) params.set("q",query.value); if (area?.value) params.set("area",area.value); if (category?.value) params.set("category",category.value); history.replaceState({},"",`/jobs?${params}`); });
  const mapElement = document.querySelector<HTMLElement>("#jobs-map");
  const listToggle = document.querySelector<HTMLButtonElement>("#list-toggle");
  const mapToggle = document.querySelector<HTMLButtonElement>("#map-toggle");
  const setMobileView = (view: "list" | "map") => { if (window.innerWidth >= 1024) return; list?.classList.toggle("hidden", view === "map"); mapElement?.classList.toggle("hidden", view === "list"); listToggle?.classList.toggle("bg-slate-100", view === "list"); mapToggle?.classList.toggle("bg-slate-100", view === "map"); };
  listToggle?.addEventListener("click", () => setMobileView("list"));
  mapToggle?.addEventListener("click", () => setMobileView("map"));
  setMobileView("list");
  document.querySelector("#jobs-clear")?.addEventListener("click", () => { if(query)query.value=""; if(area)area.value=""; if(category)category.value=""; if(schedule)schedule.value=""; if(distance)distance.value=""; document.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((input)=>input.checked=false); render(); });
  document.querySelector("#jobs-location")?.addEventListener("click", () => { if (!navigator.geolocation) { if(status)status.textContent="Location is unavailable."; return; } if(status)status.textContent="Finding nearby jobs..."; navigator.geolocation.getCurrentPosition((position) => { userLocation={lat:position.coords.latitude,lng:position.coords.longitude}; if(status)status.textContent="Sorted by distance from you."; render(); }, () => { if(status)status.textContent="Could not access location. Search by area instead."; }); });
  list?.addEventListener("click", (event) => { const button=(event.target as HTMLElement).closest<HTMLButtonElement>(".save-job"); if(!button)return; const items=saved(); const next=items.includes(button.dataset.slug!) ? items.filter((slug)=>slug!==button.dataset.slug) : [...items,button.dataset.slug!]; localStorage.setItem("shj_saved_jobs",JSON.stringify(next)); window.dispatchEvent(new CustomEvent("shj:track",{detail:{event:next.includes(button.dataset.slug!) ? "job_saved" : "job_unsaved",payload:{slug:button.dataset.slug}}})); render(); });
  if(query)query.value=queryParams.get("q") || ""; if(area)area.value=queryParams.get("area") || ""; if(category)category.value=queryParams.get("category") || ""; render();
</script>
