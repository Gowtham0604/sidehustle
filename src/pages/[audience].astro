---
/**
 * Handles both audience pages (e.g. /side-hustles-for-students)
 * and constraint pages (e.g. /side-hustles-with-no-money, /high-income-side-hustles)
 */
import Layout from "../layouts/Layout.astro";
import HustleCard from "../components/HustleCard.astro";
import Search from "../components/Search.astro";
import type { SideHustle } from "../types/side-hustle";
import {
  AUDIENCE_PAGES,
  CONSTRAINT_PAGES,
  audienceFilter,
  constraintFilter,
} from "../utils/audience";
import hustleData from "../data/side-hustles.json";

export async function getStaticPaths() {
  const pages = [
    ...AUDIENCE_PAGES.map((p) => ({ params: { audience: p.slug }, props: { slug: p.slug } })),
    ...CONSTRAINT_PAGES.map((p) => ({ params: { audience: p.slug }, props: { slug: p.slug } })),
  ];
  return pages;
}

const { slug } = Astro.props;
const audienceMeta = AUDIENCE_PAGES.find((p) => p.slug === slug);
const constraintMeta = CONSTRAINT_PAGES.find((p) => p.slug === slug);

if (!audienceMeta && !constraintMeta) {
  return Astro.redirect("/404");
}

const type = audienceMeta ? "audience" : "constraint";
const meta = (audienceMeta ?? constraintMeta)!;

const all = hustleData as SideHustle[];
const filterFn =
  type === "audience"
    ? audienceFilter(meta.slug)
    : constraintFilter(meta.slug);

const hustles = all.filter(filterFn);
const canonical = `https://sidehustlesjob.com/${meta.slug}`;

// Related audience or constraint pages for internal linking
const relatedPages = type === "audience"
  ? AUDIENCE_PAGES.filter((p) => p.slug !== meta.slug).slice(0, 6)
  : CONSTRAINT_PAGES.filter((p) => p.slug !== meta.slug).slice(0, 6);

// Categories present in results
const categories = [...new Set(hustles.map((h) => h.category))].slice(0, 5);

// JSON-LD
const pageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonical,
      "url": canonical,
      "name": `${meta.title} | SideHustlesJob`,
      "description": meta.metaDescription,
      "isPartOf": { "@id": "https://sidehustlesjob.com/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sidehustlesjob.com" },
          { "@type": "ListItem", "position": 2, "name": meta.title, "item": canonical },
        ],
      },
    },
    {
      "@type": "ItemList",
      "name": meta.title,
      "numberOfItems": hustles.length,
      "itemListElement": hustles.slice(0, 10).map((h, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://sidehustlesjob.com/side-hustle/${h.slug}`,
        "name": h.name,
      })),
    },
  ],
});
---

<Layout
  title={`${meta.title} | SideHustlesJob`}
  description={meta.metaDescription}
  canonical={canonical}
  jsonLd={pageJsonLd}
>
  <!-- Breadcrumb -->
  <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]" role="list">
        <li><a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-[var(--color-body)]">{meta.title}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-12 pb-14 sm:pt-16 sm:pb-20 bg-white border-b border-slate-200" aria-labelledby="page-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3 sm:mb-4">
          {type === "audience" ? "By audience" : "By situation"}
        </p>
        <h1
          id="page-heading"
          class="text-2xl sm:text-4xl md:text-5xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-2px] leading-[1.1] mb-3 sm:mb-4 text-balance"
        >
          {meta.headline}
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-body)] leading-7 mb-6 sm:mb-8">
          {meta.description}
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-canvas)]/80 border border-[var(--color-hairline)] text-xs font-medium text-[var(--color-body)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]" aria-hidden="true"></span>
            {hustles.length} {hustles.length === 1 ? "result" : "results"}
          </span>
          <a
            href="/quiz"
            class="text-xs sm:text-sm text-[var(--color-link)] hover:text-[var(--color-link-deep)] transition-colors"
          >
            Take the quiz instead →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)]" aria-label="Side hustle listings">
    <div class="container-page">
      <!-- Search -->
      {hustles.length > 6 && (
        <div class="mb-8">
          <Search />
        </div>
      )}

      {hustles.length === 0 ? (
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <p class="text-4xl mb-4" aria-hidden="true">🔍</p>
          <h2 class="text-xl font-semibold text-[var(--color-ink)] mb-2">No matches found.</h2>
          <p class="text-sm text-[var(--color-body)] mb-6">Try browsing all side hustles or taking the quiz.</p>
          <a
            href="/"
            class="inline-flex items-center h-10 px-5 text-sm font-medium text-[var(--color-on-primary)] bg-[var(--color-ink)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity duration-150"
          >
            Back to home
          </a>
        </div>
      ) : (
        <!-- Grid -->
        <div
          id="hustles-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5"
          role="list"
          aria-label="Side hustle cards"
        >
          {hustles.map((hustle) => (
            <div data-slug={hustle.slug} data-cat={hustle.category} role="listitem">
              <HustleCard hustle={hustle} />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA band -->
  <section class="py-16 bg-[var(--color-ink)]" aria-label="Quiz call to action">
    <div class="container-page text-center">
      <p class="text-xs font-mono text-[var(--color-on-primary)]/50 uppercase tracking-wider mb-4">Personalised results</p>
      <h2 class="text-3xl font-semibold text-[var(--color-on-primary)] tracking-[-1.28px] mb-4 text-balance">
        Get matched in 2 minutes.
      </h2>
      <p class="text-[var(--color-on-primary)]/70 mb-8 max-w-md mx-auto">
        Answer 7 questions about your skills, schedule, and goals — we'll show you the best matches.
      </p>
      <a
        href="/quiz"
        class="inline-flex items-center h-12 px-6 text-base font-medium text-[var(--color-ink)] bg-[var(--color-on-primary)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity duration-150"
      >
        Find my side hustle →
      </a>
    </div>
  </section>

  <!-- Internal linking: categories -->
  {categories.length > 0 && (
    <section class="py-10 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)]" aria-labelledby="browse-cats-heading">
      <div class="container-page">
        <h2 id="browse-cats-heading" class="text-sm font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">Browse by category</h2>
        <div class="flex flex-wrap gap-2">
          {categories.map((cat) => (
            <a
              href={`/category/${cat.toLowerCase().replace(/\s+/g, "-")}`}
              class="px-3 py-1.5 text-xs font-medium text-[var(--color-body)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-full hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition-colors"
            >
              {cat}
            </a>
          ))}
          <a
            href="/browse"
            class="px-3 py-1.5 text-xs font-semibold text-[var(--color-violet)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-full hover:bg-[var(--color-violet)] hover:text-white hover:border-[var(--color-violet)] transition-colors"
          >
            All categories →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Internal linking: related pages -->
  <section class="py-10 bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)]" aria-labelledby="related-pages-heading">
    <div class="container-page">
      <h2 id="related-pages-heading" class="text-sm font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">
        {type === "audience" ? "More audience guides" : "More situation guides"}
      </h2>
      <div class="flex flex-wrap gap-2">
        {relatedPages.map((p) => (
          <a
            href={`/${p.slug}`}
            class="px-3 py-1.5 text-xs font-medium text-[var(--color-body)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-full hover:border-[var(--color-ink)] hover:text-[var(--color-ink)] transition-colors card-shadow"
          >
            {p.title.replace("Best Side Hustles for ", "").replace("Side Hustles ", "").replace("Side Hustles", "All")}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
