---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | SideHustlesJob"
  description="The page you're looking for doesn't exist. Find your perfect side hustle on SideHustlesJob."
  canonical="https://sidehustlesjob.com/404"
>
  <div class="relative min-h-screen flex flex-col overflow-hidden bg-white">

    <!-- ── Ambient background ─────────────────────────────────────────────── -->
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
      <!-- subtle grid overlay -->
      <div
        class="absolute inset-0 opacity-[0.025]"
        style="background-image: linear-gradient(var(--color-ink) 1px, transparent 1px), linear-gradient(90deg, var(--color-ink) 1px, transparent 1px); background-size: 60px 60px;"
      ></div>
    </div>

    <!-- ── Main content ────────────────────────────────────────────────────── -->
    <main class="relative z-10 flex-1 flex items-center justify-center px-6 pt-32 pb-20">
      <div class="w-full max-w-3xl mx-auto text-center">

        <!-- Giant ghost 404 behind heading -->
        <div class="relative mb-6 select-none" aria-hidden="true">
          <span
            class="block text-[clamp(8rem,28vw,18rem)] font-black leading-none tracking-tighter text-slate-100"
          >404</span>
        </div>

        <!-- Floating pill badge — sits over the ghost number -->
        <div class="flex justify-center -mt-8 mb-8">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-slate-200 bg-slate-50 text-xs font-bold text-slate-600 uppercase tracking-widest shadow-sm font-mono">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><circle cx="5" cy="5" r="5"/></svg>
            Page not found
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-[-0.03em] leading-[1.1] mb-6 text-balance">
          You took a wrong<br class="hidden sm:block" />
          turn.
        </h1>

        <!-- Sub copy -->
        <p class="text-lg md:text-xl text-slate-500 leading-relaxed mb-12 max-w-xl mx-auto text-balance font-medium">
          This page doesn't exist — but hundreds of real side hustle opportunities do.
          Let's get you back on track.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
          <a
            href="/"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 h-14 px-8 text-base font-bold text-white rounded-full transition-all duration-300 shadow-[0_8px_32px_rgba(217,70,168,0.35)] hover:shadow-[0_12px_40px_rgba(217,70,168,0.5)] hover:-translate-y-1"
            style="background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end))"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">
              <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to home
          </a>
          <a
            href="/browse"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 h-14 px-8 text-base font-bold text-slate-800 bg-white rounded-full border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-1"
          >
            Browse all hustles
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
              <path d="M3.5 8h9M9 4.5l3.5 3.5L9 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <!-- Divider -->
        <div class="relative mb-12">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-slate-200"></div>
          </div>
          <div class="relative flex justify-center">
            <span class="bg-white px-4 text-sm font-semibold text-slate-400 uppercase tracking-widest">
              Or jump to
            </span>
          </div>
        </div>

        <!-- Quick-link cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {[
            { href: "/", icon: "🏠", label: "Home", desc: "Start here" },
            { href: "/browse", icon: "🔍", label: "Browse", desc: "All 150+ hustles" },
            { href: "/how-it-works", icon: "⚡", label: "How It Works", desc: "Quick overview" },
            { href: "/about", icon: "👋", label: "About", desc: "Our story" },
          ].map(({ href, icon, label, desc }) => (
            <a
              href={href}
              class="group flex flex-col items-center gap-2 p-5 rounded-2xl border border-slate-200 bg-white hover:border-transparent hover:bg-slate-900 transition-all duration-300 shadow-sm hover:shadow-[0_8px_32px_rgba(0,0,0,0.12)] hover:-translate-y-1"
            >
              <span class="text-2xl leading-none">{icon}</span>
              <span class="text-sm font-bold text-slate-800 group-hover:text-white transition-colors">{label}</span>
              <span class="text-xs text-slate-400 group-hover:text-slate-400 transition-colors">{desc}</span>
            </a>
          ))}
        </div>

      </div>
    </main>
  </div>
</Layout>
