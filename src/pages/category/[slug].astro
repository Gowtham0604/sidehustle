---
import Layout from "../../layouts/Layout.astro";
import HustleCard from "../../components/HustleCard.astro";
import type { SideHustle } from "../../types/side-hustle";
import { AUDIENCE_PAGES, CONSTRAINT_PAGES } from "../../utils/audience";
import hustleData from "../../data/side-hustles.json";

export async function getStaticPaths() {
  const all = hustleData as SideHustle[];
  const categories = [...new Set(all.map((h) => h.category))];
  return categories.map((cat) => ({
    params: { slug: cat.toLowerCase().replace(/\s+/g, "-") },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const all = hustleData as SideHustle[];
const hustles = all.filter((h) => h.category === category);
const categorySlug = category.toLowerCase().replace(/\s+/g, "-");
const canonical = `https://sidehustlesjob.com/category/${categorySlug}`;

// Related categories (other categories with overlapping tags)
const allCats = [...new Set(all.map((h) => h.category))].filter((c) => c !== category);
const relatedCats = allCats.slice(0, 6);

// JSON-LD
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonical,
      "url": canonical,
      "name": `${category} Side Hustles | SideHustlesJob`,
      "description": `Browse ${hustles.length} ${category} side hustles with real income data, startup costs, and step-by-step guides.`,
      "isPartOf": { "@id": "https://sidehustlesjob.com/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sidehustlesjob.com" },
          { "@type": "ListItem", "position": 2, "name": "Browse", "item": "https://sidehustlesjob.com/browse" },
          { "@type": "ListItem", "position": 3, "name": category, "item": canonical },
        ],
      },
    },
    {
      "@type": "ItemList",
      "name": `${category} Side Hustles`,
      "numberOfItems": hustles.length,
      "itemListElement": hustles.slice(0, 10).map((h, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://sidehustlesjob.com/side-hustle/${h.slug}`,
        "name": h.name,
      })),
    },
  ],
});

// Stats
const freeToStart = hustles.filter((h) => h.startupCost === "$0").length;
const remote = hustles.filter((h) => h.remote).length;
const beginner = hustles.filter((h) => h.beginnerFriendly).length;
---

<Layout
  title={`${category} Side Hustles (${hustles.length} Ideas) | SideHustlesJob`}
  description={`Browse ${hustles.length} ${category} side hustles with real income data, startup costs, and step-by-step guides to get started today.`}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]" aria-label="Breadcrumb">
    <div class="container-page py-3">
      <ol class="flex items-center gap-1.5 text-xs text-[var(--color-mute)]" role="list">
        <li><a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/browse" class="hover:text-[var(--color-body)] transition-colors">Browse</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-[var(--color-body)]">{category}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-12 pb-14 sm:pt-16 sm:pb-20 bg-white border-b border-slate-200" aria-labelledby="cat-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-3">Category</p>
        <h1 id="cat-heading" class="text-2xl sm:text-4xl md:text-5xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] sm:tracking-[-2px] leading-[1.1] mb-4 text-balance">
          {category} side hustles.
        </h1>
        <p class="text-sm sm:text-base text-[var(--color-body)] leading-7 mb-6">
          Browse {hustles.length} {category.toLowerCase()} side hustles — with real income data, startup costs, difficulty levels, and everything you need to pick the right one.
        </p>
        <!-- Quick stats -->
        <dl class="flex flex-wrap gap-4 text-xs">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[var(--color-success)]" aria-hidden="true"></span>
            <dt class="text-[var(--color-mute)]">Total:</dt>
            <dd class="font-semibold text-[var(--color-ink)]">{hustles.length}</dd>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[var(--color-violet)]" aria-hidden="true"></span>
            <dt class="text-[var(--color-mute)]">Free to start:</dt>
            <dd class="font-semibold text-[var(--color-ink)]">{freeToStart}</dd>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[var(--color-link)]" aria-hidden="true"></span>
            <dt class="text-[var(--color-mute)]">Remote:</dt>
            <dd class="font-semibold text-[var(--color-ink)]">{remote}</dd>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[var(--color-warning)]" aria-hidden="true"></span>
            <dt class="text-[var(--color-mute)]">Beginner-friendly:</dt>
            <dd class="font-semibold text-[var(--color-ink)]">{beginner}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-12 sm:py-16 bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)]" aria-label="Side hustle listings">
    <div class="container-page">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5" role="list">
        {hustles.map((hustle) => (
          <div role="listitem">
            <HustleCard hustle={hustle} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related categories internal linking -->
  <section class="py-12 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)]" aria-labelledby="related-cats-heading">
    <div class="container-page">
      <h2 id="related-cats-heading" class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-6">
        Browse other categories.
      </h2>
      <div class="flex flex-wrap gap-2">
        {relatedCats.map((cat) => (
          <a
            href={`/category/${cat.toLowerCase().replace(/\s+/g, "-")}`}
            class="px-3 py-1.5 text-sm text-[var(--color-body)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-ink)] hover:text-[var(--color-on-primary)] hover:border-[var(--color-ink)] transition-all duration-200"
          >
            {cat}
          </a>
        ))}
        <a
          href="/browse"
          class="px-3 py-1.5 text-sm font-semibold text-[var(--color-violet)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:bg-[var(--color-violet)] hover:text-white hover:border-[var(--color-violet)] transition-all duration-200"
        >
          View all →
        </a>
      </div>
    </div>
  </section>

  <!-- Audience links -->
  <section class="py-12 bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)]" aria-labelledby="audience-links-heading">
    <div class="container-page">
      <h2 id="audience-links-heading" class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-2">
        Find hustles for your situation.
      </h2>
      <p class="text-sm text-[var(--color-body)] mb-5">Browse {category.toLowerCase()} opportunities filtered by who you are.</p>
      <div class="flex flex-wrap gap-2">
        {AUDIENCE_PAGES.slice(0, 8).map((p) => (
          <a
            href={`/${p.slug}`}
            class="px-3 py-1.5 text-xs font-medium text-[var(--color-body)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-pill)] hover:border-[var(--color-violet)] hover:text-[var(--color-violet)] transition-colors duration-200 card-shadow"
          >
            {p.title.replace("Best Side Hustles for ", "For ")}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-[var(--color-ink)]" aria-label="Quiz call to action">
    <div class="container-page text-center">
      <p class="text-xs font-mono text-[var(--color-on-primary)]/50 uppercase tracking-wider mb-4">Personalised results</p>
      <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--color-on-primary)] tracking-[-1.28px] mb-4">
        Not sure which one fits you?
      </h2>
      <p class="text-[var(--color-on-primary)]/70 mb-6 max-w-md mx-auto text-sm">
        Answer 7 questions about your skills, schedule, and goals — get ranked matches in 90 seconds.
      </p>
      <a href="/quiz" class="inline-flex items-center h-12 px-6 text-sm font-medium text-[var(--color-ink)] bg-[var(--color-on-primary)] rounded-[var(--radius-pill)] hover:opacity-90 transition-opacity">
        Find my match →
      </a>
    </div>
  </section>
</Layout>
