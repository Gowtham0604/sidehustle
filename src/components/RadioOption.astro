---
interface Props {
  name: string;
  value: string;
  label: string;
  desc: string;
  compact?: boolean;
}

const { name, value, label, desc, compact = false } = Astro.props;
---

<label
  class:list={[
    "group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white transition-all duration-150 hover:border-slate-300 hover:bg-slate-50 hover:shadow-sm has-[:checked]:border-[var(--color-violet)] has-[:checked]:bg-[var(--color-link-bg-soft)] has-[:checked]:shadow-sm active:scale-[0.99]",
    compact ? "min-h-24 p-4" : "min-h-20 p-4",
  ]}
>
  <input type="radio" name={name} value={value} class="sr-only" />
  <span class="flex-1">
    <span class="block text-base font-bold text-slate-950">{label}</span>
    <span class="mt-0.5 block text-sm leading-5 text-slate-500">{desc}</span>
  </span>
  <!-- Custom radio indicator -->
  <span
    class="h-5 w-5 shrink-0 rounded-full border-2 border-slate-300 bg-white transition-all duration-150 group-has-[:checked]:border-[var(--color-violet)] group-has-[:checked]:bg-[var(--color-violet)]"
    aria-hidden="true"
  >
    <!-- Inner check dot -->
    <span class="block h-full w-full rounded-full scale-0 group-has-[:checked]:scale-50 transition-transform duration-150 bg-white" aria-hidden="true"></span>
  </span>
</label>
