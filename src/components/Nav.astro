---
const { pathname } = Astro.url;
const isQuiz = pathname.startsWith("/quiz");
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-sm" id="navbar">
  <div class="container-page flex h-14 items-center justify-between sm:h-16">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-950" aria-label="SideHustlesJob home">
      <img src="/favicon-96x96.png" alt="" width="28" height="28" loading="eager" fetchpriority="high" class="h-7 w-7 rounded-md" />
      <span class="text-sm sm:text-base font-bold tracking-tight text-slate-950">SideHustlesJob</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      <a href="/how-it-works" class="h-8 inline-flex items-center px-3 rounded-md text-sm text-slate-600 hover:text-slate-950 hover:bg-slate-50 transition-colors">
        How it works
      </a>
      <a href="/browse" class="h-8 inline-flex items-center px-3 rounded-md text-sm text-slate-600 hover:text-slate-950 hover:bg-slate-50 transition-colors">
        Browse
      </a>
      <a href="/saved" class="h-8 inline-flex items-center px-3 rounded-md text-sm text-slate-600 hover:text-slate-950 hover:bg-slate-50 transition-colors">
        Saved
      </a>
    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-2">
      <a
        href="/quiz"
        data-track="nav_start_quiz"
        class:list={[
          "inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-bold transition-colors",
          isQuiz
            ? "bg-emerald-600 text-white hover:bg-emerald-700"
            : "bg-slate-950 text-white hover:bg-slate-800",
        ]}
      >
        <span class="hidden sm:inline">Find my match</span>
        <span class="sm:hidden">Quiz</span>
      </a>
    </div>

  </div>
</header>
