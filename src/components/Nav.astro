---
// Navigation component with glassmorphism
const { pathname } = Astro.url;
const isHowItWorks = pathname === "/how-it-works" || pathname === "/how-it-works/";
const isBrowse = pathname === "/browse" || pathname === "/browse/";
const isHome = pathname === "/" || pathname === "";
const browseHref = "/browse";
const finderHref = isHome ? "#finder" : "/#finder";
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <div class="absolute inset-0 bg-white/80 backdrop-blur-xl border-b border-[var(--color-hairline)] shadow-[0_4px_30px_rgba(0,0,0,0.05)] transition-all duration-300"></div>
  
  <div class="container-page relative z-10 flex items-center justify-between h-20">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-violet)] rounded-lg" aria-label="SideHustlesJob home">
      <img src="/favicon-96x96.png" alt="" width="32" height="32" class="w-8 h-8 rounded-[var(--radius-xs)]" />
      <span class="text-xl font-bold tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-violet)] transition-colors duration-300">
        SideHustles<span class="text-[var(--color-violet)]">Job</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {isBrowse ? (
        <a href="/" class="text-sm font-semibold text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-300 px-3 py-2 rounded-md hover:bg-slate-100/50">
          Home
        </a>
      ) : (
        <a href={browseHref} class="text-sm font-semibold text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-300 px-3 py-2 rounded-md hover:bg-slate-100/50">
          Browse Hustles
        </a>
      )}
      {isHowItWorks ? (
        <a href="/" class="text-sm font-semibold text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-300 px-3 py-2 rounded-md hover:bg-slate-100/50">
          Home
        </a>
      ) : (
        <a href="/how-it-works" class="text-sm font-semibold text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-300 px-3 py-2 rounded-md hover:bg-slate-100/50">
          How it Works
        </a>
      )}
      <a href={finderHref} class="relative inline-flex items-center justify-center h-10 px-6 overflow-hidden font-bold text-white bg-gradient-to-r from-[var(--color-violet)] to-[var(--color-cyan)] rounded-full transition-all duration-300 hover:opacity-90 shadow-[0_0_20px_rgba(217,70,168,0.25)] hover:shadow-[0_0_30px_rgba(217,70,168,0.4)] transform hover:-translate-y-0.5">
        <span class="relative z-10">Get Started</span>
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn"
      class="md:hidden flex flex-col justify-center gap-1.5 w-10 h-10 rounded-full bg-slate-100/50 border border-[var(--color-hairline)] items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-cyan)] hover:bg-slate-200/50 transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="w-5 h-0.5 bg-[var(--color-ink)] transition-all duration-300 origin-center" aria-hidden="true"></span>
      <span class="w-5 h-0.5 bg-[var(--color-ink)] transition-all duration-300 origin-center" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div 
    id="mobile-menu"
    class="absolute top-full left-0 right-0 bg-white/95 backdrop-blur-2xl border-b border-[var(--color-hairline)] overflow-hidden transition-all duration-300 origin-top scale-y-0 opacity-0 invisible"
  >
    <nav class="container-page py-6 flex flex-col gap-4">
      {isBrowse ? (
        <a href="/" class="text-lg font-semibold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors duration-300 px-4 py-3 rounded-xl hover:bg-pink-50">
          Home
        </a>
      ) : (
        <a href={browseHref} class="text-lg font-semibold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors duration-300 px-4 py-3 rounded-xl hover:bg-pink-50">
          Browse Hustles
        </a>
      )}
      {isHowItWorks ? (
        <a href="/" class="text-lg font-semibold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors duration-300 px-4 py-3 rounded-xl hover:bg-pink-50">
          Home
        </a>
      ) : (
        <a href="/how-it-works" class="text-lg font-semibold text-[var(--color-ink)] hover:text-[var(--color-violet)] transition-colors duration-300 px-4 py-3 rounded-xl hover:bg-pink-50">
          How it Works
        </a>
      )}
      <div class="h-px w-full bg-slate-200 my-2"></div>
      <a href={finderHref} class="flex items-center justify-center h-12 w-full font-bold text-white bg-gradient-to-r from-[var(--color-violet)] to-[var(--color-cyan)] rounded-xl shadow-lg">
        Get Started
      </a>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const navbar = document.getElementById('navbar');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const spans = btn?.querySelectorAll('span');
    
    // Smooth scroll shadow
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        navbar?.querySelector('div')?.classList.add('shadow-md');
      } else {
        navbar?.querySelector('div')?.classList.remove('shadow-md');
      }
    }, { passive: true });

    // Mobile menu toggle
    let isOpen = false;
    btn?.addEventListener('click', () => {
      isOpen = !isOpen;
      btn.setAttribute('aria-expanded', isOpen.toString());
      
      if (isOpen) {
        menu?.classList.remove('scale-y-0', 'opacity-0', 'invisible');
        menu?.classList.add('scale-y-100', 'opacity-100', 'visible');
        if (spans && spans.length === 2) {
          spans[0].style.transform = 'translateY(4px) rotate(45deg)';
          spans[1].style.transform = 'translateY(-4px) rotate(-45deg)';
        }
      } else {
        menu?.classList.add('scale-y-0', 'opacity-0', 'invisible');
        menu?.classList.remove('scale-y-100', 'opacity-100', 'visible');
        if (spans && spans.length === 2) {
          spans[0].style.transform = 'none';
          spans[1].style.transform = 'none';
        }
      }
    });

    // Close menu on link click
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) btn?.click();
      });
    });
  }

  // Handle Astro page transitions
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
