---
import type { SideHustle } from "../types/side-hustle";

interface Props {
  hustle: SideHustle;
  featured?: boolean;
}

const { hustle, featured = false } = Astro.props;
---

<article class:list={[
  "group relative flex flex-col bg-white rounded-2xl overflow-hidden transition-all duration-300 border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-2",
  featured && "shadow-md hover:shadow-2xl"
]}>
  <!-- Interactive hover sheen -->
  <div class="absolute inset-0 bg-gradient-to-b from-slate-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
  
  <a
    href={`/side-hustle/${hustle.slug}`}
    class="absolute inset-0 z-10 rounded-2xl focus-visible:ring-2 focus-visible:ring-[var(--color-violet)] focus:outline-none"
    aria-label={`View ${hustle.name} details`}
  ></a>

  <div class="p-6 flex flex-col flex-1 gap-5 relative z-20">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-[11px] font-bold text-[var(--color-violet)] uppercase tracking-wider mb-2 truncate">
          {hustle.category}
        </p>
        <h3 class="font-bold text-slate-900 tracking-tight text-balance group-hover:text-[var(--color-violet)] transition-colors duration-300 text-2xl leading-8">
          {hustle.name}
        </h3>
      </div>
      {hustle.beginnerFriendly && (
        <span class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full border text-emerald-700 bg-emerald-50 border-emerald-200">
          Beginner
        </span>
      )}
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-600 leading-relaxed line-clamp-2 flex-1 font-medium">
      {hustle.description}
    </p>

    <!-- Stats -->
    <dl class="grid grid-cols-2 gap-y-4 gap-x-3 pt-5 border-t border-slate-100 group-hover:border-slate-200 transition-colors duration-300">
      <div>
        <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Income</dt>
        <dd class="text-sm font-semibold text-slate-900 tabular-nums">{hustle.incomePotential}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Startup</dt>
        <dd class="text-sm font-semibold text-slate-900">{hustle.startupCost}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">First income</dt>
        <dd class="text-sm font-semibold text-slate-900">{hustle.timeToFirstIncome}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Work type</dt>
        <dd class="text-sm font-semibold text-slate-900">{hustle.remoteOptions ? "Remote" : "Local"}</dd>
      </div>
    </dl>
  </div>

  <!-- CTA row -->
  <div class="px-6 pb-6 relative z-20">
    <span class="inline-flex items-center gap-2 text-sm font-bold text-[var(--color-violet)] group-hover:text-[var(--color-link-deep)] transition-colors duration-300 pointer-events-none" aria-hidden="true">
      View guide
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="transform group-hover:translate-x-1 transition-transform duration-300" aria-hidden="true">
        <path d="M3.5 8h9M9 4.5l3.5 3.5L9 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</article>
