---
import QuizQuestion from "./QuizQuestion.astro";
import RadioOption from "./RadioOption.astro";

interface Props {
  hideHeading?: boolean;
}

const { hideHeading = false } = Astro.props;

const skills = [
  "Writing",
  "Design",
  "Coding",
  "Marketing",
  "Teaching",
  "Video",
  "Photography",
  "Social Media",
  "Excel/Spreadsheets",
  "Customer Service",
  "Sales",
  "Finance/Accounting",
  "Physical Labor",
  "Cooking",
  "Languages",
];
---

<section id="finder" class="py-8 sm:py-14 mesh-gradient" aria-labelledby="finder-heading">
  <div class="container-page">
    {!hideHeading && (
      <div class="max-w-2xl mx-auto text-center mb-8">
        <p class="text-xs font-bold text-slate-500 uppercase mb-2">Side hustle finder</p>
        <h2 id="finder-heading" class="text-3xl sm:text-5xl font-bold text-slate-950 tracking-normal text-balance">
          Get one clear recommendation.
        </h2>
        <p class="mt-3 text-base text-slate-600">Fast, practical, and biased toward what you can start this week.</p>
      </div>
    )}

    <div id="finder-quiz" class="mx-auto max-w-4xl rounded-lg border border-slate-200 bg-white shadow-xl shadow-slate-900/5" role="form" aria-label="Side hustle finder quiz">
      <div class="border-b border-slate-200 p-4 sm:p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p id="step-kicker" class="text-xs font-bold uppercase text-slate-500">Setup</p>
            <p id="step-title-mini" class="text-sm font-bold text-slate-950">A few constraints, then your plan.</p>
          </div>
          <p id="step-count" class="text-xs font-bold text-slate-500 tabular-nums">0 / 7</p>
        </div>
        <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100" aria-hidden="true">
          <div id="finder-progress" class="h-full w-0 rounded-full bg-[var(--color-violet)] transition-all duration-500 ease-out"></div>
        </div>
      </div>

      <div id="finder-steps" class="p-4 sm:p-8">
        <div class="finder-step" data-step="0">
          <div class="grid lg:grid-cols-[1fr_280px] gap-6 items-start">
            <div>
              <p class="text-xs font-bold uppercase text-[var(--color-violet)] mb-3">Clean start</p>
              <h3 class="text-3xl sm:text-4xl font-bold text-slate-950 leading-tight tracking-normal text-balance">
                Let's find the best option for this week.
              </h3>
              <p class="mt-4 text-base leading-7 text-slate-600">
                You will get one recommended hustle, two backups, and a practical 7-day action plan. No account, no browsing spiral.
              </p>
              <div class="mt-6 grid sm:grid-cols-3 gap-3">
                {["2 minutes", "7 questions", "1 best match"].map((item) => (
                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <p class="text-sm font-bold text-slate-950">{item}</p>
                  </div>
                ))}
              </div>
            </div>
            <aside class="rounded-lg border border-slate-200 bg-slate-950 p-5 text-white">
              <p class="text-xs font-bold uppercase text-emerald-300 mb-3">You will see</p>
              <ul class="space-y-3 text-sm text-slate-200">
                <li>Why it fits your constraints</li>
                <li>Startup cost and first-dollar timing</li>
                <li>Skill level, risk level, and exact first step</li>
                <li>A day-by-day first week plan</li>
              </ul>
            </aside>
          </div>
        </div>

        <div class="finder-step hidden" data-step="1">
          <QuizQuestion eyebrow="Question 1" title="Where can you realistically work?">
            <RadioOption name="remote" value="remote" label="Remote only" desc="I need something I can do from home." />
            <RadioOption name="remote" value="local" label="Local is fine" desc="I can drive, meet people, or work nearby." />
            <RadioOption name="remote" value="both" label="Either works" desc="Show me the strongest option." />
          </QuizQuestion>
        </div>

        <div class="finder-step hidden" data-step="2">
          <QuizQuestion eyebrow="Question 2" title="How many hours can you commit each week?">
            <div class="grid grid-cols-2 gap-3">
              <RadioOption name="hoursPerWeek" value="under5" label="Under 5" desc="Very limited" compact />
              <RadioOption name="hoursPerWeek" value="5to10" label="5-10" desc="Nights/weekends" compact />
              <RadioOption name="hoursPerWeek" value="10to20" label="10-20" desc="Serious effort" compact />
              <RadioOption name="hoursPerWeek" value="20plus" label="20+" desc="Aggressive" compact />
            </div>
          </QuizQuestion>
        </div>

        <div class="finder-step hidden" data-step="3">
          <QuizQuestion eyebrow="Question 3" title="What skill level should we assume?">
            <RadioOption name="experienceLevel" value="beginner" label="Beginner" desc="I need an entry-level path." />
            <RadioOption name="experienceLevel" value="intermediate" label="Intermediate" desc="I have a few useful skills already." />
            <RadioOption name="experienceLevel" value="advanced" label="Advanced" desc="I can sell specialized expertise." />
          </QuizQuestion>
        </div>

        <div class="finder-step hidden" data-step="4">
          <QuizQuestion eyebrow="Question 4" title="What can you spend to start?">
            <div class="grid grid-cols-2 gap-3">
              <RadioOption name="startupBudget" value="zero" label="$0" desc="No upfront spend" compact />
              <RadioOption name="startupBudget" value="under50" label="Under $50" desc="Tiny budget" compact />
              <RadioOption name="startupBudget" value="under200" label="Under $200" desc="Some tools OK" compact />
              <RadioOption name="startupBudget" value="any" label="$500+" desc="I can invest" compact />
            </div>
          </QuizQuestion>
        </div>

        <div class="finder-step hidden" data-step="5">
          <QuizQuestion eyebrow="Question 5" title="How much risk can you tolerate?">
            <RadioOption name="riskTolerance" value="low" label="Low risk" desc="Prefer free, proven, low-uncertainty options." />
            <RadioOption name="riskTolerance" value="medium" label="Medium risk" desc="I can handle some uncertainty for better upside." />
            <RadioOption name="riskTolerance" value="high" label="High risk" desc="I am comfortable with slower payoff or more upfront effort." />
          </QuizQuestion>
        </div>

        <div class="finder-step hidden" data-step="6">
          <div class="max-w-2xl">
            <p class="text-xs font-bold uppercase text-slate-500 mb-3">Question 6</p>
            <h3 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-normal leading-tight">Which skills can you use?</h3>
            <p class="mt-2 text-sm text-slate-600">Pick any that apply. Skip if you are starting from scratch.</p>
            <div class="mt-6 flex flex-wrap gap-2.5" role="group" aria-label="Select skills">
              {skills.map((skill) => (
                <label class="group inline-flex min-h-10 cursor-pointer items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition-all duration-150 hover:bg-slate-50 hover:border-slate-300 active:scale-95 has-[:checked]:border-[var(--color-violet)] has-[:checked]:bg-[var(--color-link-bg-soft)] has-[:checked]:text-[var(--color-violet)]">
                  <input type="checkbox" name="skills" value={skill.toLowerCase()} class="sr-only" />
                  {skill}
                </label>
              ))}
            </div>
          </div>
        </div>

        <div class="finder-step hidden" data-step="7">
          <QuizQuestion eyebrow="Question 7" title="What income target matters most?">
            <RadioOption name="incomeGoal" value="extra" label="Extra spending money" desc="$100-$500/month" />
            <RadioOption name="incomeGoal" value="parttime" label="Meaningful side income" desc="$500-$2,000/month" />
            <RadioOption name="incomeGoal" value="fulltime" label="Replace a second income" desc="$2,000-$5,000/month" />
            <RadioOption name="incomeGoal" value="replace" label="Long-term full-time upside" desc="$5,000+/month" />
          </QuizQuestion>
        </div>

        <div class="finder-step hidden" data-step="loading">
          <div class="flex min-h-[360px] flex-col items-center justify-center text-center">
            <div class="h-12 w-12 rounded-full border-4 border-slate-200 border-t-[var(--color-violet)] animate-spin" aria-hidden="true"></div>
            <h3 id="loading-label" class="mt-6 text-2xl font-bold text-slate-950">Scoring realistic options...</h3>
            <p class="mt-2 max-w-md text-sm leading-6 text-slate-600">Checking fit, risk, startup cost, first-dollar speed, and income ceiling.</p>
          </div>
        </div>

        <div class="finder-step hidden" data-step="results">
          <div id="results-shell" aria-live="polite"></div>
        </div>
      </div>

      <div id="finder-nav" class="flex items-center justify-between gap-3 border-t border-slate-200 bg-slate-50 p-4 sm:p-5">
        <button id="finder-prev" class="hidden h-11 rounded-lg px-4 text-sm font-bold text-slate-600 hover:bg-slate-200 transition-colors" type="button">← Back</button>
        <div class="flex-1"></div>
        <button id="finder-next" class="h-11 rounded-lg bg-slate-950 px-6 text-sm font-bold text-white transition-colors hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40 min-w-[120px]" type="button">
          Start quiz
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import type { FinderAnswer, ScoredHustle } from "../types/side-hustle";
  import type { SideHustle } from "../types/side-hustle";
  import { getRiskLevel, getScoredRecommendations } from "../utils/hustle";
  import { computeSuccessScore, successScoreCardHTML, animateSuccessScore } from "../utils/successScore";
  import hustleData from "../data/side-hustles.json";

  const hustles = hustleData as SideHustle[];
  const TOTAL_STEPS = 7;

  function track(event: string, payload: Record<string, unknown> = {}) {
    window.dispatchEvent(new CustomEvent("shj:track", { detail: { event, payload } }));
  }

  function initFinder() {
    const root = document.getElementById("finder-quiz");
    if (!root) return;

    let currentStep: number | "loading" | "results" = 0;
    const answers: Partial<FinderAnswer> = {};
    let results: ScoredHustle[] = [];

    const steps = root.querySelectorAll<HTMLElement>(".finder-step");
    const nextBtn = document.getElementById("finder-next") as HTMLButtonElement;
    const prevBtn = document.getElementById("finder-prev") as HTMLButtonElement;
    const nav = document.getElementById("finder-nav") as HTMLElement;
    const progress = document.getElementById("finder-progress") as HTMLElement;
    const count = document.getElementById("step-count") as HTMLElement;
    const kicker = document.getElementById("step-kicker") as HTMLElement;
    const mini = document.getElementById("step-title-mini") as HTMLElement;
    const shell = document.getElementById("results-shell") as HTMLElement;

    const titles: Record<number, string> = {
      0: "A few constraints, then your plan.",
      1: "Work preference",
      2: "Weekly time",
      3: "Skill level",
      4: "Startup budget",
      5: "Risk tolerance",
      6: "Usable skills",
      7: "Income target",
    };

    function showStep(step: number | "loading" | "results") {
      currentStep = step;
      steps.forEach((el) => el.classList.toggle("hidden", el.dataset.step !== String(step)));
      nav.classList.toggle("hidden", step === "loading" || step === "results");

      if (typeof step === "number") {
        const pct = step === 0 ? 0 : Math.round((step / TOTAL_STEPS) * 100);
        progress.style.width = `${pct}%`;
        count.textContent = step === 0 ? "Ready" : `${step} / ${TOTAL_STEPS}`;
        kicker.textContent = step === 0 ? "Setup" : `Question ${step}`;
        mini.textContent = titles[step] ?? "";
        prevBtn.classList.toggle("hidden", step <= 0);
        nextBtn.textContent = step === 0 ? "Start quiz" : step === 6 ? "Continue" : step === 7 ? "Show my match" : "Continue";
        updateNext();
      } else if (step === "loading") {
        progress.style.width = "92%";
        count.textContent = "Scoring";
        kicker.textContent = "Almost done";
        mini.textContent = "Finding the best realistic option.";
      } else {
        progress.style.width = "100%";
        count.textContent = "Done";
        kicker.textContent = "Your plan";
        mini.textContent = "Best match and backups.";
      }
    }

    function getStepValue(step: number): string | string[] | null {
      if (step === 1) return root.querySelector<HTMLInputElement>('input[name="remote"]:checked')?.value ?? null;
      if (step === 2) return root.querySelector<HTMLInputElement>('input[name="hoursPerWeek"]:checked')?.value ?? null;
      if (step === 3) return root.querySelector<HTMLInputElement>('input[name="experienceLevel"]:checked')?.value ?? null;
      if (step === 4) return root.querySelector<HTMLInputElement>('input[name="startupBudget"]:checked')?.value ?? null;
      if (step === 5) return root.querySelector<HTMLInputElement>('input[name="riskTolerance"]:checked')?.value ?? null;
      if (step === 6) return [...root.querySelectorAll<HTMLInputElement>('input[name="skills"]:checked')].map((el) => el.value);
      if (step === 7) return root.querySelector<HTMLInputElement>('input[name="incomeGoal"]:checked')?.value ?? null;
      return null;
    }

    function isValid() {
      if (currentStep === 0 || currentStep === 6) return true;
      if (typeof currentStep !== "number") return false;
      return getStepValue(currentStep) !== null;
    }

    function updateNext() {
      nextBtn.disabled = !isValid();
    }

    function commitStep(step: number) {
      const val = getStepValue(step);
      if (step === 1) answers.remote = val as FinderAnswer["remote"];
      if (step === 2) answers.hoursPerWeek = val as FinderAnswer["hoursPerWeek"];
      if (step === 3) answers.experienceLevel = val as FinderAnswer["experienceLevel"];
      if (step === 4) answers.startupBudget = val as FinderAnswer["startupBudget"];
      if (step === 5) answers.riskTolerance = val as FinderAnswer["riskTolerance"];
      if (step === 6) answers.skills = (val as string[]) ?? [];
      if (step === 7) answers.incomeGoal = val as FinderAnswer["incomeGoal"];
    }

    function finalAnswers(): FinderAnswer {
      return {
        remote: answers.remote ?? "both",
        hoursPerWeek: answers.hoursPerWeek ?? "5to10",
        experienceLevel: answers.experienceLevel ?? "beginner",
        startupBudget: answers.startupBudget ?? "zero",
        riskTolerance: answers.riskTolerance ?? "low",
        needsQuickIncome: answers.incomeGoal === "extra" || answers.riskTolerance === "low",
        skills: answers.skills ?? [],
        incomeGoal: answers.incomeGoal ?? "extra",
      };
    }

    function firstStep(r: ScoredHustle) {
      if (r.hustle.remote) return `Create one offer for ${r.hustle.name}, then send it to 10 likely buyers before you build anything else.`;
      return `Apply or list locally today, then schedule your first available earning block within the next 72 hours.`;
    }

    function sevenDayPlan(r: ScoredHustle) {
      const name = r.hustle.name;
      return [
        ["Day 1", `Choose one narrow ${name} offer and write a 2-sentence pitch.`],
        ["Day 2", "Set up the minimum profile: clear photo, short bio, starter rate, and one proof sample."],
        ["Day 3", "Find 20 realistic prospects or platforms where buyers already look for this."],
        ["Day 4", "Send 10 direct pitches or applications. Track every response in a simple note."],
        ["Day 5", "Improve the offer using objections you heard. Send 10 more pitches."],
        ["Day 6", "Book one starter job, trial shift, or discounted first project for a testimonial."],
        ["Day 7", "Review hours, replies, and expected pay. Keep the best channel and drop the rest."],
      ];
    }

    function metric(label: string, value: string) {
      return `<div class="rounded-lg bg-slate-50 p-3"><dt class="text-xs text-slate-500">${label}</dt><dd class="mt-1 text-sm font-bold text-slate-950">${value}</dd></div>`;
    }

    function recommendationCard(r: ScoredHustle, label: string, featured = false) {
      const risk = getRiskLevel(r.hustle);
      if (featured) {
        return `
          <article class="rounded-xl border-2 border-slate-950 bg-white overflow-hidden">
            <div class="bg-slate-950 px-5 sm:px-6 py-3 flex items-center justify-between gap-4">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-[var(--color-violet)]" aria-hidden="true"></span>
                <p class="text-xs font-bold uppercase tracking-wider" style="color:var(--color-violet)">${label}</p>
              </div>
              <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-bold text-white">${r.matchPercent}% match</span>
            </div>
            <div class="p-5 sm:p-6">
              <div class="mb-5">
                <h3 class="text-2xl sm:text-3xl font-bold text-slate-950 leading-tight">${r.hustle.name}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 max-w-xl">${r.hustle.description}</p>
              </div>
              <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
                ${metric("Startup cost", r.hustle.startupCost)}
                ${metric("First dollar", r.hustle.timeToFirstIncome)}
                ${metric("Skill level", r.hustle.difficulty)}
                ${metric("Risk", risk)}
              </dl>
              <div class="pt-5 border-t border-slate-100 grid md:grid-cols-2 gap-5">
                <div>
                  <p class="text-xs font-bold uppercase text-slate-500 mb-3">Why it fits</p>
                  <ul class="space-y-2 text-sm text-slate-700">${r.whyMatch.slice(0, 3).map((w) => `<li class="flex items-start gap-2"><span style="color:var(--color-violet)" class="font-bold mt-0.5 shrink-0">✓</span><span>${w}</span></li>`).join("")}</ul>
                </div>
                <div>
                  <p class="text-xs font-bold uppercase text-slate-500 mb-3">Exact first step</p>
                  <p class="text-sm leading-6 text-slate-700">${firstStep(r)}</p>
                  <a href="/side-hustle/${r.hustle.slug}" class="inline-flex items-center gap-1 mt-4 text-xs font-bold text-slate-950 hover:text-slate-700 transition-colors">
                    Full guide <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </article>`;
      }
      return `
        <article class="rounded-xl border border-slate-200 bg-white overflow-hidden">
          <div class="bg-slate-50 px-5 py-3 border-b border-slate-200 flex items-center justify-between">
            <p class="text-xs font-bold uppercase text-slate-500 tracking-wider">${label}</p>
            <span class="text-xs font-bold text-slate-400">${r.matchPercent}%</span>
          </div>
          <div class="p-5">
            <h3 class="text-xl font-bold text-slate-950 mb-2">${r.hustle.name}</h3>
            <p class="text-sm leading-6 text-slate-600 mb-4">${r.hustle.description}</p>
            <dl class="grid grid-cols-2 gap-2 mb-4">
              ${metric("Startup cost", r.hustle.startupCost)}
              ${metric("First dollar", r.hustle.timeToFirstIncome)}
              ${metric("Skill level", r.hustle.difficulty)}
              ${metric("Risk", risk)}
            </dl>
            <div class="pt-4 border-t border-slate-100">
              <p class="text-xs font-bold uppercase text-slate-500 mb-2">Why it fits</p>
              <ul class="space-y-1.5 text-sm text-slate-700">${r.whyMatch.slice(0, 2).map((w) => `<li class="flex items-start gap-2"><span style="color:var(--color-violet)" class="font-bold mt-0.5 shrink-0">✓</span><span>${w}</span></li>`).join("")}</ul>
            </div>
            <a href="/side-hustle/${r.hustle.slug}" class="inline-flex items-center gap-1 mt-4 text-xs font-bold text-slate-700 hover:text-slate-950 transition-colors">
              Full guide <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>`;
    }

    function shareUrl() {
      const params = new URLSearchParams();
      results.slice(0, 3).forEach((r) => params.append("match", r.hustle.slug));
      const fa = finalAnswers();
      params.set("rm", fa.remote);
      params.set("h", fa.hoursPerWeek);
      params.set("x", fa.experienceLevel);
      params.set("b", fa.startupBudget);
      params.set("risk", fa.riskTolerance);
      params.set("goal", fa.incomeGoal);
      if (fa.skills.length > 0) params.set("sk", fa.skills.join(","));
      return `${window.location.origin}/results?${params.toString()}`;
    }

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand("copy");
        textarea.remove();
        return copied;
      }
    }

    function savePlan(best: ScoredHustle) {
      import("../utils/storage").then(({ saveResult }) => {
        results.slice(0, 3).forEach((r) => saveResult(r.hustle.slug, r.hustle.name, r.matchPercent));
        const btn = document.getElementById("save-plan-btn") as HTMLButtonElement | null;
        if (btn) {
          btn.textContent = "Saved";
          btn.disabled = true;
        }
        track("results_saved", { best: best.hustle.slug });
      });
    }

    function renderResults() {
      const fa = finalAnswers();
      results = getScoredRecommendations(hustles, fa, 3);
      const best = results[0];

      if (!best) {
        shell.innerHTML = `
          <div class="py-16 text-center">
            <h3 class="text-2xl font-bold text-slate-950">No confident match yet.</h3>
            <p class="mt-2 text-sm text-slate-600">Try fewer skill filters or a slightly higher budget.</p>
            <button id="empty-restart" class="mt-6 h-11 rounded-lg bg-slate-950 px-5 text-sm font-bold text-white">Retake quiz</button>
          </div>`;
        document.getElementById("empty-restart")?.addEventListener("click", reset);
        track("quiz_no_result", fa as unknown as Record<string, unknown>);
        return;
      }

      const backups = results.slice(1, 3);
      const plan = sevenDayPlan(best);
      const successScore = computeSuccessScore(fa, { hustle: best.hustle, matchPercent: best.matchPercent, downsides: best.downsides });
      shell.innerHTML = `
        <div class="space-y-5">
          ${successScoreCardHTML(successScore)}
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-5 border-b border-slate-200">
            <div>
              <p class="text-xs font-bold uppercase text-[var(--color-violet)] mb-1.5">Your best move this week</p>
              <h3 class="text-2xl sm:text-4xl font-bold text-slate-950 leading-tight">${best.hustle.name}</h3>
              <p class="mt-2 max-w-xl text-sm sm:text-base leading-7 text-slate-600">Strongest match for your answers. Start here — don't split focus on the backups yet.</p>
            </div>
            <div class="flex flex-wrap gap-2 shrink-0">
              <button id="save-plan-btn" class="h-10 rounded-lg border border-slate-300 bg-white px-4 text-sm font-bold text-slate-950 hover:bg-slate-50 transition-colors">Save</button>
              <button id="copy-plan-btn" class="h-10 rounded-lg border border-slate-300 bg-white px-4 text-sm font-bold text-slate-950 hover:bg-slate-50 transition-colors">Share</button>
              <button id="restart-plan-btn" class="h-10 rounded-lg bg-slate-950 px-4 text-sm font-bold text-white hover:bg-slate-800 transition-colors">Retake</button>
            </div>
          </div>

          ${recommendationCard(best, "Best match", true)}

          <section class="rounded-xl border border-slate-200 bg-slate-950 overflow-hidden" aria-labelledby="plan-heading">
            <div class="px-5 sm:px-6 py-4 border-b border-white/10 flex items-center justify-between">
              <h4 id="plan-heading" class="text-lg font-bold text-white">7-day action plan</h4>
              <span class="text-xs text-slate-400">Start ${best.hustle.name} this week</span>
            </div>
            <div class="p-5 sm:p-6 grid sm:grid-cols-2 gap-3">
              ${plan.map(([day, task]) => `
                <div class="rounded-lg bg-white/[0.06] border border-white/10 p-4">
                  <p class="text-xs font-bold text-emerald-400 mb-2">${day}</p>
                  <p class="text-sm leading-6 text-slate-200">${task}</p>
                </div>`).join("")}
            </div>
          </section>

          ${backups.length > 0 ? `
          <section aria-labelledby="backup-heading">
            <h4 id="backup-heading" class="mb-4 text-xl font-bold text-slate-950">Two backups if your first path stalls</h4>
            <div class="grid sm:grid-cols-2 gap-4">
              ${backups.map((r, i) => recommendationCard(r, `Backup ${i + 1}`)).join("")}
            </div>
          </section>` : ""}
        </div>`;

      document.getElementById("save-plan-btn")?.addEventListener("click", () => savePlan(best));
      document.getElementById("copy-plan-btn")?.addEventListener("click", () => {
        const btn = document.getElementById("copy-plan-btn") as HTMLButtonElement | null;
        copyText(shareUrl()).then((copied) => {
          if (!btn) return;
          btn.textContent = copied ? "Copied" : "Copy failed";
          setTimeout(() => { btn.textContent = "Copy link"; }, 1800);
        });
        track("results_shared", { best: best.hustle.slug });
      });
      document.getElementById("restart-plan-btn")?.addEventListener("click", reset);
      document.getElementById("share-score-btn")?.addEventListener("click", () => {
        const btn = document.getElementById("share-score-btn") as HTMLButtonElement | null;
        copyText(shareUrl()).then((copied) => {
          if (!btn) return;
          const original = btn.innerHTML;
          btn.textContent = copied ? "Link copied" : "Copy failed";
          setTimeout(() => { btn.innerHTML = original; }, 1800);
        });
        track("success_score_shared", { best: best.hustle.slug, score: successScore.score, confidence: successScore.confidence });
      });
      animateSuccessScore(shell);
      track("success_score_viewed", { best: best.hustle.slug, score: successScore.score, confidence: successScore.confidence });
      history.replaceState(null, "", `#results`);
      track("quiz_completed", { best: best.hustle.slug, backups: backups.map((r) => r.hustle.slug), answers: fa });
    }

    function reset() {
      root.querySelectorAll<HTMLInputElement>("input").forEach((input) => { input.checked = false; });
      Object.keys(answers).forEach((key) => delete (answers as Record<string, unknown>)[key]);
      results = [];
      showStep(0);
      track("quiz_restarted");
    }

    async function finish() {
      showStep("loading");
      await new Promise((resolve) => setTimeout(resolve, 650));
      renderResults();
      showStep("results");
    }

    nextBtn.addEventListener("click", () => {
      if (typeof currentStep !== "number" || !isValid()) return;
      if (currentStep > 0) commitStep(currentStep);
      track("quiz_step_completed", { step: currentStep });
      if (currentStep === TOTAL_STEPS) {
        finish();
      } else {
        showStep(currentStep + 1);
      }
    });

    prevBtn.addEventListener("click", () => {
      if (typeof currentStep === "number" && currentStep > 0) showStep(currentStep - 1);
    });

    root.addEventListener("change", () => {
      updateNext();
    });

    showStep(0);
    track("quiz_viewed");
  }

  document.addEventListener("astro:page-load", initFinder);
</script>
