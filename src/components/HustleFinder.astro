---
// Side Hustle Finder — AI-style recommendation experience, fully client-side
---

<section id="finder" class="py-12 sm:py-16 md:py-32 relative overflow-hidden" aria-labelledby="finder-heading">
  <!-- Glow background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] sm:w-[600px] sm:h-[600px] bg-gradient-to-tr from-pink-100 to-purple-100 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container-page relative z-10">
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-10 md:mb-16">
      <p class="text-xs sm:text-sm font-bold text-[var(--color-violet)] uppercase tracking-widest mb-3 sm:mb-4">AI Recommendation Engine</p>
      <h2 id="finder-heading" class="text-2xl sm:text-3xl md:text-6xl font-bold text-slate-900 tracking-tight leading-none mb-4 sm:mb-6 text-balance">
        Find your perfect hustle.
      </h2>
      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-medium">
        Answer 7 questions and our AI advisor will match you with the best opportunities for your situation.
      </p>
    </div>

    <!-- Quiz container -->
    <div
      id="finder-quiz"
      class="max-w-4xl mx-auto bg-white/80 backdrop-blur-xl border border-slate-200 rounded-2xl sm:rounded-3xl shadow-xl overflow-hidden"
      role="form"
      aria-label="Side hustle finder quiz"
      style="isolation: isolate;"
    >
      <!-- Progress bar -->
      <div class="h-1 bg-slate-100 relative" aria-hidden="true">
        <div id="finder-progress" class="absolute inset-y-0 left-0 bg-gradient-to-r from-[var(--color-violet)] to-[var(--color-cyan)] transition-all duration-500 ease-out" style="width: 0%"></div>
      </div>

      <!-- Steps -->
      <div id="finder-steps" class="p-4 sm:p-8 md:p-12 lg:px-16 lg:py-14 min-h-[320px] sm:min-h-[360px] flex flex-col justify-center">

        <!-- Step 1 -->
        <div class="finder-step" data-step="1">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 1 of 7</p>
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-8">Where do you want to work?</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4" role="radiogroup" aria-labelledby="q1-label">
            <span id="q1-label" class="sr-only">Where do you want to work?</span>
            {[
              { value: "remote", label: "Remote", desc: "Work from anywhere with wifi" },
              { value: "local", label: "Local", desc: "In-person in my city or neighborhood" },
              { value: "both", label: "Both", desc: "Open to either option" },
            ].map(({ value, label, desc }) => (
              <label class="finder-option group flex items-center gap-3 sm:gap-5 p-3 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 cursor-pointer hover:border-pink-300 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white">
                <input type="radio" name="remote" value={value} class="sr-only" aria-label={label} />
                <span class="flex-1 min-w-0">
                  <span class="block text-sm sm:text-base font-bold text-slate-900 group-has-[:checked]:text-pink-900">{label}</span>
                  <span class="block text-xs sm:text-sm text-slate-500 mt-0.5 sm:mt-1 group-has-[:checked]:text-pink-700">{desc}</span>
                </span>
                <span class="shrink-0 w-4 h-4 sm:w-5 sm:h-5 rounded-full border-2 border-slate-300 group-has-[:checked]:border-pink-500 group-has-[:checked]:bg-pink-500 transition-all duration-300 shadow-[inset_0_0_0_3px_white] sm:shadow-[inset_0_0_0_4px_white]" aria-hidden="true"></span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 2 -->
        <div class="finder-step hidden" data-step="2">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 2 of 7</p>
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-8">How many hours per week can you commit?</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4" role="radiogroup" aria-labelledby="q2-label">
            <span id="q2-label" class="sr-only">Hours available per week</span>
            {[
              { value: "under5", label: "Under 5 hrs" },
              { value: "5to10", label: "5–10 hrs" },
              { value: "10to20", label: "10–20 hrs" },
              { value: "20plus", label: "20+ hrs" },
            ].map(({ value, label }) => (
              <label class="finder-option group flex items-center justify-center p-3 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-200 cursor-pointer hover:border-pink-300 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white text-center min-h-[50px] sm:min-h-[56px]">
                <input type="radio" name="hoursPerWeek" value={value} class="sr-only" />
                <span class="text-sm sm:text-base font-bold text-slate-900 group-has-[:checked]:text-pink-900">{label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 3 -->
        <div class="finder-step hidden" data-step="3">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 3 of 7</p>
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-8">What's your experience level?</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4" role="radiogroup" aria-labelledby="q3-label">
            <span id="q3-label" class="sr-only">Experience level</span>
            {[
              { value: "beginner", label: "Beginner", desc: "Just getting started, no relevant experience" },
              { value: "intermediate", label: "Intermediate", desc: "Some skills and experience in an area" },
              { value: "advanced", label: "Advanced", desc: "Expert with a proven track record" },
            ].map(({ value, label, desc }) => (
              <label class="finder-option group flex items-center gap-3 sm:gap-5 p-3 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 cursor-pointer hover:border-pink-300 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white">
                <input type="radio" name="experienceLevel" value={value} class="sr-only" />
                <span class="flex-1 min-w-0">
                  <span class="block text-sm sm:text-base font-bold text-slate-900 group-has-[:checked]:text-pink-900">{label}</span>
                  <span class="block text-xs sm:text-sm text-slate-500 mt-0.5 sm:mt-1 group-has-[:checked]:text-pink-700">{desc}</span>
                </span>
                <span class="shrink-0 w-4 h-4 sm:w-5 sm:h-5 rounded-full border-2 border-slate-300 group-has-[:checked]:border-pink-500 group-has-[:checked]:bg-pink-500 transition-all duration-300 shadow-[inset_0_0_0_3px_white] sm:shadow-[inset_0_0_0_4px_white]" aria-hidden="true"></span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 4 -->
        <div class="finder-step hidden" data-step="4">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 4 of 7</p>
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-8">What's your startup budget?</h3>
          <div class="grid grid-cols-2 gap-3 sm:gap-4" role="radiogroup" aria-labelledby="q4-label">
            <span id="q4-label" class="sr-only">Startup budget</span>
            {[
              { value: "zero", label: "$0", desc: "Start for free" },
              { value: "under50", label: "Under $50", desc: "Low investment" },
              { value: "under200", label: "Under $200", desc: "Willing to invest" },
              { value: "any", label: "$500+", desc: "Higher returns" },
            ].map(({ value, label, desc }) => (
              <label class="finder-option group flex flex-col items-center justify-center text-center gap-1 sm:gap-2 p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-200 cursor-pointer hover:border-pink-300 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white min-h-[80px]">
                <input type="radio" name="startupBudget" value={value} class="sr-only" />
                <span class="block text-xl sm:text-2xl font-bold text-slate-900 group-has-[:checked]:text-pink-900">{label}</span>
                <span class="block text-xs sm:text-sm text-slate-500 group-has-[:checked]:text-pink-700">{desc}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 5 -->
        <div class="finder-step hidden" data-step="5">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 5 of 7</p>
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-8">Do you need income quickly?</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4" role="radiogroup" aria-labelledby="q5-label">
            <span id="q5-label" class="sr-only">Need income quickly?</span>
            {[
              { value: "true", label: "Yes", desc: "Within a few weeks" },
              { value: "false", label: "No", desc: "I can play the long game" },
            ].map(({ value, label, desc }) => (
              <label class="finder-option group flex flex-col items-center text-center p-4 sm:p-8 rounded-xl sm:rounded-2xl border border-slate-200 cursor-pointer hover:border-pink-300 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white min-h-[72px] sm:min-h-[80px] justify-center">
                <input type="radio" name="needsQuickIncome" value={value} class="sr-only" />
                <span class="text-xl sm:text-2xl font-bold text-slate-900 mb-1 sm:mb-1.5 group-has-[:checked]:text-pink-900">{label}</span>
                <span class="text-xs sm:text-sm font-medium text-slate-500 group-has-[:checked]:text-pink-700">{desc}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 6 -->
        <div class="finder-step hidden" data-step="6">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 6 of 7</p>
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mb-2 sm:mb-3">What are your skills?</h3>
          <p class="text-sm text-slate-600 font-medium mb-5 sm:mb-8">Select all that apply.</p>
          <div class="flex flex-wrap gap-2 sm:gap-3" role="group" aria-labelledby="q6-label">
            <span id="q6-label" class="sr-only">Select your skills</span>
            {[
              "Writing", "Design", "Coding", "Marketing", "Teaching",
              "Video", "Photography", "Social Media", "Excel/Spreadsheets",
              "Customer Service", "Sales", "Finance/Accounting",
              "Physical Labor", "Cooking", "Languages",
            ].map((skill) => (
              <label class="group inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full border border-slate-200 cursor-pointer text-xs sm:text-sm font-semibold text-slate-600 hover:border-slate-300 hover:text-slate-900 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:text-pink-900 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white">
                <input type="checkbox" name="skills" value={skill.toLowerCase()} class="sr-only" />
                {skill}
              </label>
            ))}
          </div>
        </div>

        <!-- Step 7 -->
        <div class="finder-step hidden" data-step="7">
          <p class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3 sm:mb-6">Step 7 of 7</p>
          <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-slate-900 tracking-tight mb-4 sm:mb-8">What's your income goal?</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4" role="radiogroup" aria-labelledby="q7-label">
            <span id="q7-label" class="sr-only">Income goal</span>
            {[
              { value: "extra", label: "Extra spending money", desc: "$100–$500/month on the side" },
              { value: "parttime", label: "Meaningful side income", desc: "$500–$2,000/month" },
              { value: "fulltime", label: "Replace a second income", desc: "$2,000–$5,000/month" },
              { value: "replace", label: "Replace my full-time income", desc: "$5,000+/month" },
            ].map(({ value, label, desc }) => (
              <label class="finder-option group flex items-center gap-3 sm:gap-5 p-3 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 cursor-pointer hover:border-pink-300 hover:bg-slate-50 transition-all duration-300 has-[:checked]:border-pink-500 has-[:checked]:bg-pink-50 has-[:checked]:shadow-sm bg-white">
                <input type="radio" name="incomeGoal" value={value} class="sr-only" />
                <span class="flex-1 min-w-0">
                  <span class="block text-sm sm:text-base font-bold text-slate-900 group-has-[:checked]:text-pink-900">{label}</span>
                  <span class="block text-xs sm:text-sm text-slate-500 mt-0.5 sm:mt-1 group-has-[:checked]:text-pink-700">{desc}</span>
                </span>
                <span class="shrink-0 w-4 h-4 sm:w-5 sm:h-5 rounded-full border-2 border-slate-300 group-has-[:checked]:border-pink-500 group-has-[:checked]:bg-pink-500 transition-all duration-300 shadow-[inset_0_0_0_3px_white] sm:shadow-[inset_0_0_0_4px_white]" aria-hidden="true"></span>
              </label>
            ))}
          </div>
        </div>

        <!-- Loading state -->
        <div class="finder-step hidden" data-step="loading">
          <div class="flex flex-col items-center justify-center py-8 gap-5 sm:gap-6">
            <!-- Animated brain/AI icon -->
            <div class="relative w-14 h-14 sm:w-16 sm:h-16">
              <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 animate-ping opacity-20"></div>
              <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-white" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" fill="currentColor"/>
                </svg>
              </div>
            </div>

            <div class="text-center">
              <p id="loading-label" class="text-base sm:text-lg font-bold text-slate-900 mb-1.5 sm:mb-2 transition-all duration-500">Analyzing your situation...</p>
              <p class="text-xs sm:text-sm text-slate-500 font-medium">Scoring 235+ side hustles against your answers</p>
            </div>

            <!-- Animated progress dots -->
            <div class="flex gap-2" aria-hidden="true">
              <div class="w-2 h-2 rounded-full bg-pink-500 animate-bounce" style="animation-delay: 0ms"></div>
              <div class="w-2 h-2 rounded-full bg-pink-500 animate-bounce" style="animation-delay: 150ms"></div>
              <div class="w-2 h-2 rounded-full bg-pink-500 animate-bounce" style="animation-delay: 300ms"></div>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div class="finder-step hidden" data-step="results">
          <!-- Header with restart -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-5 sm:mb-6">
            <div>
              <div class="flex items-center gap-2 mb-1.5 sm:mb-2">
                <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center shrink-0">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                </div>
                <p class="text-xs font-bold text-pink-600 uppercase tracking-widest">Analysis Complete</p>
              </div>
              <h3 class="text-base sm:text-xl font-bold text-slate-900 tracking-tight">Your personalized recommendations</h3>
            </div>
            <button id="finder-restart" class="self-start sm:self-auto text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors bg-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-full border border-slate-200 hover:border-slate-300 hover:bg-slate-50 min-h-[40px] sm:min-h-[44px] shrink-0">
              Start over
            </button>
          </div>

          <!-- AI Report Summary -->
          <div id="ai-report" class="mb-5 sm:mb-6 p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-gradient-to-br from-pink-50 to-purple-50 border border-pink-100 text-xs sm:text-sm text-slate-700 leading-relaxed font-medium hidden">
          </div>

          <!-- Results list -->
          <div id="finder-results" class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4" role="list" aria-label="Recommended side hustles" aria-live="polite">
          </div>

          <!-- Show more -->
          <div id="show-more-wrap" class="mt-3 sm:mt-4 hidden">
            <button id="show-more-btn" class="w-full py-3 text-sm font-semibold text-slate-600 hover:text-slate-900 border border-slate-200 rounded-xl sm:rounded-2xl hover:bg-slate-50 transition-all duration-300 bg-white">
              Show more matches ↓
            </button>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div id="finder-nav" class="px-4 pb-4 sm:px-8 sm:pb-8 md:px-12 md:pb-12 lg:px-16 lg:pb-14 flex items-center justify-between gap-3 sm:gap-4 border-t border-slate-100 pt-4 sm:pt-6 bg-slate-50/50">
        <button id="finder-prev" class="hidden text-sm font-bold text-slate-500 hover:text-slate-900 transition-colors px-3 sm:px-4 py-2.5 sm:py-3 rounded-full hover:bg-slate-200/50 min-h-[44px]" aria-label="Go to previous question">← Back</button>
        <div class="flex-1"></div>
        <button id="finder-next" disabled class="flex items-center justify-center h-11 sm:h-12 px-6 sm:px-8 min-w-[120px] sm:min-w-[140px] text-sm font-bold text-white bg-slate-900 rounded-full transition-all duration-300 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-800 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 disabled:transform-none" aria-label="Continue to next question">
          Continue →
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import type { FinderAnswer, ScoredHustle } from "../types/side-hustle";
  import type { SideHustle } from "../types/side-hustle";
  import { getScoredRecommendations, generateReportSummary } from "../utils/hustle";
  import hustleData from "../data/side-hustles.json";

  const hustles = hustleData as SideHustle[];
  const TOTAL_STEPS = 7;
  const LOADING_MESSAGES = [
    "Analyzing your situation...",
    "Finding the best opportunities...",
    "Comparing side hustles...",
    "Calculating match scores...",
    "Finalizing your recommendations...",
  ];

  function initFinder() {
  let currentStep = 1;
  const answers: Partial<FinderAnswer> = {};
  let allResults: ScoredHustle[] = [];
  let showingCount = 5;

  const steps = document.querySelectorAll<HTMLElement>(".finder-step");
  const nextBtn = document.getElementById("finder-next") as HTMLButtonElement;
  const prevBtn = document.getElementById("finder-prev") as HTMLButtonElement;
  const progressBar = document.getElementById("finder-progress") as HTMLElement;
  const resultsEl = document.getElementById("finder-results") as HTMLElement;
  const restartBtn = document.getElementById("finder-restart") as HTMLButtonElement;
  const aiReport = document.getElementById("ai-report") as HTMLElement;
  const showMoreWrap = document.getElementById("show-more-wrap") as HTMLElement;
  const showMoreBtn = document.getElementById("show-more-btn") as HTMLButtonElement;
  const loadingLabel = document.getElementById("loading-label") as HTMLElement;
  const finderNav = document.getElementById("finder-nav") as HTMLElement;

  // Exit early if finder elements aren't on this page
  if (!nextBtn || !progressBar) return;

  // ─── Confidence badge colours ─────────────────────────────────────────────
  function confidenceClasses(confidence: ScoredHustle["confidence"]) {
    if (confidence === "Strong Match") return "bg-emerald-50 text-emerald-700 border-emerald-200";
    if (confidence === "Good Match") return "bg-blue-50 text-blue-700 border-blue-200";
    return "bg-slate-50 text-slate-600 border-slate-200";
  }

  function difficultyColor(d: string) {
    if (d === "Beginner") return "text-emerald-600";
    if (d === "Intermediate") return "text-amber-600";
    return "text-rose-600";
  }

  // ─── Score bar SVG ────────────────────────────────────────────────────────
  function matchBar(pct: number): string {
    const color = pct >= 70 ? "#10b981" : pct >= 45 ? "#3b82f6" : "#94a3b8";
    return `
      <div class="flex items-center gap-2 mt-1" aria-label="Match score ${pct}%">
        <div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden">
          <div style="width:${pct}%; background:${color}" class="h-full rounded-full transition-all duration-700"></div>
        </div>
        <span class="text-xs font-bold tabular-nums" style="color:${color}">${pct}%</span>
      </div>`;
  }

  // ─── Render one result card ───────────────────────────────────────────────
  function renderCard(r: ScoredHustle, idx: number): string {
    const whyHtml = r.whyMatch.length
      ? r.whyMatch.map(w => `<li class="flex items-start gap-1.5"><span class="text-pink-500 mt-0.5 shrink-0">✓</span><span>${w}</span></li>`).join("")
      : "";

    return `
      <div role="listitem" class="group rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 hover:border-slate-300">
        <!-- Card top: rank + confidence + name -->
        <div class="p-5 pb-0">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="shrink-0 w-7 h-7 rounded-full bg-slate-900 text-white text-xs font-bold flex items-center justify-center tabular-nums">#${idx + 1}</span>
              <div class="min-w-0">
                <p class="text-[10px] font-bold text-[var(--color-violet)] uppercase tracking-wider truncate">${r.hustle.category}</p>
                <h4 class="text-base font-bold text-slate-900 leading-tight">${r.hustle.name}</h4>
              </div>
            </div>
            <span class="shrink-0 text-[10px] font-bold px-2.5 py-1 rounded-full border ${confidenceClasses(r.confidence)}">${r.confidence}</span>
          </div>

          <!-- Match bar -->
          <div class="mb-3">
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Match Score</p>
            ${matchBar(r.matchPercent)}
          </div>
        </div>

        <!-- Expandable body -->
        <div class="px-5 pb-5">
          <!-- Key stats row -->
          <dl class="grid grid-cols-3 gap-2 py-3 border-y border-slate-100 mb-3 text-center">
            <div>
              <dt class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Income</dt>
              <dd class="text-xs font-bold text-slate-800 tabular-nums leading-tight">${r.hustle.incomePotential}</dd>
            </div>
            <div>
              <dt class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">Startup</dt>
              <dd class="text-xs font-bold text-slate-800 leading-tight">${r.hustle.startupCost}</dd>
            </div>
            <div>
              <dt class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-0.5">First $</dt>
              <dd class="text-xs font-bold text-slate-800 leading-tight">${r.hustle.timeToFirstIncome}</dd>
            </div>
          </dl>

          <!-- Why it matches -->
          ${whyHtml ? `
          <div class="mb-3">
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Best for you because</p>
            <ul class="space-y-1 text-xs text-slate-600 font-medium">${whyHtml}</ul>
          </div>` : ""}

          <!-- Difficulty + CTA row -->
          <div class="flex items-center justify-between gap-3 pt-1">
            <span class="text-xs font-semibold ${difficultyColor(r.difficulty)}">● ${r.difficulty}</span>
            <a
              href="/side-hustle/${r.hustle.slug}"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-violet)] hover:text-[var(--color-link-deep)] transition-colors"
              aria-label="View ${r.hustle.name} guide"
            >
              View full guide
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M9 4.5l3.5 3.5L9 11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>`;
  }

  // ─── Render results ────────────────────────────────────────────────────────
  function renderResults() {
    const fa: FinderAnswer = {
      remote: (answers.remote ?? "both") as FinderAnswer["remote"],
      hoursPerWeek: (answers.hoursPerWeek ?? "5to10") as FinderAnswer["hoursPerWeek"],
      experienceLevel: (answers.experienceLevel ?? "beginner") as FinderAnswer["experienceLevel"],
      startupBudget: (answers.startupBudget ?? "zero") as FinderAnswer["startupBudget"],
      needsQuickIncome: answers.needsQuickIncome ?? false,
      skills: answers.skills ?? [],
      incomeGoal: (answers.incomeGoal ?? "extra") as FinderAnswer["incomeGoal"],
    };

    allResults = getScoredRecommendations(hustles, fa, 10);

    // AI report summary
    if (allResults.length > 0) {
      const summary = generateReportSummary(fa, allResults);
      aiReport.innerHTML = `<span class="font-bold text-slate-900">Your Profile: </span>${summary}`;
      aiReport.classList.remove("hidden");
    }

    renderVisibleCards();
  }

  function renderVisibleCards() {
    const visible = allResults.slice(0, showingCount);

    if (visible.length === 0) {
      resultsEl.innerHTML = `<p class="text-base text-slate-500 font-medium text-center py-10 bg-slate-50 rounded-2xl border border-slate-200">No exact matches — try adjusting your answers.</p>`;
    } else {
      resultsEl.innerHTML = visible.map((r, i) => renderCard(r, i)).join("");
    }

    // Show-more button
    if (allResults.length > showingCount) {
      showMoreWrap.classList.remove("hidden");
      showMoreBtn.textContent = `Show ${Math.min(5, allResults.length - showingCount)} more matches ↓`;
    } else {
      showMoreWrap.classList.add("hidden");
    }
  }

  // ─── Loading sequence ──────────────────────────────────────────────────────
  async function runLoadingAndShowResults() {
    showStep("loading");

    let msgIdx = 0;
    const interval = setInterval(() => {
      msgIdx = (msgIdx + 1) % LOADING_MESSAGES.length;
      if (loadingLabel) {
        loadingLabel.style.opacity = "0";
        setTimeout(() => {
          loadingLabel.textContent = LOADING_MESSAGES[msgIdx];
          loadingLabel.style.opacity = "1";
        }, 200);
      }
    }, 700);

    // Run actual scoring while showing animation
    await new Promise<void>((resolve) => setTimeout(() => {
      renderResults();
      resolve();
    }, 50));

    // Show for at least 2.2s for the "AI feel"
    await new Promise((resolve) => setTimeout(resolve, 2200));
    clearInterval(interval);

    showStep("results");
  }

  // ─── Step navigation ──────────────────────────────────────────────────────
  function showStep(n: number | "loading" | "results") {
    steps.forEach((s) => {
      const isActive = s.dataset.step === String(n);
      s.classList.toggle("hidden", !isActive);
    });

    const isSpecial = n === "results" || n === "loading";
    finderNav?.classList.toggle("hidden", isSpecial);

    if (typeof n === "number") {
      prevBtn?.classList.toggle("hidden", n <= 1);
      progressBar.style.width = `${((n - 1) / TOTAL_STEPS) * 100}%`;
    } else if (n === "loading") {
      progressBar.style.width = "95%";
    } else {
      progressBar.style.width = "100%";
    }
  }

  function getStepValue(step: number): string | string[] | null {
    switch (step) {
      case 1: return document.querySelector<HTMLInputElement>('input[name="remote"]:checked')?.value ?? null;
      case 2: return document.querySelector<HTMLInputElement>('input[name="hoursPerWeek"]:checked')?.value ?? null;
      case 3: return document.querySelector<HTMLInputElement>('input[name="experienceLevel"]:checked')?.value ?? null;
      case 4: return document.querySelector<HTMLInputElement>('input[name="startupBudget"]:checked')?.value ?? null;
      case 5: return document.querySelector<HTMLInputElement>('input[name="needsQuickIncome"]:checked')?.value ?? null;
      case 6: return [...document.querySelectorAll<HTMLInputElement>('input[name="skills"]:checked')].map(c => c.value);
      case 7: return document.querySelector<HTMLInputElement>('input[name="incomeGoal"]:checked')?.value ?? null;
      default: return null;
    }
  }

  function isStepValid(step: number): boolean {
    if (step === 6) return true;
    const val = getStepValue(step);
    return val !== null && val !== undefined;
  }

  function updateNextBtn() {
    if (!nextBtn) return;
    const valid = isStepValid(currentStep);
    nextBtn.disabled = !valid;
    nextBtn.setAttribute("aria-disabled", String(!valid));
  }

  // ─── Event listeners ──────────────────────────────────────────────────────
  // Use a single delegated listener on the quiz container for reliability
  document.querySelector("#finder-quiz")?.addEventListener("change", () => {
    updateNextBtn();
  });
  document.querySelector("#finder-quiz")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('input[type="radio"], input[type="checkbox"]') ||
        target.closest('label.finder-option, label')) {
      // Small delay to let browser update :checked state before we query it
      setTimeout(updateNextBtn, 0);
    }
  });

  nextBtn?.addEventListener("click", async () => {
    if (!isStepValid(currentStep)) return;
    const val = getStepValue(currentStep);

    if (currentStep === 1) answers.remote = val as FinderAnswer["remote"];
    if (currentStep === 2) answers.hoursPerWeek = val as FinderAnswer["hoursPerWeek"];
    if (currentStep === 3) answers.experienceLevel = val as FinderAnswer["experienceLevel"];
    if (currentStep === 4) answers.startupBudget = val as FinderAnswer["startupBudget"];
    if (currentStep === 5) answers.needsQuickIncome = val === "true";
    if (currentStep === 6) answers.skills = (val as string[]) ?? [];
    if (currentStep === 7) {
      answers.incomeGoal = val as FinderAnswer["incomeGoal"];
      await runLoadingAndShowResults();
      return;
    }

    currentStep++;
    showStep(currentStep);
    updateNextBtn();
  });

  prevBtn?.addEventListener("click", () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
      setTimeout(updateNextBtn, 50);
    }
  });

  restartBtn?.addEventListener("click", () => {
    currentStep = 1;
    showingCount = 5;
    allResults = [];
    Object.keys(answers).forEach(k => delete (answers as Record<string, unknown>)[k]);
    document.querySelectorAll<HTMLInputElement>('#finder-quiz input[type="radio"]').forEach(r => r.checked = false);
    document.querySelectorAll<HTMLInputElement>('#finder-quiz input[type="checkbox"]').forEach(c => c.checked = false);
    aiReport.classList.add("hidden");
    aiReport.innerHTML = "";
    resultsEl.innerHTML = "";
    showStep(1);
    updateNextBtn();
  });

  showMoreBtn?.addEventListener("click", () => {
    showingCount += 5;
    renderVisibleCards();
  });

  // Init
  showStep(1);
  updateNextBtn();
  } // end initFinder

  // Run on first load and on every Astro View Transition navigation
  document.addEventListener("astro:page-load", initFinder);
</script>
