---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="max-w-2xl">
  <p class="text-xs font-bold uppercase text-slate-500 mb-3">{eyebrow}</p>
  <h3 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-normal leading-tight text-balance">{title}</h3>
  <div class="mt-6 space-y-3">
    <slot />
  </div>
</div>
