    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-md">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-slate-950" aria-label="SideHustlesJob home">
          <img src="/favicon-96x96.png" alt="" width="24" height="24" class="h-6 w-6 rounded-md" />
          SideHustlesJob
        </a>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Find the side hustle you can realistically start this week.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a href="/quiz" class="text-sm font-bold text-slate-950 hover:text-emerald-700 transition-colors">Take quiz</a>
        <a href="/how-it-works" class="text-sm font-bold text-slate-600 hover:text-slate-950 transition-colors">How it works</a>
        <a href="/saved" class="text-sm font-bold text-slate-600 hover:text-slate-950 transition-colors">Saved</a>
