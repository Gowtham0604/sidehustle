---
const year = new Date().getFullYear();

const audienceLinks = [
  { href: "/side-hustles-for-students", label: "For Students" },
  { href: "/side-hustles-for-developers", label: "For Developers" },
  { href: "/side-hustles-for-teachers", label: "For Teachers" },
  { href: "/side-hustles-for-designers", label: "For Designers" },
  { href: "/side-hustles-for-retirees", label: "For Retirees" },
  { href: "/side-hustles-for-parents", label: "For Parents" },
];

const constraintLinks = [
  { href: "/side-hustles-with-no-money", label: "No Money" },
  { href: "/side-hustles-with-no-experience", label: "No Experience" },
  { href: "/side-hustles-from-home", label: "From Home" },
  { href: "/side-hustles-that-pay-weekly", label: "Weekly Pay" },
  { href: "/side-hustles-for-beginners", label: "Beginners" },
  { href: "/high-income-side-hustles", label: "High Income" },
];

const popularLinks = [
  { href: "/side-hustle/freelance-writing", label: "Freelance Writing" },
  { href: "/side-hustle/virtual-assistant", label: "Virtual Assistant" },
  { href: "/side-hustle/video-editing", label: "Video Editing" },
  { href: "/side-hustle/web-development", label: "Web Development" },
  { href: "/side-hustle/graphic-design", label: "Graphic Design" },
  { href: "/side-hustle/copywriting", label: "Copywriting" },
];
---

<footer class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas)]" role="contentinfo">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-semibold text-sm text-[var(--color-ink)] mb-3"
          aria-label="SideHustleFinder home"
        >
          <img src="/favicon-96x96.png" alt="" width="24" height="24" class="w-6 h-6 rounded-[var(--radius-xs)]" />
          SideHustleFinder
        </a>
        <p class="text-sm text-[var(--color-body)] leading-6 max-w-xs">
          Find the best side hustle for your skills, schedule, and income goals. Real data, no fluff.
        </p>
      </div>

      <!-- By Audience -->
      <div>
        <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">
          By Audience
        </h3>
        <ul class="space-y-2" role="list">
          {
            audienceLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-150"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- By Constraint -->
      <div>
        <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">
          By Situation
        </h3>
        <ul class="space-y-2" role="list">
          {
            constraintLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-150"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Popular -->
      <div>
        <h3 class="text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">
          Popular
        </h3>
        <ul class="space-y-2" role="list">
          {
            popularLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors duration-150"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-[var(--color-hairline)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--color-mute)]">
        &copy; {year} SideHustleFinder. All rights reserved.
      </p>
      <p class="text-xs text-[var(--color-mute)]">
        Built for US audiences. Income figures are estimates and not guarantees.
      </p>
    </div>
  </div>
</footer>
